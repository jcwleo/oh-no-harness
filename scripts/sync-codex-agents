#!/usr/bin/env bash
set -euo pipefail

mode="check"
out_dir=".codex/agents"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)
      mode="check"
      shift
      ;;
    --write)
      mode="write"
      shift
      ;;
    --out)
      out_dir="${2:?missing value for --out}"
      shift 2
      ;;
    *)
      printf 'sync-codex-agents: unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

python3 - "$mode" "$out_dir" <<'PY'
import json
import re
import sys
from pathlib import Path

MODE = sys.argv[1]
CODEX_AGENTS_DIR = Path(sys.argv[2])
AGENTS_DIR = Path("agents")

REASONING_EFFORT = {
    "analyst": "high",
    "architect": "xhigh",
    "code-reviewer": "xhigh",
    "critic": "xhigh",
    "debugger": "xhigh",
    "executor": "high",
    "explore": "medium",
    "planner": "high",
    "test-engineer": "high",
    "verifier": "xhigh",
}

READ_ONLY_AGENTS = {
    "analyst",
    "architect",
    "code-reviewer",
    "critic",
    "debugger",
    "explore",
    "test-engineer",
    "verifier",
}

CODEX_USAGE_NOTE = (
    "Codex usage note: this native custom-agent template is installed from "
    "the repository root `.codex/agents/` directory or copied into "
    "`~/.codex/agents/`. The oh-no plugin still works through skills and "
    "current-session role passes if native custom agents are unavailable."
)


def fail(message: str) -> None:
    raise SystemExit(f"sync-codex-agents: {message}")


def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def parse_agent_markdown(path: Path) -> tuple[str, str, str]:
    text = path.read_text(encoding="utf-8")
    match = re.match(r"^---\n(?P<frontmatter>.*?)\n---\n(?P<body>.*)$", text, re.S)
    if not match:
        fail(f"{path}: missing YAML frontmatter")

    metadata: dict[str, str] = {}
    for line in match.group("frontmatter").splitlines():
        if not line.strip():
            continue
        key, separator, value = line.partition(":")
        if not separator:
            fail(f"{path}: invalid frontmatter line: {line}")
        metadata[key.strip()] = value.strip()

    name = metadata.get("name")
    description = metadata.get("description")
    if not name:
        fail(f"{path}: missing frontmatter name")
    if not description:
        fail(f"{path}: missing frontmatter description")
    if path.stem != name:
        fail(f"{path}: stem/name mismatch")
    if name not in REASONING_EFFORT:
        fail(f"{path}: no Codex reasoning-effort rule for {name}")

    body = match.group("body").lstrip("\n").rstrip()
    if not body:
        fail(f"{path}: empty agent body")
    developer_instructions = f"{body}\n\n{CODEX_USAGE_NOTE}"
    return name, description, developer_instructions


def render_toml(path: Path) -> tuple[str, str]:
    name, description, developer_instructions = parse_agent_markdown(path)
    lines = [
        f"# Generated from agents/{name}.md by scripts/sync-codex-agents. Do not edit by hand.",
        f"name = {toml_string(name)}",
        f"description = {toml_string(description)}",
        f"model_reasoning_effort = {toml_string(REASONING_EFFORT[name])}",
    ]
    if name in READ_ONLY_AGENTS:
        lines.append('sandbox_mode = "read-only"')
    lines.append(f"developer_instructions = {toml_string(developer_instructions)}")
    return name, "\n".join(lines) + "\n"


agent_paths = sorted(AGENTS_DIR.glob("*.md"))
if not agent_paths:
    fail("agents/*.md not found")

generated = {
    f"{name}.toml": text
    for name, text in (render_toml(path) for path in agent_paths)
}

existing = {}
if CODEX_AGENTS_DIR.exists():
    existing = {
        path.name: path.read_text(encoding="utf-8")
        for path in sorted(CODEX_AGENTS_DIR.glob("*.toml"))
    }

if MODE == "check":
    stale = []
    if existing:
        for filename, expected in generated.items():
            actual = existing.get(filename)
            if actual is None:
                stale.append(f"missing {CODEX_AGENTS_DIR / filename}")
            elif actual != expected:
                stale.append(f"out of sync {CODEX_AGENTS_DIR / filename}")
        for filename in sorted(set(existing) - set(generated)):
            stale.append(f"stale {CODEX_AGENTS_DIR / filename}")
    if stale:
        for item in stale:
            print(f"sync-codex-agents: {item}", file=sys.stderr)
        fail(f"run scripts/sync-codex-agents --write --out {CODEX_AGENTS_DIR}")
    print("sync-codex-agents: OK")
elif MODE == "write":
    CODEX_AGENTS_DIR.mkdir(parents=True, exist_ok=True)
    for filename, text in generated.items():
        (CODEX_AGENTS_DIR / filename).write_text(text, encoding="utf-8")
    for filename in sorted(set(existing) - set(generated)):
        (CODEX_AGENTS_DIR / filename).unlink()
    print(f"sync-codex-agents: wrote {CODEX_AGENTS_DIR}")
else:
    fail(f"unknown mode: {MODE}")
PY
