#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
PLUGIN_NAME="${OH_NO_PLUGIN_NAME:-oh-no-harness}"
BUNDLE_DIR="${REPO_ROOT}/plugins/${PLUGIN_NAME}"
RSYNC_EXCLUDES=(--exclude '.DS_Store')

usage() {
  cat <<'USAGE'
Usage: scripts/sync-codex-plugin-bundle [--write|--check]

Materializes the Codex marketplace plugin bundle at plugins/oh-no-harness.
Codex /plugins requires marketplace entries to point at a plugin subdirectory;
the repository root cannot be used as the plugin source.

Options:
  --write  Rewrite plugins/oh-no-harness from the root plugin sources. Default.
  --check  Verify plugins/oh-no-harness is already in sync.
  -h, --help
           Show this help.
USAGE
}

mode="write"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --write)
      mode="write"
      shift
      ;;
    --check)
      mode="check"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Required command not found: $1" >&2
    exit 1
  }
}

copy_bundle() {
  local target="$1"
  rm -rf "$target"
  mkdir -p "$target"

  rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/.codex-plugin/" "$target/.codex-plugin/"
  rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/skills/" "$target/skills/"
  rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/agents/" "$target/agents/"
  rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/commands/" "$target/commands/"
  rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/docs/" "$target/docs/"
  rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/hooks/" "$target/hooks/"

  mkdir -p "$target/scripts"
  rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/scripts/oh-no-config" "$target/scripts/oh-no-config"

  for file in AGENTS.md README.md README.ko.md CONTRIBUTING.md LICENSE NOTICE.md; do
    rsync -a "${RSYNC_EXCLUDES[@]}" "$REPO_ROOT/$file" "$target/$file"
  done
}

require_command rsync
cd "$REPO_ROOT"

if [[ "$mode" == "write" ]]; then
  copy_bundle "$BUNDLE_DIR"
  echo "ok - synced Codex plugin bundle: ${BUNDLE_DIR#$REPO_ROOT/}"
  exit 0
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
expected="$tmp_dir/${PLUGIN_NAME}"
copy_bundle "$expected"

if ! diff -qr "$expected" "$BUNDLE_DIR" >/dev/null; then
  echo "ERROR: plugins/${PLUGIN_NAME} is out of sync. Run scripts/sync-codex-plugin-bundle." >&2
  diff -qr "$expected" "$BUNDLE_DIR" >&2 || true
  exit 1
fi

echo "ok - Codex plugin bundle is in sync"
