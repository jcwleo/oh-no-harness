#!/usr/bin/env bash
set -euo pipefail

mode="dry-run"
out_dir="dist"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --write)
      mode="write"
      shift
      ;;
    --dry-run)
      mode="dry-run"
      shift
      ;;
    --out)
      out_dir="${2:?missing value for --out}"
      shift 2
      ;;
    *)
      printf 'sync-adapters: unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

copy_tree() {
  local src="$1"
  local dst="$2"
  mkdir -p "$dst"
  cp -R "$src"/. "$dst"/
}

if [ "$mode" = "dry-run" ]; then
  cat <<EOF2
sync-adapters: dry run
Would create:
- ${out_dir}/codex/.codex-plugin
- ${out_dir}/codex/.codex/agents
- ${out_dir}/codex/skills
- ${out_dir}/codex/agents
- ${out_dir}/codex/bootstrap
- ${out_dir}/codex/scripts
- ${out_dir}/codex/templates
- ${out_dir}/claude/.claude-plugin
- ${out_dir}/claude/hooks
- ${out_dir}/claude/skills
- ${out_dir}/claude/agents
- ${out_dir}/claude/bootstrap
- ${out_dir}/claude/scripts
- ${out_dir}/claude/templates
Run with --write to materialize bundles.
EOF2
  exit 0
fi

rm -rf "${out_dir}/codex" "${out_dir}/claude"
mkdir -p "${out_dir}/codex" "${out_dir}/claude"

copy_tree .codex-plugin "${out_dir}/codex/.codex-plugin"
mkdir -p "${out_dir}/codex/.codex"
scripts/sync-codex-agents --write --out "${out_dir}/codex/.codex/agents" >/dev/null
copy_tree skills "${out_dir}/codex/skills"
copy_tree agents "${out_dir}/codex/agents"
copy_tree bootstrap "${out_dir}/codex/bootstrap"
copy_tree scripts "${out_dir}/codex/scripts"
copy_tree templates "${out_dir}/codex/templates"

copy_tree .claude-plugin "${out_dir}/claude/.claude-plugin"
copy_tree hooks "${out_dir}/claude/hooks"
copy_tree skills "${out_dir}/claude/skills"
copy_tree agents "${out_dir}/claude/agents"
copy_tree bootstrap "${out_dir}/claude/bootstrap"
copy_tree scripts "${out_dir}/claude/scripts"
copy_tree templates "${out_dir}/claude/templates"

printf 'sync-adapters: wrote %s\n' "$out_dir"
