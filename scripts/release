#!/usr/bin/env bash
# Cuts an Oh No Harness release for the Claude Code and Codex plugin layouts.
#
# What it does:
#   1. Validates the version arg (semver: 0.2.0 or v0.2.0).
#   2. Refuses to run when not on main, when the tree is dirty, or when the
#      tag already exists locally or on origin.
#   3. Rewrites the version field in the nested plugin manifests under
#      plugins/oh-no-harness (no-op if already correct).
#   4. Checks generated agent wrappers, then runs scripts/validate-plugin-files.py.
#   5. Creates a `chore: release v{X.Y.Z}` commit when version files changed.
#   6. With --push: pushes main to origin BEFORE the install tests, because the
#      registered Claude marketplace syncs from GitHub and can only deliver
#      content that is already on origin/main.
#   7. Runs the local Codex install test, then the Claude install test only
#      when HEAD matches origin's main (verified live via ls-remote). In
#      --push mode a mismatch after the push is treated as a test failure,
#      never a skip; in no-push mode the Claude test is skipped with an
#      explanation when local content is not on origin yet. Live model
#      smoke is skipped.
#   8. Creates an annotated tag `v{X.Y.Z}` on the release commit.
#   9. With --push: pushes the tag to origin, then publishes a GitHub
#      Release via gh CLI if available. 0.x releases are prereleases;
#      1.x and later are stable releases. Release notes are built from
#      `git log <prev-tag>..<new-tag>`, grouped by conventional-commit
#      prefix (Features / Fixes / Documentation / Other), with the standard
#      "Full Changelog" compare link appended.
#
# Reruns are idempotent: after a failed --push test phase, rerunning
# `scripts/release X.Y.Z --push` no-ops the version commit and main push,
# reruns the tests, and then tags and publishes.
#
# Usage:
#   scripts/release 0.2.1
#   scripts/release v0.2.1 --push
#   scripts/release 0.2.1 --skip-tests       # skip plugin install tests
#   scripts/release 0.2.1 --skip-tests --push

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

PYTHON_BIN="${PYTHON_BIN:-python3}"
MARKETPLACE_NAME="${OH_NO_MARKETPLACE_NAME:-oh-no-harness}"
PLUGIN_NAME="${OH_NO_PLUGIN_NAME:-oh-no-harness}"
PLUGIN_ROOT="${OH_NO_PLUGIN_ROOT:-$REPO_ROOT/plugins/$PLUGIN_NAME}"

usage() {
  cat <<'USAGE'
Usage: scripts/release <version|vversion> [--push] [--skip-tests]

Updates plugin version files, runs validators, and creates the release commit.
With --push, pushes main to origin before the install tests (the Claude
marketplace syncs from GitHub, so the tests need the release content on
origin/main), then tags, pushes the tag, and publishes a GitHub Release via
gh CLI. Without --push, the Claude install test is skipped unless HEAD already
matches origin's main. 0.x releases are marked prerelease; 1.x and later are
stable releases.

Examples:
  scripts/release v0.2.1
  scripts/release 0.2.1 --push
  scripts/release 0.2.1 --skip-tests
USAGE
}

fail() {
  printf 'release: %s\n' "$1" >&2
  exit 1
}

run() {
  printf '+ %s\n' "$*"
  "$@"
}

# The Claude install test verifies the GitHub-synced marketplace clone, so it
# can only pass when local HEAD matches the main branch on origin. Uses
# ls-remote so the answer is live, not dependent on a fresh fetch.
remote_main_matches_head() {
  local remote_sha
  remote_sha="$(git ls-remote origin refs/heads/main 2>/dev/null | cut -f1)"
  [ -n "$remote_sha" ] && [ "$remote_sha" = "$(git rev-parse HEAD)" ]
}

# Build Markdown release notes from commits between the previous tag and the
# new tag, grouped by conventional-commit prefix. Excludes the release commit
# itself. Appends the standard "**Full Changelog**: ..." compare link.
build_release_notes() {
  local tag="$1" prev_tag repo_slug
  prev_tag=$(git describe --tags --abbrev=0 "${tag}^" 2>/dev/null || true)
  repo_slug=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
  "$PYTHON_BIN" - "$tag" "$prev_tag" "$repo_slug" <<'PY'
import re
import subprocess
import sys

tag, prev_tag, repo_slug = sys.argv[1:4]
range_ = f"{prev_tag}..{tag}" if prev_tag else tag
log = subprocess.run(
    ["git", "log", "--reverse", "--pretty=format:%h%x09%s", range_],
    check=True,
    capture_output=True,
    text=True,
).stdout.splitlines()

buckets = {"Features": [], "Fixes": [], "Documentation": [], "Other": []}
prefix_to_bucket = {"feat": "Features", "fix": "Fixes", "docs": "Documentation"}
release_re = re.compile(r"^chore: release v\d+\.\d+\.\d+$")
prefix_re = re.compile(r"^(\w+)(\([^)]*\))?:")

for entry in log:
    if "\t" not in entry:
        continue
    sha, subject = entry.split("\t", 1)
    if release_re.match(subject):
        continue
    match = prefix_re.match(subject)
    bucket = prefix_to_bucket.get(match.group(1) if match else "", "Other")
    buckets[bucket].append((subject, sha))

lines = []
for heading, items in buckets.items():
    if not items:
        continue
    lines.append(f"## {heading}")
    lines.append("")
    for subject, sha in items:
        lines.append(f"- {subject} (`{sha}`)")
    lines.append("")

if not any(buckets.values()):
    lines.append("_No notable changes since the previous release._")
    lines.append("")

if prev_tag and repo_slug:
    lines.append(
        f"**Full Changelog**: https://github.com/{repo_slug}/compare/{prev_tag}...{tag}"
    )

sys.stdout.write("\n".join(lines).rstrip() + "\n")
PY
}

version_arg=""
push="false"
skip_tests="false"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --push)
      push="true"
      shift
      ;;
    --skip-tests)
      skip_tests="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      fail "unknown argument: $1"
      ;;
    *)
      [ -z "$version_arg" ] || fail "multiple versions provided"
      version_arg="$1"
      shift
      ;;
  esac
done

[ -n "$version_arg" ] || { usage >&2; exit 2; }

version="${version_arg#v}"
tag="v${version}"
major="${version%%.*}"

printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' \
  || fail "version must look like 0.2.1 or v0.2.1"

cd "$REPO_ROOT"

current_branch="$(git branch --show-current || true)"
[ "$current_branch" = "main" ] \
  || fail "run from main; current branch is ${current_branch:-detached}"

if ! git diff --quiet || ! git diff --cached --quiet; then
  fail "tracked working tree changes exist; commit or stash them first"
fi

if git rev-parse --verify "refs/tags/${tag}" >/dev/null 2>&1; then
  fail "tag already exists locally: $tag"
fi
if git remote get-url origin >/dev/null 2>&1; then
  if git ls-remote --exit-code --tags origin "refs/tags/${tag}" >/dev/null 2>&1; then
    fail "tag already exists on origin: $tag"
  fi
fi

"$PYTHON_BIN" - "$version" "$PLUGIN_ROOT" <<'PY'
import json
import sys
from pathlib import Path

version = sys.argv[1]
plugin_root = Path(sys.argv[2])
for rel in (".claude-plugin/plugin.json", ".codex-plugin/plugin.json"):
    path = plugin_root / rel
    data = json.loads(path.read_text(encoding="utf-8"))
    if data.get("version") != version:
        data["version"] = version
        path.write_text(
            json.dumps(data, indent=2, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
PY

run "$PYTHON_BIN" scripts/generate-agent-wrappers.py --plugin-root "$PLUGIN_ROOT" --check
run "$PYTHON_BIN" scripts/validate-plugin-files.py "$REPO_ROOT" "$PLUGIN_ROOT"

if git diff --quiet -- plugins/oh-no-harness; then
  printf 'release: version files already at %s; no release commit needed\n' "$tag"
else
  run git add plugins/oh-no-harness
  run git commit -m "chore: release ${tag}"
fi

if [ "$push" = "true" ]; then
  run git push origin main
fi

if [ "$skip_tests" = "true" ]; then
  printf 'release: skipping local install tests (--skip-tests)\n'
else
  tests_failed="false"
  codex_test_home="$(mktemp -d)"
  OH_NO_MARKETPLACE_NAME="$MARKETPLACE_NAME" OH_NO_LIVE=0 OH_NO_DEEP_LIVE=0 OH_NO_PARALLEL_LIVE=0 OH_NO_RALPLAN_LIVE=0 OH_NO_NAMED_AGENTS_LIVE=0 OH_NO_FUSION_RESCUE_LIVE=0 OH_NO_CODEX_CROSS_HOST_FALLBACK_LIVE=0 OH_NO_SIMPLIFY_LIVE=0 OH_NO_NATURAL_SESSION_START_LIVE=0 OH_NO_WORKTREE_LIVE=0 OH_NO_SAME_HOST_REVIEW_LIVE=0 run scripts/test-codex-plugin.sh --codex-home "$codex_test_home" \
    || tests_failed="true"
  if [ "$tests_failed" = "false" ]; then
    if remote_main_matches_head; then
      OH_NO_MARKETPLACE_NAME="$MARKETPLACE_NAME" OH_NO_LIVE=0 OH_NO_DEEP_LIVE=0 OH_NO_PARALLEL_LIVE=0 OH_NO_RALPLAN_LIVE=0 OH_NO_FUSION_RESCUE_LIVE=0 OH_NO_CROSS_HOST_FALLBACK_LIVE=0 OH_NO_CROSS_HOST_REVIEW_LIVE=0 OH_NO_RALPLAN_XHOST_LIVE=0 OH_NO_VBC_XHOST_LIVE=0 OH_NO_SYSDEBUG_XHOST_LIVE=0 OH_NO_PARALLEL_EXECUTOR_LIVE=0 OH_NO_SIMPLIFY_LIVE=0 OH_NO_NATURAL_SESSION_START_LIVE=0 OH_NO_LIVE_HOOK_ONLY=0 OH_NO_SAME_HOST_REVIEW_LIVE=0 run scripts/test-claude-plugin.sh \
        || tests_failed="true"
    elif [ "$push" = "true" ]; then
      printf 'release: HEAD does not match main on origin even though main was just pushed (origin unreachable or main moved concurrently); refusing to skip the Claude install test.\n' >&2
      tests_failed="true"
    else
      printf 'release: skipping Claude install test: HEAD does not match main on origin (or origin is unreachable).\n'
      printf 'release: the Claude install test verifies the GitHub-synced marketplace and cannot pass against unpushed content; this version will not get that check unless you delete the local tag and rerun with --push.\n'
    fi
  fi
  if [ "$tests_failed" = "true" ]; then
    if [ "$push" = "true" ]; then
      printf 'release: install tests failed after main was pushed; no tag or GitHub Release was created.\n' >&2
      printf 'release: after fixing, rerun `scripts/release %s --push` to resume idempotently (version commit no-op, main push no-op, tests, tag, release).\n' "$version" >&2
    fi
    fail "install tests failed; tag $tag was not created"
  fi
fi

run git tag -a "$tag" -m "$tag"

notes_file="$(mktemp)"
trap 'rm -f "$notes_file"' EXIT
build_release_notes "$tag" >"$notes_file"

if [ "$push" = "true" ]; then
  run git push origin "$tag"
  if command -v gh >/dev/null 2>&1; then
    gh_release_cmd=(gh release create "$tag" --title "$tag" --notes-file "$notes_file")
    if [ "$major" = "0" ]; then
      gh_release_cmd+=(--prerelease)
    else
      gh_release_cmd+=(--latest)
    fi
    if ! run "${gh_release_cmd[@]}"; then
      printf 'release: tag %s was pushed but the GitHub Release was not created; publish manually with:\n' "$tag" >&2
      printf '  gh release create %s --title %s %s --notes-file <notes>\n' "$tag" "$tag" "$( [ "$major" = "0" ] && printf -- '--prerelease' || printf -- '--latest')" >&2
      exit 1
    fi
  else
    release_kind_flag="--latest"
    [ "$major" = "0" ] && release_kind_flag="--prerelease"
    cat <<EOF
release: gh CLI not found; publish the GitHub Release manually:
  gh release create $tag --title $tag $release_kind_flag --notes-file <(cat <<'NOTES'
$(cat "$notes_file")
NOTES
)
EOF
  fi
else
  release_kind_flag="--latest"
  [ "$major" = "0" ] && release_kind_flag="--prerelease"
  cat <<EOF
release: created local commit (if needed) and tag $tag
release: publish with:
  git push origin main
  git push origin $tag
  gh release create $tag --title $tag $release_kind_flag --notes-file <(cat <<'NOTES'
$(cat "$notes_file")
NOTES
)
EOF
fi
