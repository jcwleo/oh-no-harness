#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/release <version|vversion> [--push]

Creates a source release commit on main, creates a tag-only bundle commit with
generated Codex custom-agent TOML, and tags that bundle commit.

Examples:
  scripts/release v0.1.1
  scripts/release 0.1.1 --push

Default behavior does not push. Use --push to push main and the new tag.
EOF
}

fail() {
  printf 'release: %s\n' "$1" >&2
  exit 1
}

run() {
  printf '+ %s\n' "$*"
  "$@"
}

version_arg=""
push="false"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --push)
      push="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      fail "unknown argument: $1"
      ;;
    *)
      if [ -n "$version_arg" ]; then
        fail "multiple versions provided"
      fi
      version_arg="$1"
      shift
      ;;
  esac
done

[ -n "$version_arg" ] || {
  usage >&2
  exit 2
}

version="${version_arg#v}"
tag="v${version}"

case "$version" in
  *[!0-9.]*|*.*.*.*|.*|*.)
    fail "version must look like 0.1.1 or v0.1.1"
    ;;
esac
if ! printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  fail "version must look like 0.1.1 or v0.1.1"
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

current_branch="$(git branch --show-current)"
[ "$current_branch" = "main" ] || fail "run from main; current branch is ${current_branch:-detached}"

if ! git diff --quiet || ! git diff --cached --quiet; then
  fail "tracked working tree changes exist; commit or stash them first"
fi

git rev-parse --verify "refs/tags/${tag}" >/dev/null 2>&1 && fail "tag already exists locally: $tag"
if git remote get-url origin >/dev/null 2>&1; then
  if git ls-remote --exit-code --tags origin "refs/tags/${tag}" >/dev/null 2>&1; then
    fail "tag already exists on origin: $tag"
  fi
fi

if ! grep -Eq "^## \[${version}\]" CHANGELOG.md; then
  fail "CHANGELOG.md has no '## [${version}]' section; add release notes before tagging"
fi

python3 - "$version" "$tag" <<'PY'
import json
import re
import sys
from pathlib import Path

version, tag = sys.argv[1], sys.argv[2]

json_paths = [
    Path(".codex-plugin/plugin.json"),
    Path(".claude-plugin/plugin.json"),
]

for path in json_paths:
    data = json.loads(path.read_text(encoding="utf-8"))
    data["version"] = version
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

marketplace_path = Path(".claude-plugin/marketplace.json")
marketplace = json.loads(marketplace_path.read_text(encoding="utf-8"))
marketplace["plugins"][0]["source"]["ref"] = tag
marketplace_path.write_text(json.dumps(marketplace, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

readme_path = Path("README.md")
readme = readme_path.read_text(encoding="utf-8")
readme = re.sub(r"currently `v[0-9]+\.[0-9]+\.[0-9]+`", f"currently `{tag}`", readme)
readme = re.sub(r"--ref v[0-9]+\.[0-9]+\.[0-9]+", f"--ref {tag}", readme)
readme_path.write_text(readme, encoding="utf-8")
PY

run scripts/validate-skills
run git diff --check
bundle_check_dir="$(mktemp -d)"
run scripts/sync-adapters --write --out "$bundle_check_dir"
run bash -c "cd '$bundle_check_dir/codex' && scripts/sync-codex-agents --check"
rm -rf "$bundle_check_dir"

if git diff --quiet -- .codex-plugin/plugin.json .claude-plugin/plugin.json .claude-plugin/marketplace.json README.md; then
  printf 'release: version files already at %s; no source release commit needed\n' "$tag"
else
  run git add .codex-plugin/plugin.json .claude-plugin/plugin.json .claude-plugin/marketplace.json README.md
  run git commit -m "chore: release ${tag}"
fi

source_commit="$(git rev-parse HEAD)"
tmp_parent="$(mktemp -d)"
bundle_worktree="${tmp_parent}/bundle"
cleanup() {
  if [ -d "$bundle_worktree/.git" ] || git worktree list --porcelain | grep -Fxq "worktree $bundle_worktree"; then
    git worktree remove --force "$bundle_worktree" >/dev/null 2>&1 || true
  fi
  rm -rf "$tmp_parent"
}
trap cleanup EXIT

run git worktree add --detach "$bundle_worktree" "$source_commit"
run bash -c "cd '$bundle_worktree' && scripts/sync-codex-agents --write --out .codex/agents"
run git -C "$bundle_worktree" add -f .codex/agents
run git -C "$bundle_worktree" diff --cached --quiet --exit-code && fail "bundle commit has no generated files"
run git -C "$bundle_worktree" commit -m "build: materialize ${tag} plugin bundle"
run git -C "$bundle_worktree" tag -a "$tag" -m "$tag"

if [ "$push" = "true" ]; then
  run git push origin main
  run git push origin "$tag"
  if command -v gh >/dev/null 2>&1; then
    run gh release create "$tag" --title "$tag" --latest --generate-notes
  else
    cat <<EOF
release: gh CLI not found; create the GitHub Release manually:
  gh release create $tag --title $tag --latest --generate-notes
EOF
  fi
else
  cat <<EOF
release: created local source commit and tag $tag
release: push with:
  git push origin main
  git push origin $tag
release: then publish the GitHub Release with:
  gh release create $tag --title $tag --latest --generate-notes
EOF
fi
