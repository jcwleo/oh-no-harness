#!/usr/bin/env bash
# Cuts an Oh No Harness release for Claude Code, Codex, and OpenCode.
#
# What it does:
#   1. Validates the version arg (semver: 0.2.0 or v0.2.0).
#   2. Refuses to run when not on main, when the tree is dirty, or when any
#      untracked non-ignored path exists under plugins/oh-no-harness. An
#      existing tag is allowed only through the forward-completion path below.
#   2a. With --push, requires the GitHub prerequisites (gh present, auth ok,
#      credential-free origin slug reachable, no existing target Release)
#      BEFORE any version write, commit, push, publish, or tag.
#   3. Rewrites the version field in the nested plugin manifests and npm
#      package under plugins/oh-no-harness (no-op if already correct).
#   4. Checks generated agent wrappers, npm metadata, then runs the validator.
#   5. Creates a `chore: release v{X.Y.Z}` commit when version files changed,
#      staging ONLY the three version manifests (never the whole plugin dir).
#   6. With --push: pushes main to origin BEFORE the install tests, because the
#      registered Claude marketplace syncs from GitHub and can only deliver
#      content that is already on origin/main.
#   7. Runs the packed OpenCode npm artifact test, local Codex install test,
#      then the Claude install test only
#      when HEAD matches origin's main (verified live via ls-remote). The
#      Claude test derives a credential-free owner/repo slug from origin and
#      runs with --isolated-config + OH_NO_INSTALL=1, so the child creates and
#      cleans its own throwaway config home and installs the GitHub-synced
#      marketplace by slug: it verifies the already-pushed revision and never
#      mutates the real ~/.claude marketplace or settings. A non-GitHub or
#      credentialed origin fails closed (or is skipped without --push). In
#      --push mode a mismatch after the push is treated as a test failure,
#      never a skip; in no-push mode the Claude test is skipped with an
#      explanation when local content is not on origin yet. Live model smoke
#      is skipped.
#   7a. Packs the npm tarball exactly once after version sync/validation; the
#      packed OpenCode test, existing-version comparison, publish, and
#      postflight all consume that same artifact.
#   8. With --push: publishes that exact tarball (`npm publish <tarball>`) after
#      verifying npm authentication, refusing a mismatched existing version, and
#      then requiring registry dist.integrity to equal the local integrity.
#   9. Creates an annotated tag `v{X.Y.Z}` on the release commit.
#  10. With --push: pushes the tag to origin, then publishes a GitHub
#      Release via gh CLI if available. 0.x releases are prereleases;
#      1.x and later are stable releases. Release notes are built from
#      `git log <prev-tag>..<new-tag>`, grouped by conventional-commit
#      prefix (Features / Fixes / Documentation / Other), with the standard
#      "Full Changelog" compare link appended.
#
# Reruns are idempotent: after a failed --push test phase, rerunning
# `scripts/release X.Y.Z --push` no-ops the version commit and main push,
# reruns the tests, and then tags and publishes.
#
# Forward completion (run died after tagging, before the GitHub Release):
# when local and remote tags are both annotated, both peel to current HEAD,
# npm integrity matches the freshly packed tarball, and no GitHub Release
# exists, the helper skips version mutation, the commit, npm publish, tag
# creation, and tag push, and runs only the GitHub Release creation. Missing,
# lightweight, divergent, or local-only tags, mismatched npm content, and a
# pre-existing Release all fail closed. A tag is never replaced or forced.
#
# Usage:
#   scripts/release 0.2.1
#   scripts/release v0.2.1 --push
#   scripts/release 0.2.1 --skip-tests       # skip plugin install tests
#   scripts/release 0.2.1 --skip-tests --push
#   scripts/release 0.2.1 --push --skip-npm-publish

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

PYTHON_BIN="${PYTHON_BIN:-python3}"
NPM_BIN="${NPM_BIN:-npm}"
MARKETPLACE_NAME="${OH_NO_MARKETPLACE_NAME:-oh-no-harness}"
PLUGIN_NAME="${OH_NO_PLUGIN_NAME:-oh-no-harness}"
PLUGIN_ROOT="${OH_NO_PLUGIN_ROOT:-$REPO_ROOT/plugins/$PLUGIN_NAME}"
PLUGIN_REL="plugins/$PLUGIN_NAME"
VERSION_FILES=(
  "$PLUGIN_REL/.claude-plugin/plugin.json"
  "$PLUGIN_REL/.codex-plugin/plugin.json"
  "$PLUGIN_REL/package.json"
)

usage() {
  cat <<'USAGE'
Usage: scripts/release <version|vversion> [--push] [--skip-tests] [--skip-npm-publish]

Updates plugin and npm package versions, runs validators, and creates the release commit.
With --push, pushes main to origin before the install tests (the Claude
marketplace syncs from GitHub, so the tests need the release content on
origin/main), then tags, pushes the tag, and publishes a GitHub Release via
gh CLI. Without --push, the Claude install test is skipped unless HEAD already
matches origin's main. 0.x releases are marked prerelease; 1.x and later are
stable releases. A pushed release also publishes the matching public
`oh-no-harness` package to npm for OpenCode unless `--skip-npm-publish` is set.

Examples:
  scripts/release v0.2.1
  scripts/release 0.2.1 --push
  scripts/release 0.2.1 --skip-tests
  scripts/release 0.2.1 --push --skip-npm-publish
USAGE
}

fail() {
  printf 'release: %s\n' "$1" >&2
  exit 1
}

run() {
  printf '+ %s\n' "$*"
  "$@"
}

# The Claude install test verifies the GitHub-synced marketplace clone, so it
# can only pass when local HEAD matches the main branch on origin. Uses
# ls-remote so the answer is live, not dependent on a fresh fetch.
remote_main_matches_head() {
  local remote_sha
  remote_sha="$(git ls-remote origin refs/heads/main 2>/dev/null | cut -f1)"
  [ -n "$remote_sha" ] && [ "$remote_sha" = "$(git rev-parse HEAD)" ]
}

# Build Markdown release notes from commits between the previous tag and the
# new tag, grouped by conventional-commit prefix. Excludes the release commit
# itself. Appends the standard "**Full Changelog**: ..." compare link.
build_release_notes() {
  local tag="$1" prev_tag repo_slug
  prev_tag=$(git describe --tags --abbrev=0 "${tag}^" 2>/dev/null || true)
  repo_slug=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
  "$PYTHON_BIN" - "$tag" "$prev_tag" "$repo_slug" <<'PY'
import re
import subprocess
import sys

tag, prev_tag, repo_slug = sys.argv[1:4]
range_ = f"{prev_tag}..{tag}" if prev_tag else tag
log = subprocess.run(
    ["git", "log", "--reverse", "--pretty=format:%h%x09%s", range_],
    check=True,
    capture_output=True,
    text=True,
).stdout.splitlines()

buckets = {"Features": [], "Fixes": [], "Documentation": [], "Other": []}
prefix_to_bucket = {"feat": "Features", "fix": "Fixes", "docs": "Documentation"}
release_re = re.compile(r"^chore: release v\d+\.\d+\.\d+$")
prefix_re = re.compile(r"^(\w+)(\([^)]*\))?:")

for entry in log:
    if "\t" not in entry:
        continue
    sha, subject = entry.split("\t", 1)
    if release_re.match(subject):
        continue
    match = prefix_re.match(subject)
    bucket = prefix_to_bucket.get(match.group(1) if match else "", "Other")
    buckets[bucket].append((subject, sha))

lines = []
for heading, items in buckets.items():
    if not items:
        continue
    lines.append(f"## {heading}")
    lines.append("")
    for subject, sha in items:
        lines.append(f"- {subject} (`{sha}`)")
    lines.append("")

if not any(buckets.values()):
    lines.append("_No notable changes since the previous release._")
    lines.append("")

if prev_tag and repo_slug:
    lines.append(
        f"**Full Changelog**: https://github.com/{repo_slug}/compare/{prev_tag}...{tag}"
    )

sys.stdout.write("\n".join(lines).rstrip() + "\n")
PY
}

# Temp paths to remove on any exit (normal, failure, or interrupt). Populated as
# temp dirs/files are created so a single trap cleans up every code path.
cleanup_paths=()

cleanup() {
  local path
  for path in ${cleanup_paths[@]+"${cleanup_paths[@]}"}; do
    [ -n "$path" ] && rm -rf "$path"
  done
}

# Derive a credential-free owner/repo slug from an origin URL via the shared
# primitive. Exits non-zero with a generic message (never echoing the raw URL)
# when origin is not a supported credential-free GitHub form, so a non-GitHub or
# credentialed origin fails closed instead of leaking or registering junk.
github_slug_from_origin() {
  "$PYTHON_BIN" "$REPO_ROOT/scripts/marketplace_source.py" github-slug "$1"
}

# Run the Claude install test against the GitHub-synced marketplace, identified
# by a credential-free owner/repo slug, inside the child's OWN isolated config
# home (--isolated-config). OH_NO_INSTALL=1 forces the real install/verify path
# (never a plugin-dir shortcut), so it actually exercises the pushed revision;
# the child creates and cleans its temp config, so the developer's real
# ~/.claude registration is never touched.
run_claude_install_test() {
  local slug="$1"
  OH_NO_MARKETPLACE_NAME="$MARKETPLACE_NAME" \
    OH_NO_MARKETPLACE_SOURCE="$slug" \
    OH_NO_INSTALL=1 \
    OH_NO_LIVE=0 OH_NO_DEEP_LIVE=0 OH_NO_PARALLEL_LIVE=0 OH_NO_RALPLAN_LIVE=0 \
    OH_NO_RALPLAN_V2_LIVE=0 OH_NO_FUSION_RESCUE_LIVE=0 OH_NO_CROSS_HOST_FALLBACK_LIVE=0 \
    OH_NO_CROSS_HOST_REVIEW_LIVE=0 OH_NO_RALPLAN_XHOST_LIVE=0 OH_NO_VBC_XHOST_LIVE=0 \
    OH_NO_SYSDEBUG_XHOST_LIVE=0 OH_NO_PARALLEL_EXECUTOR_LIVE=0 OH_NO_SIMPLIFY_LIVE=0 \
    OH_NO_NATURAL_SESSION_START_LIVE=0 OH_NO_LIVE_HOOK_ONLY=0 \
    run scripts/test-claude-plugin.sh --isolated-config
}

npm_published_integrity() {
  local identity="$1"
  "$NPM_BIN" view "$identity" dist.integrity 2>/dev/null || true
}

# Pack the plugin exactly once into $1 and print "<tarball path>\t<integrity>".
# Every later step (packed OpenCode test, existing-version comparison, publish,
# postflight) consumes this one artifact, so the release can never test one
# build of the package and publish a different one.
pack_npm_artifact() {
  local destination="$1" report
  report="$destination/pack.json"
  "$NPM_BIN" pack "$PLUGIN_ROOT" --json --pack-destination "$destination" >"$report"
  "$PYTHON_BIN" - "$report" "$destination" <<'PY'
import json
import sys
from pathlib import Path

report = json.load(open(sys.argv[1], encoding="utf-8"))
if not isinstance(report, list) or len(report) != 1:
    raise SystemExit("npm pack did not return exactly one package report")
entry = report[0]
integrity = entry.get("integrity")
filename = entry.get("filename")
if not isinstance(integrity, str) or not integrity:
    raise SystemExit("npm pack did not report package integrity")
if not isinstance(filename, str) or not filename:
    raise SystemExit("npm pack did not report a tarball filename")
tarball = Path(sys.argv[2]) / Path(filename).name
if not tarball.is_file():
    raise SystemExit("npm pack did not produce the reported tarball")
print(f"{tarball}\t{integrity}")
PY
}

preflight_npm_publish() {
  local identity="$1"
  if [ -z "$(npm_published_integrity "$identity")" ]; then
    "$NPM_BIN" whoami >/dev/null \
      || fail "npm authentication is required before pushing a release"
  fi
}

# Publish the exact tarball that was packed, tested, and compared, then require
# the registry to report the same integrity immediately after a new publish.
publish_npm_package() {
  local identity="$1" tarball="$2" local_integrity="$3" remote_integrity
  [ -f "$tarball" ] || fail "release tarball is missing: $tarball"
  [ -n "$local_integrity" ] || fail "local package integrity is unknown"
  remote_integrity="$(npm_published_integrity "$identity")"
  if [ -n "$remote_integrity" ]; then
    [ "$remote_integrity" = "$local_integrity" ] \
      || fail "npm version $identity already exists with different contents"
    printf 'release: npm package %s already exists with matching integrity; skipping publish\n' "$identity"
    return
  fi
  run "$NPM_BIN" publish "$tarball" --access public
  remote_integrity="$(npm_published_integrity "$identity")"
  [ -n "$remote_integrity" ] \
    || fail "npm did not report integrity for $identity after publish"
  [ "$remote_integrity" = "$local_integrity" ] \
    || fail "published npm integrity for $identity does not match the released tarball"
}

# Refuse to mutate versions while any untracked, non-ignored path exists under
# the plugin root: whole-plugin staging used to sweep such content into the
# release commit, and even with exact staging it signals an unreviewed tree.
assert_no_untracked_plugin_content() {
  local untracked
  untracked="$(git ls-files --others --exclude-standard -- "$PLUGIN_REL")"
  [ -z "$untracked" ] || fail "untracked files exist under $PLUGIN_REL; commit, remove, or ignore them first:
$untracked"
}

# Stage only the three version manifests, never the whole plugin directory.
stage_release_version_files() {
  run git add -- "${VERSION_FILES[@]}"
}

# Fail closed on every GitHub Release prerequisite before any irreversible side
# effect: gh must exist, auth must succeed, the credential-free origin slug must
# be the repository gh can reach, and no target release may already exist.
# gh output is suppressed so token material is never echoed.
preflight_github_release() {
  local tag="$1" origin slug gh_slug
  command -v gh >/dev/null 2>&1 \
    || fail "gh CLI is required to publish the GitHub Release for $tag"
  gh auth status >/dev/null 2>&1 \
    || fail "gh authentication failed; run 'gh auth login' before releasing"
  origin="$(git remote get-url origin 2>/dev/null || true)"
  slug="$(github_slug_from_origin "$origin" 2>/dev/null)" \
    || fail "origin is not a supported credential-free GitHub URL; refusing to publish a GitHub Release"
  gh_slug="$(gh repo view "$slug" --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
  [ "$gh_slug" = "$slug" ] \
    || fail "gh cannot access repository $slug with the current credential"
  if gh release view "$tag" --repo "$slug" >/dev/null 2>&1; then
    fail "GitHub Release $tag already exists; refusing to modify it"
  fi
}

# True only in the conservative resumable state: local and remote target tags
# both exist, are annotated, and peel to current HEAD. Anything else (missing,
# lightweight, divergent, or local-only tag) fails closed so the release never
# replaces or force-updates a tag.
release_forward_completion_ready() {
  local tag="$1" head local_obj remote_line remote_obj
  head="$(git rev-parse HEAD)"
  git rev-parse --verify --quiet "refs/tags/${tag}" >/dev/null || return 1
  [ "$(git cat-file -t "refs/tags/${tag}")" = "tag" ] || return 1
  [ "$(git rev-parse "refs/tags/${tag}^{commit}")" = "$head" ] || return 1
  local_obj="$(git rev-parse "refs/tags/${tag}")"
  remote_line="$(git ls-remote --tags origin "refs/tags/${tag}" 2>/dev/null | cut -f1)"
  remote_obj="$(printf '%s\n' "$remote_line" | head -n 1)"
  [ -n "$remote_obj" ] || return 1
  [ "$remote_obj" = "$local_obj" ] || return 1
  return 0
}

# When sourced (e.g. by the offline regression test in
# scripts/test-claude-plugin.sh) stop before the straight-line release body so
# callers can exercise individual functions without cutting a real release.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  return 0 2>/dev/null || true
fi

version_arg=""
push="false"
skip_tests="false"
skip_npm_publish="false"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --push)
      push="true"
      shift
      ;;
    --skip-tests)
      skip_tests="true"
      shift
      ;;
    --skip-npm-publish)
      skip_npm_publish="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      fail "unknown argument: $1"
      ;;
    *)
      [ -z "$version_arg" ] || fail "multiple versions provided"
      version_arg="$1"
      shift
      ;;
  esac
done

[ -n "$version_arg" ] || { usage >&2; exit 2; }

version="${version_arg#v}"
tag="v${version}"
major="${version%%.*}"

printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' \
  || fail "version must look like 0.2.1 or v0.2.1"

cd "$REPO_ROOT"

current_branch="$(git branch --show-current || true)"
[ "$current_branch" = "main" ] \
  || fail "run from main; current branch is ${current_branch:-detached}"

if ! git diff --quiet || ! git diff --cached --quiet; then
  fail "tracked working tree changes exist; commit or stash them first"
fi

assert_no_untracked_plugin_content

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Tag state decides between a first run and the single conservative forward-
# completion path (matching annotated local+remote tag at HEAD, no GitHub
# Release yet). Every other pre-existing tag state fails closed.
forward_completion="false"
tag_exists_locally="false"
git rev-parse --verify "refs/tags/${tag}" >/dev/null 2>&1 && tag_exists_locally="true"
tag_exists_on_origin="false"
if git remote get-url origin >/dev/null 2>&1 \
  && git ls-remote --exit-code --tags origin "refs/tags/${tag}" >/dev/null 2>&1; then
  tag_exists_on_origin="true"
fi

if [ "$tag_exists_locally" = "true" ] || [ "$tag_exists_on_origin" = "true" ]; then
  [ "$push" = "true" ] \
    || fail "tag $tag already exists; rerun with --push to complete the GitHub Release, or delete the tag"
  release_forward_completion_ready "$tag" \
    || fail "tag $tag already exists but does not match an annotated local+remote tag at HEAD; refusing to replace it"
  forward_completion="true"
  printf 'release: %s already exists as a matching annotated tag on HEAD and origin; completing the GitHub Release only\n' "$tag"
fi

# Fail closed on GitHub prerequisites before any version write, commit, push,
# publish, or tag. A pre-existing target Release is never silently accepted.
if [ "$push" = "true" ]; then
  preflight_github_release "$tag"
fi

if [ "$forward_completion" = "false" ]; then
"$PYTHON_BIN" - "$version" "$PLUGIN_ROOT" <<'PY'
import json
import sys
from pathlib import Path

version = sys.argv[1]
plugin_root = Path(sys.argv[2])
for rel in (".claude-plugin/plugin.json", ".codex-plugin/plugin.json", "package.json"):
    path = plugin_root / rel
    data = json.loads(path.read_text(encoding="utf-8"))
    if data.get("version") != version:
        data["version"] = version
        path.write_text(
            json.dumps(data, indent=2, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
PY

run "$PYTHON_BIN" scripts/generate-agent-wrappers.py --plugin-root "$PLUGIN_ROOT" --check
run "$PYTHON_BIN" scripts/validate-plugin-files.py "$REPO_ROOT" "$PLUGIN_ROOT"

if [ "$push" = "true" ] && [ "$skip_npm_publish" = "false" ]; then
  preflight_npm_publish "oh-no-harness@$version"
fi

if git diff --quiet -- "${VERSION_FILES[@]}"; then
  printf 'release: version files already at %s; no release commit needed\n' "$tag"
else
  stage_release_version_files
  run git commit -m "chore: release ${tag}"
fi

if [ "$push" = "true" ]; then
  run git push origin main
fi
else
  run "$PYTHON_BIN" scripts/generate-agent-wrappers.py --plugin-root "$PLUGIN_ROOT" --check
  run "$PYTHON_BIN" scripts/validate-plugin-files.py "$REPO_ROOT" "$PLUGIN_ROOT"
  if [ "$push" = "true" ] && ! remote_main_matches_head; then
    run git push origin main
  fi
fi

# Pack exactly once after version synchronization/validation. The packed
# OpenCode test, existing-version comparison, publish, and postflight all use
# this single artifact.
pack_dir="$(mktemp -d)"
cleanup_paths+=("$pack_dir")
pack_result="$(pack_npm_artifact "$pack_dir")"
release_tarball="${pack_result%%$'\t'*}"
release_integrity="${pack_result##*$'\t'}"
[ -f "$release_tarball" ] && [ -n "$release_integrity" ] \
  || fail "failed to pack the release npm artifact"

if [ "$forward_completion" = "true" ] && [ "$skip_npm_publish" = "false" ]; then
  published_integrity="$(npm_published_integrity "oh-no-harness@$version")"
  [ "$published_integrity" = "$release_integrity" ] \
    || fail "npm oh-no-harness@$version does not match the current tarball; refusing to resume into a GitHub Release"
fi

if [ "$skip_tests" = "true" ]; then
  printf 'release: skipping local install tests (--skip-tests)\n'
else
  tests_failed="false"
  OH_NO_PACKAGE_TARBALL="$release_tarball" run scripts/test-opencode-package.sh || tests_failed="true"
  codex_test_home="$(mktemp -d)"
  cleanup_paths+=("$codex_test_home")
  OH_NO_MARKETPLACE_NAME="$MARKETPLACE_NAME" OH_NO_LIVE=0 OH_NO_DEEP_LIVE=0 OH_NO_PARALLEL_LIVE=0 OH_NO_RALPLAN_LIVE=0 OH_NO_RALPLAN_V2_LIVE=0 OH_NO_NAMED_AGENTS_LIVE=0 OH_NO_FUSION_RESCUE_LIVE=0 OH_NO_CODEX_CROSS_HOST_FALLBACK_LIVE=0 OH_NO_SIMPLIFY_LIVE=0 OH_NO_NATURAL_SESSION_START_LIVE=0 OH_NO_WORKTREE_LIVE=0 run scripts/test-codex-plugin.sh --codex-home "$codex_test_home" \
    || tests_failed="true"
  if [ "$tests_failed" = "false" ]; then
    if remote_main_matches_head; then
      # Verify the GitHub-synced marketplace inside the child's own isolated
      # config home, so this check never touches the real ~/.claude registration.
      # Derive a credential-free owner/repo slug from origin; a non-GitHub or
      # credentialed origin cannot be verified and fails closed here.
      claude_origin="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
      if claude_slug="$(github_slug_from_origin "$claude_origin" 2>/dev/null)"; then
        run_claude_install_test "$claude_slug" || tests_failed="true"
      elif [ "$push" = "true" ]; then
        printf 'release: origin is not a supported credential-free GitHub URL; refusing to run the Claude install test against an unverified marketplace source.\n' >&2
        tests_failed="true"
      else
        printf 'release: skipping Claude install test: origin is not a supported credential-free GitHub URL, so the GitHub-synced marketplace cannot be verified.\n'
      fi
    elif [ "$push" = "true" ]; then
      printf 'release: HEAD does not match main on origin even though main was just pushed (origin unreachable or main moved concurrently); refusing to skip the Claude install test.\n' >&2
      tests_failed="true"
    else
      printf 'release: skipping Claude install test: HEAD does not match main on origin (or origin is unreachable).\n'
      printf 'release: the Claude install test verifies the GitHub-synced marketplace and cannot pass against unpushed content; this version will not get that check unless you delete the local tag and rerun with --push.\n'
    fi
  fi
  if [ "$tests_failed" = "true" ]; then
    if [ "$push" = "true" ]; then
      printf 'release: install tests failed after main was pushed; no tag or GitHub Release was created.\n' >&2
      printf 'release: after fixing, rerun `scripts/release %s --push` to resume idempotently (version commit no-op, main push no-op, tests, tag, release).\n' "$version" >&2
    fi
    fail "install tests failed; tag $tag was not created"
  fi
fi

if [ "$forward_completion" = "true" ]; then
  printf 'release: npm package and tag %s already match HEAD; skipping publish and tag creation\n' "$tag"
elif [ "$push" = "true" ] && [ "$skip_npm_publish" = "false" ]; then
  publish_npm_package "oh-no-harness@$version" "$release_tarball" "$release_integrity"
elif [ "$push" = "true" ]; then
  printf 'release: skipping npm publish (--skip-npm-publish)\n'
fi

if [ "$forward_completion" = "false" ]; then
  run git tag -a "$tag" -m "$tag"
fi

notes_file="$(mktemp)"
cleanup_paths+=("$notes_file")
build_release_notes "$tag" >"$notes_file"

if [ "$push" = "true" ]; then
  if [ "$forward_completion" = "false" ]; then
    run git push origin "$tag"
  fi
  if command -v gh >/dev/null 2>&1; then
    gh_release_cmd=(gh release create "$tag" --title "$tag" --notes-file "$notes_file")
    if [ "$major" = "0" ]; then
      gh_release_cmd+=(--prerelease)
    else
      gh_release_cmd+=(--latest)
    fi
    if ! run "${gh_release_cmd[@]}"; then
      printf 'release: tag %s was pushed but the GitHub Release was not created; publish manually with:\n' "$tag" >&2
      printf '  gh release create %s --title %s %s --notes-file <notes>\n' "$tag" "$tag" "$( [ "$major" = "0" ] && printf -- '--prerelease' || printf -- '--latest')" >&2
      exit 1
    fi
  else
    release_kind_flag="--latest"
    [ "$major" = "0" ] && release_kind_flag="--prerelease"
    cat <<EOF
release: gh CLI not found; publish the GitHub Release manually:
  gh release create $tag --title $tag $release_kind_flag --notes-file <(cat <<'NOTES'
$(cat "$notes_file")
NOTES
)
EOF
  fi
else
  release_kind_flag="--latest"
  [ "$major" = "0" ] && release_kind_flag="--prerelease"
  cat <<EOF
release: created local commit (if needed) and tag $tag
release: publish with:
  git push origin main
  git push origin $tag
  gh release create $tag --title $tag $release_kind_flag --notes-file <(cat <<'NOTES'
$(cat "$notes_file")
NOTES
)
EOF
fi
