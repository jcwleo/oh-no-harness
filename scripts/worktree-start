#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/worktree-start <branch> [options]

Create an isolated git worktree for oh-no-harness execution.

Options:
  --base <ref>       Base ref for a new branch (default: HEAD)
  --path <path>      Exact worktree path to create/use
  --global           Use ~/.config/oh-no-harness/worktrees/<project>/<branch-slug>
  --no-setup         Skip dependency/setup auto-detection
  --no-baseline      Skip baseline verification
  --baseline <cmd>   Baseline verification command to run inside the worktree
  --print-path       Print only the final worktree path after creation
  -h, --help         Show this help

Directory priority when --path/--global are not supplied:
  1. Existing .worktrees/
  2. Existing worktrees/
  3. New .worktrees/ (project-local default; must be gitignored)
USAGE
}

branch=""
base_ref="HEAD"
path_override=""
use_global=0
run_setup=1
run_baseline=1
baseline_cmd=""
print_path=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --base)
      base_ref="${2:?missing value for --base}"
      shift 2
      ;;
    --path)
      path_override="${2:?missing value for --path}"
      shift 2
      ;;
    --global)
      use_global=1
      shift
      ;;
    --no-setup)
      run_setup=0
      shift
      ;;
    --no-baseline)
      run_baseline=0
      shift
      ;;
    --baseline)
      baseline_cmd="${2:?missing value for --baseline}"
      shift 2
      ;;
    --print-path)
      print_path=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      printf 'worktree-start: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [ -n "$branch" ]; then
        printf 'worktree-start: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 2
      fi
      branch="$1"
      shift
      ;;
  esac
done

if [ -z "$branch" ]; then
  usage >&2
  exit 2
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'worktree-start: not inside a git repository\n' >&2
  exit 1
}
cd "$root"

project=$(basename "$root")
slug=$(printf '%s' "$branch" | sed -E 's#[^A-Za-z0-9._-]+#-#g; s#^-+##; s#-+$##')
if [ -z "$slug" ]; then
  printf 'worktree-start: branch name produced an empty path slug\n' >&2
  exit 1
fi

ensure_project_local_ignored() {
  local dir="$1"
  if git check-ignore -q "$dir/" 2>/dev/null; then
    return 0
  fi
  if [ ! -f .gitignore ]; then
    : > .gitignore
  fi
  if ! grep -qxF "$dir/" .gitignore 2>/dev/null; then
    printf '\n%s/\n' "$dir" >> .gitignore
  fi
  if ! git check-ignore -q "$dir/" 2>/dev/null; then
    printf 'worktree-start: failed to make %s ignored by git\n' "$dir" >&2
    exit 1
  fi
  printf 'worktree-start: added %s/ to .gitignore; commit that policy change with your workflow updates.\n' "$dir" >&2
}

if [ -n "$path_override" ]; then
  case "$path_override" in
    /*) worktree_path="$path_override" ;;
    *) worktree_path="$root/$path_override" ;;
  esac
  case "$worktree_path" in
    "$root"/*)
      rel=${worktree_path#"$root"/}
      top=${rel%%/*}
      ensure_project_local_ignored "$top"
      ;;
  esac
elif [ "$use_global" -eq 1 ]; then
  worktree_path="$HOME/.config/oh-no-harness/worktrees/$project/$slug"
else
  if [ -d .worktrees ]; then
    worktree_dir=".worktrees"
  elif [ -d worktrees ]; then
    worktree_dir="worktrees"
  else
    worktree_dir=".worktrees"
  fi
  ensure_project_local_ignored "$worktree_dir"
  worktree_path="$root/$worktree_dir/$slug"
fi

mkdir -p "$(dirname "$worktree_path")"

if git worktree list --porcelain | awk '/^worktree / {sub(/^worktree /, ""); print}' | grep -Fxq "$worktree_path"; then
  printf 'worktree-start: existing worktree found at %s\n' "$worktree_path" >&2
else
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$worktree_path" "$branch" >&2
  else
    git worktree add -b "$branch" "$worktree_path" "$base_ref" >&2
  fi
fi

run_if_present() {
  local cmd="$1"
  printf 'worktree-start: running %s\n' "$cmd" >&2
  (cd "$worktree_path" && eval "$cmd")
}

if [ "$run_setup" -eq 1 ]; then
  if [ -f "$worktree_path/package.json" ]; then
    if [ -f "$worktree_path/package-lock.json" ]; then
      run_if_present "npm ci"
    else
      run_if_present "npm install"
    fi
  fi
  if [ -f "$worktree_path/Cargo.toml" ]; then
    run_if_present "cargo build"
  fi
  if [ -f "$worktree_path/requirements.txt" ]; then
    run_if_present "python3 -m pip install -r requirements.txt"
  fi
  if [ -f "$worktree_path/pyproject.toml" ]; then
    if [ -f "$worktree_path/uv.lock" ] && command -v uv >/dev/null 2>&1; then
      run_if_present "uv sync"
    elif [ -f "$worktree_path/poetry.lock" ] && command -v poetry >/dev/null 2>&1; then
      run_if_present "poetry install"
    fi
  fi
  if [ -f "$worktree_path/go.mod" ]; then
    run_if_present "go mod download"
  fi
fi

if [ "$run_baseline" -eq 1 ]; then
  if [ -z "$baseline_cmd" ]; then
    if [ -x "$worktree_path/scripts/validate-skills" ]; then
      baseline_cmd="scripts/validate-skills"
    elif [ -f "$worktree_path/package.json" ]; then
      baseline_cmd="npm test"
    elif [ -f "$worktree_path/Cargo.toml" ]; then
      baseline_cmd="cargo test"
    elif [ -d "$worktree_path/tests" ] && command -v pytest >/dev/null 2>&1; then
      baseline_cmd="pytest"
    elif [ -f "$worktree_path/go.mod" ]; then
      baseline_cmd="go test ./..."
    fi
  fi
  if [ -n "$baseline_cmd" ]; then
    run_if_present "$baseline_cmd"
  else
    printf 'worktree-start: no baseline command detected; skipping baseline verification.\n' >&2
  fi
fi

if [ "$print_path" -eq 1 ]; then
  printf '%s\n' "$worktree_path"
else
  cat <<EOF2
worktree-start: ready
  project: $project
  branch:  $branch
  path:    $worktree_path
  setup:   $([ "$run_setup" -eq 1 ] && printf enabled || printf skipped)
  baseline:$([ "$run_baseline" -eq 1 ] && printf ' %s' "${baseline_cmd:-skipped/no command}" || printf ' skipped')
EOF2
fi
