python3 - <<'PY'
import json
import re
import sys
from pathlib import Path

manifest_version = json.loads(Path(".claude-plugin/plugin.json").read_text())["version"]
codex_version = json.loads(Path(".codex-plugin/plugin.json").read_text())["version"]
if manifest_version != codex_version:
    raise SystemExit(
        f"validate-skills: plugin manifest versions diverge: "
        f"claude={manifest_version} codex={codex_version}"
    )

changelog = Path("CHANGELOG.md").read_text()
heading = re.compile(rf"^## \[{re.escape(manifest_version)}\]", re.MULTILINE)
if not heading.search(changelog):
    raise SystemExit(
        f"validate-skills: CHANGELOG.md is missing a '## [{manifest_version}]' "
        "section for the current manifest version"
    )

marketplace = json.loads(Path(".claude-plugin/marketplace.json").read_text())
ref = marketplace["plugins"][0]["source"]["ref"]
if ref != f"v{manifest_version}":
    raise SystemExit(
        f"validate-skills: marketplace ref {ref} does not match manifest "
        f"version v{manifest_version}"
    )

readme = Path("README.md").read_text()
if f"v{manifest_version}" not in readme:
    raise SystemExit(
        f"validate-skills: README.md does not pin v{manifest_version}"
    )
PY

