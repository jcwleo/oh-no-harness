  require_grep "AC-001|T-001|VR-001" "$template"
done
require_grep "Worktree isolation: required" templates/plan.md
require_grep "scripts/worktree-start" templates/plan.md
require_grep "Dirty changes" templates/plan.md
require_grep "Helper resolution" templates/plan.md
require_grep "Worktree:" templates/progress.md
require_grep "Worktree baseline" templates/progress.md
require_grep "Dirty-change handling" templates/progress.md
require_grep "Verification checkout/worktree" templates/verify.md

for worktree_agent in executor debugger test-engineer verifier code-reviewer; do
  require_grep "worktree|Worktree" "agents/${worktree_agent}.md"
  require_grep "worktree|Worktree" "${generated_codex_agents_dir}/${worktree_agent}.toml"
done

for file in skills/*/SKILL.md agents/*.md; do
  require_grep "root-cause|root cause|temporary workaround|diagnostic logging|tracing|assertions?|workaround" "$file"
  require_grep "Do not cut corners|Completion integrity|Integrity rule" "$file"
done

for forbidden in "using""-oh-no" brainstorming deep-interview writing-plans implementation-plan ralplan; do
  if [ -e "skills/${forbidden}" ]; then
    fail "forbidden skill directory exists: skills/${forbidden}"
  fi
done

if [ -d adapters ]; then
  fail "adapters/ should not exist in root-installable layout"
fi

if grep -RIn "using""-oh-no" bootstrap skills agents .codex-plugin .claude-plugin hooks README.md >/tmp/oh-no-forbidden-grep.txt 2>/dev/null; then
  cat /tmp/oh-no-forbidden-grep.txt >&2
  fail "forbidden bootstrap-as-skill name found"
fi

require_file README.md
require_grep "clarify -> planning" README.md
require_grep "scripts/validate-skills" README.md
require_grep "scripts/sync-codex-agents" README.md
require_grep "Isolated worktrees" README.md
require_grep "scripts/worktree-start" README.md
require_grep "installed harness helper" README.md
require_grep "dirty changes" README.md
require_grep "Codex" README.md
require_grep "Claude" README.md
require_grep "Superpowers" README.md
require_grep "root-level" README.md
require_grep "platform-specific" README.md

require_file AGENTS.md
require_grep "Repository Guidelines" AGENTS.md
require_grep "scripts/sync-codex-agents" AGENTS.md

tmp_dir="$(mktemp -d)"
tmp_paths+=("$tmp_dir")
scripts/sync-adapters --write --out "$tmp_dir" >/dev/null

require_file "$tmp_dir/codex/.codex-plugin/plugin.json"
require_grep '"skills": "./skills/"' "$tmp_dir/codex/.codex-plugin/plugin.json"
require_file "$tmp_dir/claude/.claude-plugin/plugin.json"
require_file "$tmp_dir/claude/hooks/session-start"
require_file "$tmp_dir/codex/scripts/sync-codex-agents"
require_file "$tmp_dir/codex/scripts/worktree-start"
require_file "$tmp_dir/claude/scripts/sync-codex-agents"
require_file "$tmp_dir/claude/scripts/worktree-start"
require_file "$tmp_dir/codex/templates/plan.md"
require_file "$tmp_dir/claude/templates/plan.md"
(cd "$tmp_dir/codex" && scripts/sync-codex-agents --check >/dev/null)

for agent in "${required_agents[@]}"; do
  require_file "$tmp_dir/claude/agents/${agent}.md"
  require_grep "^name: ${agent}$" "$tmp_dir/claude/agents/${agent}.md"
  require_grep "^tools:" "$tmp_dir/claude/agents/${agent}.md"

  require_file "$tmp_dir/codex/agents/${agent}.md"
  require_grep "^name: ${agent}$" "$tmp_dir/codex/agents/${agent}.md"

  require_file "$tmp_dir/codex/.codex/agents/${agent}.toml"
  require_grep "^name = \"${agent}\"$" "$tmp_dir/codex/.codex/agents/${agent}.toml"
done
validate_codex_agent_toml_dir "$tmp_dir/codex/.codex/agents"

printf 'validate-skills: OK\n'
