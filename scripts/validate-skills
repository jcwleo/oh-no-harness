require_grep "Architect" skills/planning/SKILL.md
require_grep "Critic" skills/planning/SKILL.md
require_grep "ADR" skills/planning/SKILL.md
require_grep "Worktree isolation: required" skills/planning/SKILL.md
require_grep "scripts/worktree-start" skills/planning/SKILL.md
require_grep "dirty changes" skills/planning/SKILL.md
require_grep "helper resolution" skills/planning/SKILL.md
require_grep "AC-" skills/clarify/SKILL.md
