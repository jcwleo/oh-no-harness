python3 - <<'PY'
import re
import sys
from pathlib import Path

forbidden_substrings = [
    "Uses a ",
    "Integrates ",
    "Combines ",
    "four-phase",
    "basic mode and --ral mode",
    "default clarification mode plus --deep",
]
canonical = ["clarify", "planning", "ralph", "debug", "verify"]
errors = []
for skill in canonical:
    path = Path(f"skills/{skill}/SKILL.md")
    text = path.read_text(encoding="utf-8")
    match = re.search(r'^description:\s*"([^"]*)"\s*$', text, re.MULTILINE)
    if not match:
        errors.append(f"{path}: description must be a double-quoted single line")
        continue
    description = match.group(1).strip()
    for needle in forbidden_substrings:
        if needle in description:
            errors.append(
                f"{path}: description contains process-summary fragment '{needle}'; "
                "see docs/oh-no/skill-authoring.md"
            )
if errors:
    for e in errors:
        print("validate-skills:", e, file=sys.stderr)
    raise SystemExit(1)
PY

