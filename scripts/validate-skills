#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'validate-skills: %s\n' "$1" >&2
  exit 1
}

require_file() {
  [ -f "$1" ] || fail "missing file: $1"
}

require_grep() {
  local pattern="$1"
  local file="$2"
  grep -Eq -- "$pattern" "$file" || fail "missing pattern '$pattern' in $file"
}

validate_codex_agent_toml_dir() {
  local dir="$1"
  python3 - "$dir" <<'PY'
import re
import sys
from pathlib import Path

dir_path = Path(sys.argv[1])
required = ("name", "description", "developer_instructions")
paths = sorted(dir_path.glob("*.toml"))
if not paths:
    raise SystemExit(f"{dir_path}: no TOML agents found")
for path in paths:
    text = path.read_text()
    values = {}
    for key in required:
        match = re.search(rf'^{re.escape(key)} = "(.+)"$', text, re.MULTILINE)
        if not match:
            raise SystemExit(f"{path}: missing {key}")
        values[key] = match.group(1)
    if path.stem != values["name"]:
        raise SystemExit(f"{path}: stem/name mismatch")
PY
}

canonical_skills=(clarify planning ralph debug verify)
required_agents=(planner architect critic code-reviewer executor verifier explore analyst debugger test-engineer)
required_templates=(spec plan progress verify)

tmp_paths=()
cleanup() {
  if [ "${#tmp_paths[@]}" -gt 0 ]; then
    rm -rf "${tmp_paths[@]}"
  fi
}
trap cleanup EXIT

generated_codex_agents_dir="$(mktemp -d)"
tmp_paths+=("$generated_codex_agents_dir")
require_file scripts/sync-codex-agents
