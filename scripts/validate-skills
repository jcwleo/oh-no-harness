require_grep "Retrieval protocol" bootstrap/oh-no.md
require_grep "Workflow sizing" bootstrap/oh-no.md
require_grep "root-cause|root cause" bootstrap/oh-no.md
require_grep "root-cause|root cause" skills/planning/SKILL.md
