  require_file "agents/${agent}.md"
  require_grep "^---$" "agents/${agent}.md"
  require_grep "^name: ${agent}$" "agents/${agent}.md"
  require_grep "^description:" "agents/${agent}.md"
  require_grep "^tools:" "agents/${agent}.md"
  require_grep "^Authority:" "agents/${agent}.md"
  require_grep "^Purpose:" "agents/${agent}.md"
  require_grep "^Checklist:" "agents/${agent}.md"
  require_file "${generated_codex_agents_dir}/${agent}.toml"
  require_grep "^name = \"${agent}\"$" "${generated_codex_agents_dir}/${agent}.toml"
  require_grep "^description = " "${generated_codex_agents_dir}/${agent}.toml"
  require_grep "^developer_instructions = " "${generated_codex_agents_dir}/${agent}.toml"
done
