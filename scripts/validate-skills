  require_grep "^name: ${skill}$" "skills/${skill}/SKILL.md"
  require_grep "^description:" "skills/${skill}/SKILL.md"
  require_grep "^when_to_use:" "skills/${skill}/SKILL.md"
  require_grep "^argument-hint:" "skills/${skill}/SKILL.md"
  require_grep "^arguments:" "skills/${skill}/SKILL.md"
  require_grep '\$ARGUMENTS' "skills/${skill}/SKILL.md"
done

expected_skills=$(printf '%s\n' "${canonical_skills[@]}" | sort)
actual_joined=$(find skills -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)
[ "$actual_joined" = "$expected_skills" ] || fail "skill directories must be exactly: ${canonical_skills[*]}"

