#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'validate-skills: %s\n' "$1" >&2
  exit 1
}

require_file() {
  [ -f "$1" ] || fail "missing file: $1"
}

require_grep() {
  local pattern="$1"
  local file="$2"
  grep -Eq -- "$pattern" "$file" || fail "missing pattern '$pattern' in $file"
}

validate_codex_agent_toml_dir() {
  local dir="$1"
  python3 - "$dir" <<'PY'
import re
import sys
from pathlib import Path

dir_path = Path(sys.argv[1])
required = ("name", "description", "developer_instructions")
paths = sorted(dir_path.glob("*.toml"))
if not paths:
    raise SystemExit(f"{dir_path}: no TOML agents found")
for path in paths:
    text = path.read_text()
    values = {}
    for key in required:
        match = re.search(rf'^{re.escape(key)} = "(.+)"$', text, re.MULTILINE)
        if not match:
            raise SystemExit(f"{path}: missing {key}")
        values[key] = match.group(1)
    if path.stem != values["name"]:
        raise SystemExit(f"{path}: stem/name mismatch")
PY
}

canonical_skills=(clarify planning ralph debug verify)
required_agents=(planner architect critic code-reviewer executor verifier explore analyst debugger test-engineer)
required_templates=(spec plan progress verify)

tmp_paths=()
cleanup() {
  if [ "${#tmp_paths[@]}" -gt 0 ]; then
    rm -rf "${tmp_paths[@]}"
  fi
}
trap cleanup EXIT

generated_codex_agents_dir="$(mktemp -d)"
tmp_paths+=("$generated_codex_agents_dir")
require_file scripts/sync-codex-agents
scripts/sync-codex-agents --write --out "$generated_codex_agents_dir" >/dev/null

require_file bootstrap/oh-no.md
for skill in "${canonical_skills[@]}"; do
  require_file "skills/${skill}/SKILL.md"
  require_grep "^name: ${skill}$" "skills/${skill}/SKILL.md"
  require_grep "^description:" "skills/${skill}/SKILL.md"
done

expected_skills=$(printf '%s\n' "${canonical_skills[@]}" | sort)
actual_joined=$(find skills -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)
[ "$actual_joined" = "$expected_skills" ] || fail "skill directories must be exactly: ${canonical_skills[*]}"

for agent in "${required_agents[@]}"; do
  require_file "agents/${agent}.md"
  require_grep "^---$" "agents/${agent}.md"
  require_grep "^name: ${agent}$" "agents/${agent}.md"
  require_grep "^description:" "agents/${agent}.md"
  require_grep "^tools:" "agents/${agent}.md"
  require_grep "^Authority:" "agents/${agent}.md"
  require_grep "^Purpose:" "agents/${agent}.md"
  require_grep "^Checklist:" "agents/${agent}.md"
  require_file "${generated_codex_agents_dir}/${agent}.toml"
  require_grep "^name = \"${agent}\"$" "${generated_codex_agents_dir}/${agent}.toml"
  require_grep "^description = " "${generated_codex_agents_dir}/${agent}.toml"
  require_grep "^developer_instructions = " "${generated_codex_agents_dir}/${agent}.toml"
done
validate_codex_agent_toml_dir "$generated_codex_agents_dir"

for template in "${required_templates[@]}"; do
  require_file "templates/${template}.md"
done

for readonly_agent in architect critic code-reviewer verifier explore analyst; do
  require_grep "read-only|read only" "agents/${readonly_agent}.md"
  require_grep "sandbox_mode = \"read-only\"" "${generated_codex_agents_dir}/${readonly_agent}.toml"
done
require_grep "write role" agents/executor.md

require_file .codex-plugin/plugin.json
require_file .claude-plugin/plugin.json
require_file hooks/hooks.json
require_file hooks/run-hook.cmd
require_file hooks/session-start
require_file scripts/sync-codex-agents
require_file scripts/sync-adapters
require_file scripts/worktree-start
require_file .gitignore

python3 -m json.tool .codex-plugin/plugin.json >/dev/null
python3 -m json.tool .claude-plugin/plugin.json >/dev/null
python3 -m json.tool hooks/hooks.json >/dev/null
bash -n scripts/sync-codex-agents
bash -n scripts/sync-adapters
bash -n scripts/worktree-start
bash -n scripts/validate-skills
bash -n hooks/session-start
bash -n hooks/run-hook.cmd
hooks/session-start | python3 -m json.tool >/dev/null

require_grep '"skills": "./skills/"' .codex-plugin/plugin.json
require_grep "SessionStart" hooks/hooks.json
require_grep "bootstrap/oh-no.md" hooks/session-start
scripts/sync-codex-agents --check --out "$generated_codex_agents_dir" >/dev/null

require_grep "--ral" skills/planning/SKILL.md
