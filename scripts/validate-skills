require_grep "Hypothesis and testing" skills/debug/SKILL.md
require_grep "three or more" skills/debug/SKILL.md
require_grep "explore" skills/debug/SKILL.md
require_grep "debugger" skills/debug/SKILL.md
require_grep "test-engineer" skills/debug/SKILL.md
require_grep "executor.*ralph" skills/debug/SKILL.md
require_grep "## Role passes" skills/verify/SKILL.md
require_grep "verifier" skills/verify/SKILL.md
require_grep "test-engineer" skills/verify/SKILL.md
require_grep "code-reviewer" skills/verify/SKILL.md
require_grep "architect" skills/verify/SKILL.md
require_grep "Host mapping" skills/ralph/SKILL.md
require_grep "spawn_agent" skills/ralph/SKILL.md
require_grep "Worktree isolation protocol" bootstrap/oh-no.md
require_grep "scripts/worktree-start" bootstrap/oh-no.md
