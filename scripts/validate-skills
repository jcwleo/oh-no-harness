require_grep "Plan self-review" skills/planning/SKILL.md
require_grep "Re-review loop" skills/planning/SKILL.md
require_grep "Mode: basic" skills/planning/SKILL.md
require_grep "VR-" skills/verify/SKILL.md
require_grep "Evidence-before-claims gate" skills/verify/SKILL.md
