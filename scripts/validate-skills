  require_grep "^tools:" "$tmp_dir/claude/agents/${agent}.md"

  require_file "$tmp_dir/codex/agents/${agent}.md"
  require_grep "^name: ${agent}$" "$tmp_dir/codex/agents/${agent}.md"

  require_file "$tmp_dir/codex/.codex/agents/${agent}.toml"
  require_grep "^name = \"${agent}\"$" "$tmp_dir/codex/.codex/agents/${agent}.toml"
done
validate_codex_agent_toml_dir "$tmp_dir/codex/.codex/agents"

printf 'validate-skills: OK\n'
