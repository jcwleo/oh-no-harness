require_grep "scripts/worktree-start" skills/ralph/SKILL.md
require_grep "[Hh]elper.*project-local.*installed oh-no.*manual fallback" skills/ralph/SKILL.md
require_grep "dirty changes" skills/ralph/SKILL.md
require_grep "Resume and context-window protocol" skills/verify/SKILL.md
require_grep "templates/spec.md" skills/clarify/SKILL.md
require_grep "templates/plan.md" skills/planning/SKILL.md
require_grep "templates/progress.md" skills/ralph/SKILL.md
require_grep "templates/verify.md" skills/verify/SKILL.md
require_grep "Role-pass matrix" bootstrap/oh-no.md
require_grep "explore.*analyst" bootstrap/oh-no.md
require_grep "planner.*architect.*critic" bootstrap/oh-no.md
require_grep "executor.*debugger.*test-engineer.*verifier.*code-reviewer.*architect" bootstrap/oh-no.md
require_grep "## Role passes" skills/clarify/SKILL.md
