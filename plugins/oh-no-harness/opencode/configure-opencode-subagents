#!/usr/bin/env node

import { readPreferenceState } from "./preferences.js";

const PROGRAM = "configure-opencode-subagents";

function usage() {
  console.error(`Usage: ${PROGRAM} check`);
}

async function main() {
  const [command, ...args] = process.argv.slice(2);
  if (command !== "check" || args.length !== 0) {
    usage();
    return 2;
  }

  const state = await readPreferenceState().catch(() => ({
    status: "ambiguous-config",
  }));
  console.log(`STATUS: ${state.status}`);
  return 0;
}

process.exitCode = await main();
