#!/usr/bin/env bash
set -euo pipefail

config_dir() {
  if [ -n "${OH_NO_CONFIG_DIR:-}" ]; then
    printf '%s\n' "$OH_NO_CONFIG_DIR"
    return
  fi

  # Pin to the oh-no-harness plugin data dir directly. Deliberately do NOT
  # honor CLAUDE_PLUGIN_DATA: it resolves to whichever plugin's context
  # invoked the script, so using it would let the writer (called from another
  # plugin's Bash) and the SessionStart-hook reader (always in oh-no-harness's
  # context) land on different files — silently breaking the auto-routing
  # toggle. CLAUDE_CONFIG_DIR is safe here because it is host-session-level and
  # identical for every plugin in a session, so writer and reader agree. When
  # it is set, resolve plugins-data under it and never consult ~/.claude, so a
  # single resolution order can never straddle two config homes.
  local plugins_data
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    plugins_data="${CLAUDE_CONFIG_DIR}/plugins/data"
  else
    plugins_data="${HOME}/.claude/plugins/data"
  fi
  if [ -d "$plugins_data" ]; then
    local match
    match=$(ls -1d "${plugins_data}"/*oh-no-harness* 2>/dev/null | head -n 1)
    if [ -n "$match" ]; then
      printf '%s\n' "$match"
      return
    fi
  fi

  if [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/oh-no-harness"
  else
    printf '%s\n' "${HOME}/.config/oh-no-harness"
  fi
}

config_path() {
  printf '%s/config.json\n' "$(config_dir)"
}

read_key() {
  # Prints "true" when <key>.enabled is true, else "false" (missing key/file
  # defaults to false). Whitespace-strips so it works on pretty or compact JSON.
  local key="$1" path
  path="$(config_path)"
  if [ -f "$path" ] && tr -d '\n\r\t ' <"$path" | grep -q "\"${key}\":{\"enabled\":true"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

is_enabled() {
  local key="${1:-autoRouting}"
  [ "$(read_key "$key")" = "true" ]
}

write_config() {
  # write_config <key> <true|false>: set one key while preserving the sibling.
  local key="$1" enabled="$2"
  local path dir auto codex
  path="$(config_path)"
  dir="$(dirname "$path")"
  mkdir -p "$dir"
  auto="$(read_key autoRouting)"
  codex="$(read_key codexExecutor)"
  case "$key" in
    autoRouting) auto="$enabled" ;;
    codexExecutor) codex="$enabled" ;;
  esac
  cat >"$path" <<JSON
{
  "autoRouting": {
    "enabled": ${auto}
  },
  "codexExecutor": {
    "enabled": ${codex}
  }
}
JSON
}

show_status() {
  local key="${1:-autoRouting}" label="${2:-auto-routing}"
  local path state
  path="$(config_path)"
  if is_enabled "$key"; then
    state="on"
  else
    state="off"
  fi
  printf '%s: %s\nconfig: %s\n' "$label" "$state" "$path"
}

show_restart_notice() {
  printf 'restart required: restart Claude Code or run /clear for this change to affect the active session.\n'
}

usage() {
  cat <<'USAGE'
Usage: scripts/oh-no-config <on|off|status|path|is-enabled>
       scripts/oh-no-config codex-executor <on|off|status|is-enabled>

Manages Oh No Harness user settings outside the plugin cache. The bare verbs
operate on auto-routing; the codex-executor subcommand operates on the
codexExecutor key. Both keys are stored side by side and preserved
independently.

Stored at <config-home>/plugins/data/<oh-no-harness-*>/config.json on
Claude Code, where <config-home> is $CLAUDE_CONFIG_DIR when set, else
$HOME/.claude. Falls back to $XDG_CONFIG_HOME/oh-no-harness/config.json
(default $HOME/.config/oh-no-harness/config.json) on hosts without that
layout.

Environment:
  OH_NO_CONFIG_DIR    Test override for the config directory (highest priority).
  CLAUDE_CONFIG_DIR   Claude Code host config home; when set, plugins-data is
                      resolved under it instead of $HOME/.claude.
USAGE
}

case "${1:-status}" in
  on|enable|enabled|true)
    write_config autoRouting true
    show_status
    show_restart_notice
    ;;
  off|disable|disabled|false)
    write_config autoRouting false
    show_status
    show_restart_notice
    ;;
  status|show)
    show_status
    ;;
  path)
    config_path
    ;;
  is-enabled)
    is_enabled
    ;;
  codex-executor)
    case "${2:-status}" in
      on|enable|enabled|true)
        write_config codexExecutor true
        show_status codexExecutor codex-executor
        show_restart_notice
        ;;
      off|disable|disabled|false)
        write_config codexExecutor false
        show_status codexExecutor codex-executor
        show_restart_notice
        ;;
      status|show)
        show_status codexExecutor codex-executor
        ;;
      is-enabled)
        is_enabled codexExecutor
        ;;
      -h|--help|help)
        usage
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
