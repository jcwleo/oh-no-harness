#!/usr/bin/env bash
set -euo pipefail

config_dir() {
  if [ -n "${OH_NO_CONFIG_DIR:-}" ]; then
    printf '%s\n' "$OH_NO_CONFIG_DIR"
    return
  fi

  # Pin to the oh-no-harness plugin data dir directly. Deliberately do NOT
  # honor CLAUDE_PLUGIN_DATA: it resolves to whichever plugin's context
  # invoked the script, so using it would let the writer (called from another
  # plugin's Bash) and the SessionStart-hook reader (always in oh-no-harness's
  # context) land on different files — silently breaking the auto-routing
  # toggle. CLAUDE_CONFIG_DIR is safe here because it is host-session-level and
  # identical for every plugin in a session, so writer and reader agree. When
  # it is set, resolve plugins-data under it and never consult ~/.claude, so a
  # single resolution order can never straddle two config homes.
  local plugins_data
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    plugins_data="${CLAUDE_CONFIG_DIR}/plugins/data"
  else
    plugins_data="${HOME}/.claude/plugins/data"
  fi
  if [ -d "$plugins_data" ]; then
    local self mp match=""
    # Derive the ACTIVE plugin-data identity from THIS script's own install location
    # so the writer (configure-subagents' oh-no-config sibling) and the SessionStart
    # reader always resolve the same dir. A real plugin-cache install lives at
    # <config-home>/plugins/cache/<marketplace>/oh-no-harness/<version>/scripts/oh-no-config,
    # whose matching data dir is oh-no-harness-<marketplace>.
    self="${BASH_SOURCE[0]:-$0}"
    case "$self" in
      */plugins/cache/*/oh-no-harness/*/scripts/oh-no-config)
        mp="${self%/oh-no-harness/*/scripts/oh-no-config}"
        mp="${mp##*/}"
        [ -n "$mp" ] && [ -d "${plugins_data}/oh-no-harness-${mp}" ] \
          && match="${plugins_data}/oh-no-harness-${mp}"
        ;;
    esac
    if [ -z "$match" ]; then
      # Not a cache install (e.g. a --plugin-dir inline/dev load) or the derived dir is
      # absent: deterministic, listing-order-independent fallback shared by writer and
      # reader. head (not tail) preserves the working inline identity.
      match="$(ls -1d "${plugins_data}"/*oh-no-harness* 2>/dev/null | LC_ALL=C sort | head -n 1)"
    fi
    if [ -n "$match" ]; then
      printf '%s\n' "$match"
      return
    fi
  fi

  if [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/oh-no-harness"
  else
    printf '%s\n' "${HOME}/.config/oh-no-harness"
  fi
}

config_path() {
  printf '%s/config.json\n' "$(config_dir)"
}

effective_config_path() {
  local canonical dir identity parent legacy
  canonical="$(config_path)"
  if [ -e "$canonical" ] || [ -L "$canonical" ]; then printf '%s\n' "$canonical"; return; fi

  dir="$(dirname "$canonical")"
  identity="$(basename "$dir")"
  [ "$identity" = "oh-no-harness-oh-no-harness" ] || { printf '%s\n' "$canonical"; return; }
  parent="$(dirname "$dir")"
  [ "$(basename "$parent")" = data ] || { printf '%s\n' "$canonical"; return; }
  [ "$(basename "$(dirname "$parent")")" = plugins ] || { printf '%s\n' "$canonical"; return; }
  legacy="${parent}/oh-no-harness-inline/config.json"
  if [ ! -L "$legacy" ] && [ -f "$legacy" ]; then printf '%s\n' "$legacy"; else printf '%s\n' "$canonical"; fi
}

config_is_enabled() {
  local path="$1"
  [ -f "$path" ] || return 1
  tr -d '\n\r\t ' <"$path" | grep -q '"autoRouting":{"enabled":true'
}

is_enabled() {
  config_is_enabled "$(effective_config_path)"
}

write_config() {
  local enabled="$1"
  local path dir
  path="$(config_path)"
  dir="$(dirname "$path")"
  mkdir -p "$dir"
  if [ "$enabled" = "true" ]; then
    cat >"$path" <<'JSON'
{
  "autoRouting": {
    "enabled": true
  }
}
JSON
  else
    cat >"$path" <<'JSON'
{
  "autoRouting": {
    "enabled": false
  }
}
JSON
  fi
}

show_status() {
  local path state
  path="$(effective_config_path)"
  if config_is_enabled "$path"; then
    state="on"
  else
    state="off"
  fi
  printf 'auto-routing: %s\nconfig: %s\n' "$state" "$path"
}

show_restart_notice() {
  printf 'auto-routing preference persisted; interpret this state under the active platform contract.\n'
}

usage() {
  cat <<'USAGE'
Usage: scripts/oh-no-config <on|off|status|path|is-enabled>

Manages Oh No Harness user settings outside the plugin cache.

Stored at <config-home>/plugins/data/<oh-no-harness-*>/config.json on
Claude Code, where <config-home> is $CLAUDE_CONFIG_DIR when set, else
$HOME/.claude. Falls back to $XDG_CONFIG_HOME/oh-no-harness/config.json
(default $HOME/.config/oh-no-harness/config.json) on hosts without that
layout.

Environment:
  OH_NO_CONFIG_DIR    Test override for the config directory (highest priority).
  CLAUDE_CONFIG_DIR   Claude Code host config home; when set, plugins-data is
                      resolved under it instead of $HOME/.claude.
USAGE
}

case "${1:-status}" in
  on|enable|enabled|true)
    write_config true
    show_status
    show_restart_notice
    ;;
  off|disable|disabled|false)
    write_config false
    show_status
    show_restart_notice
    ;;
  status|show)
    show_status
    ;;
  path)
    config_path
    ;;
  is-enabled)
    is_enabled
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
