#!/usr/bin/env bash
set -euo pipefail

config_dir() {
  if [ -n "${OH_NO_CONFIG_DIR:-}" ]; then
    printf '%s\n' "$OH_NO_CONFIG_DIR"
    return
  fi

  # Pin to the oh-no-harness plugin data dir directly. CLAUDE_PLUGIN_DATA
  # resolves to whichever plugin's context invoked the script, so honoring
  # it would let the writer (called from another plugin's Bash) and the
  # SessionStart-hook reader (always in oh-no-harness's context) land on
  # different files — which silently breaks the auto-routing toggle.
  local plugins_data="${HOME}/.claude/plugins/data"
  if [ -d "$plugins_data" ]; then
    local match
    match=$(ls -1d "${plugins_data}"/*oh-no-harness* 2>/dev/null | head -n 1)
    if [ -n "$match" ]; then
      printf '%s\n' "$match"
      return
    fi
  fi

  if [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/oh-no-harness"
  else
    printf '%s\n' "${HOME}/.config/oh-no-harness"
  fi
}

config_path() {
  printf '%s/config.json\n' "$(config_dir)"
}

is_enabled() {
  local path
  path="$(config_path)"
  [ -f "$path" ] || return 1
  tr -d '\n\r\t ' <"$path" | grep -q '"autoRouting":{"enabled":true'
}

write_config() {
  local enabled="$1"
  local path dir
  path="$(config_path)"
  dir="$(dirname "$path")"
  mkdir -p "$dir"
  if [ "$enabled" = "true" ]; then
    cat >"$path" <<'JSON'
{
  "autoRouting": {
    "enabled": true
  }
}
JSON
  else
    cat >"$path" <<'JSON'
{
  "autoRouting": {
    "enabled": false
  }
}
JSON
  fi
}

show_status() {
  local path state
  path="$(config_path)"
  if is_enabled; then
    state="on"
  else
    state="off"
  fi
  printf 'auto-routing: %s\nconfig: %s\n' "$state" "$path"
}

show_restart_notice() {
  printf 'restart required: restart Claude Code or run /clear for this change to affect the active session.\n'
}

usage() {
  cat <<'USAGE'
Usage: scripts/oh-no-config <on|off|status|path|is-enabled>

Manages Oh No Harness user settings outside the plugin cache.

Stored at $HOME/.claude/plugins/data/<oh-no-harness-*>/config.json on
Claude Code, or $XDG_CONFIG_HOME/oh-no-harness/config.json (default
$HOME/.config/oh-no-harness/config.json) on hosts without that layout.

Environment:
  OH_NO_CONFIG_DIR    Test override for the config directory.
USAGE
}

case "${1:-status}" in
  on|enable|enabled|true)
    write_config true
    show_status
    show_restart_notice
    ;;
  off|disable|disabled|false)
    write_config false
    show_status
    show_restart_notice
    ;;
  status|show)
    show_status
    ;;
  path)
    config_path
    ;;
  is-enabled)
    is_enabled
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
