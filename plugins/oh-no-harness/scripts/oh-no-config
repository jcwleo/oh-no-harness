#!/usr/bin/env bash
set -euo pipefail

config_dir() {
  if [ -n "${OH_NO_CONFIG_DIR:-}" ]; then
    printf '%s\n' "$OH_NO_CONFIG_DIR"
    return
  fi

  # Prefer the oh-no-harness plugin data dir ONLY on Claude/no-signal hosts. On a
  # Codex-positive host skip it so a co-installed Claude config is never read,
  # keeping the toggle per-host. Detect Codex via PLUGIN_ROOT, COPILOT_CLI, OR
  # CODEX_HOME: the SessionStart hook carries PLUGIN_ROOT, but an interactive
  # Codex command execution (e.g. `same-host-review on` from a skill) often
  # carries only CODEX_HOME — without checking it, the writer would land in the
  # plugin-data branch on a dual-install machine while the hook reader resolves
  # XDG, silently splitting the toggle. CODEX_HOME is Codex-specific (Claude
  # sessions do not set it; the codex-companion plugin sets CODEX_COMPANION_*,
  # not CODEX_HOME), so it is safe here. Pin the dir directly rather than via
  # CLAUDE_PLUGIN_DATA, which resolves to whichever plugin's context invoked the
  # script, so honoring it would let the writer (called from another plugin's
  # Bash) and the hook reader land on different files.
  if [ -z "${PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${CODEX_HOME:-}" ]; then
    local plugins_data="${HOME}/.claude/plugins/data"
    if [ -d "$plugins_data" ]; then
      local match
      match=$(ls -1d "${plugins_data}"/*oh-no-harness* 2>/dev/null | head -n 1)
      if [ -n "$match" ]; then
        printf '%s\n' "$match"
        return
      fi
    fi
  fi

  if [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/oh-no-harness"
  else
    printf '%s\n' "${HOME}/.config/oh-no-harness"
  fi
}

config_path() {
  printf '%s/config.json\n' "$(config_dir)"
}

read_key() {
  # Prints "true" when <key>.enabled is true, else "false" (missing key/file
  # defaults to false). Whitespace-strips so it works on pretty or compact JSON.
  local key="$1" path
  path="$(config_path)"
  if [ -f "$path" ] && tr -d '\n\r\t ' <"$path" | grep -q "\"${key}\":{\"enabled\":true"; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

is_enabled() {
  local key="${1:-autoRouting}"
  [ "$(read_key "$key")" = "true" ]
}

write_config() {
  # write_config <key> <true|false>: set one key while preserving siblings.
  local key="$1" enabled="$2"
  local path dir auto codex samehost
  path="$(config_path)"
  dir="$(dirname "$path")"
  mkdir -p "$dir"
  auto="$(read_key autoRouting)"
  codex="$(read_key codexExecutor)"
  samehost="$(read_key sameHostReview)"
  case "$key" in
    autoRouting) auto="$enabled" ;;
    codexExecutor) codex="$enabled" ;;
    sameHostReview) samehost="$enabled" ;;
  esac
  cat >"$path" <<JSON
{
  "autoRouting": {
    "enabled": ${auto}
  },
  "codexExecutor": {
    "enabled": ${codex}
  },
  "sameHostReview": {
    "enabled": ${samehost}
  }
}
JSON
}

show_status() {
  local key="${1:-autoRouting}" label="${2:-auto-routing}"
  local path state
  path="$(config_path)"
  if is_enabled "$key"; then
    state="on"
  else
    state="off"
  fi
  printf '%s: %s\nconfig: %s\n' "$label" "$state" "$path"
}

show_restart_notice() {
  printf 'restart required: restart Claude Code or run /clear for this change to affect the active session.\n'
}

show_same_host_note() {
  printf 'note: same-host-review is a per-host setting; on Codex, runtime effect requires plugin hooks enabled.\n'
}

usage() {
  cat <<'USAGE'
Usage: scripts/oh-no-config <on|off|status|path|is-enabled>
       scripts/oh-no-config codex-executor <on|off|status|is-enabled>
       scripts/oh-no-config same-host-review <on|off|status|is-enabled>

Manages Oh No Harness user settings outside the plugin cache. The bare verbs
operate on auto-routing; the codex-executor subcommand operates on the
codexExecutor key; the same-host-review subcommand operates on the
sameHostReview key. All keys are stored side by side and preserved
independently.

Stored at $HOME/.claude/plugins/data/<oh-no-harness-*>/config.json on
Claude Code or no-signal shell calls when that directory exists. Codex-positive
hosts and hosts without that layout use $XDG_CONFIG_HOME/oh-no-harness/config.json
(default $HOME/.config/oh-no-harness/config.json).

Environment:
  OH_NO_CONFIG_DIR    Test override for the config directory.
USAGE
}

case "${1:-status}" in
  on|enable|enabled|true)
    write_config autoRouting true
    show_status
    show_restart_notice
    ;;
  off|disable|disabled|false)
    write_config autoRouting false
    show_status
    show_restart_notice
    ;;
  status|show)
    show_status
    ;;
  path)
    config_path
    ;;
  is-enabled)
    is_enabled
    ;;
  codex-executor)
    case "${2:-status}" in
      on|enable|enabled|true)
        write_config codexExecutor true
        show_status codexExecutor codex-executor
        show_restart_notice
        ;;
      off|disable|disabled|false)
        write_config codexExecutor false
        show_status codexExecutor codex-executor
        show_restart_notice
        ;;
      status|show)
        show_status codexExecutor codex-executor
        ;;
      is-enabled)
        is_enabled codexExecutor
        ;;
      -h|--help|help)
        usage
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  same-host-review)
    case "${2:-status}" in
      on|enable|enabled|true)
        write_config sameHostReview true
        show_status sameHostReview same-host-review
        show_same_host_note
        show_restart_notice
        ;;
      off|disable|disabled|false)
        write_config sameHostReview false
        show_status sameHostReview same-host-review
        show_same_host_note
        show_restart_notice
        ;;
      status|show)
        show_status sameHostReview same-host-review
        show_same_host_note
        ;;
      is-enabled)
        is_enabled sameHostReview
        ;;
      -h|--help|help)
        usage
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
