#!/usr/bin/env bash
set -uo pipefail

# Configure the model and reasoning effort of the installed Oh No Harness Claude
# Code subagents. Human-invoked through the configure-subagents skill; the
# SessionStart hook calls `reapply --quiet` to restore choices after a plugin
# cache update. It mutates ONLY the installed runtime agent Markdown under the
# physical plugin root that contains THIS executing script (root/agents/); it
# never edits a generator-owned Git checkout, and never touches Codex
# custom-agent TOMLs.
#
# The production target root is derived from the physical location of this
# script, never from a caller-provided path or env override. Tests copy this
# script plus oh-no-config into a temp plugin root and run that copy.
#
# Subcommands:
#   check                     Report configuration state. Makes no changes.
#   apply --proxy <yes|no> \  Apply a full, ordered 9-agent configuration plus
#     [diversity options] \     its preferences as one lock-serialized, recoverable
#     <role=model,effort> x9    transaction (per-file atomic rename + journal +
#                              backup + rollback). Not globally atomic; each file
#                              rename is atomic and the whole set is recoverable.
#   reapply --quiet           Restore stored preferences when the runtime agents
#                              drifted (e.g. after a plugin update). Idempotent
#                              no-op when nothing is stored or already matching;
#                              skips safely when another run holds the lock.
#
# Preferences, backups, the journal, and the lock live outside the plugin cache,
# in the Oh No Harness data directory resolved by scripts/oh-no-config.
# Proxy URL/token values are never stored or printed.
#
# Backup retention: each apply snapshots the 9 originals + prior preferences
# under <data-dir>/subagent-backups/<txn>/. The newest OH_NO_CONFIGURE_BACKUP_KEEP
# (default 10) snapshots are kept; older ones are pruned. Snapshots retain agent
# bodies but never credentials.
#
# Exit codes: 0 ok | 2 usage/no-target | 3 source-checkout refusal
#             4 vocabulary/inventory/proxy error | 5 invalid agents/paths
#             6 write/rollback failure (rollback completed)
#             7 recovery required (rollback incomplete or invalid journal)
#             8 another run holds the lock (apply only)

# --- Physical layout (derive root from this script's real location) ----------
SELF="${BASH_SOURCE[0]}"

die() { printf 'configure-subagents: %s\n' "$1" >&2; exit "${2:-1}"; }
warn_recover() {
  # Fixed, sanitized warning. Never echoes journal contents, paths, or tokens.
  printf 'configure-subagents: an interrupted configuration could not be safely recovered; the recovery journal was retained. Re-run configure-subagents.\n' >&2
}
warn_superseded() {
  # Fixed, sanitized note (stderr only). A superseded-root journal was discarded;
  # never echoes journal contents, paths, or tokens.
  printf 'configure-subagents: discarded a superseded recovery journal from a previous plugin root.\n' >&2
}

# Destructive fault-injection seams (FAIL_OWNER/FAIL_JOURNAL/FAIL_AFTER/
# CRASH_AFTER/FAIL_PREFS/FAIL_RESTORE) are honoured ONLY when the test guard
# OH_NO_CONFIGURE_TEST_SEAMS=1 is set. Production runs ignore them entirely.
# LOCK_ATTEMPTS and BACKUP_KEEP are legitimate tunables and are not gated.
seam_on() {
  [ "${OH_NO_CONFIGURE_TEST_SEAMS:-}" = 1 ] || return 1
  local val; eval "val=\${$1:-}"
  [ -n "$val" ]
}
seam_val() {
  [ "${OH_NO_CONFIGURE_TEST_SEAMS:-}" = 1 ] || return 1
  local val; eval "val=\${$1:-}"
  [ -n "$val" ] || return 1
  printf '%s' "$val"
}

resolve_layout() {
  [ -L "$SELF" ] && die "refusing to run: script path is a symlink" 5
  local dir logical physical
  dir="$(dirname "$SELF")"
  logical="$(cd "$dir" 2>/dev/null && pwd)" || die "cannot resolve script directory" 5
  physical="$(cd -P "$dir" 2>/dev/null && pwd -P)" || die "cannot resolve script directory" 5
  [ "$logical" = "$physical" ] || die "refusing to run: script path traverses a symlink" 5
  SCRIPT_DIR="$physical"
  PLUGIN_ROOT="$(cd -P "${SCRIPT_DIR}/.." 2>/dev/null && pwd -P)" || die "cannot resolve plugin root" 5
  AGENTS_DIR="${PLUGIN_ROOT}/agents"
  [ -L "$AGENTS_DIR" ] && die "refusing to run: agents directory is a symlink" 5
}
resolve_layout

OH_NO_CONFIG="${SCRIPT_DIR}/oh-no-config"

# Canonical role inventory and order. Must mirror AGENTS in
# scripts/validate-plugin-files.py.
ROLES=(
  explore analyst planner plan-reviewer executor debugger verifier
  code-reviewer fusion-rescue-analyst
)

PRIMARY_NATIVE_MODELS="fable opus sonnet"
NATIVE_MODELS="fable opus sonnet haiku"
GPT_MODELS="gpt-5.6-sol gpt-5.6-terra"
DEFAULT_TOP_TIER_MODELS="fable opus"
EFFORTS="max xhigh high medium"
PREF_SCHEMA_VERSION=2
JOURNAL_SCHEMA_VERSION=1
# Retention must be a non-negative integer; malformed env input falls back to the
# default so pruning can never hit an arithmetic error or undefined retention.
BACKUP_KEEP="${OH_NO_CONFIGURE_BACKUP_KEEP:-10}"
case "$BACKUP_KEEP" in
  ''|*[!0-9]*) BACKUP_KEEP=10 ;;
esac

in_list() {
  local needle="$1" item
  for item in $2; do [ "$item" = "$needle" ] && return 0; done
  return 1
}

# --- Config directory (reuse scripts/oh-no-config resolution) ----------------
config_dir() {
  local path
  if [ -x "$OH_NO_CONFIG" ] && path="$("$OH_NO_CONFIG" path 2>/dev/null)"; then
    dirname "$path"
    return 0
  fi
  if [ -n "${OH_NO_CONFIG_DIR:-}" ]; then printf '%s\n' "$OH_NO_CONFIG_DIR"; return 0; fi
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s/oh-no-harness\n' "$XDG_CONFIG_HOME"; return 0; fi
  printf '%s/.config/oh-no-harness\n' "$HOME"
}

CFG_DIR="$(config_dir)"
PREF_FILE="${CFG_DIR}/subagent-models.conf"
BACKUP_ROOT="${CFG_DIR}/subagent-backups"
JOURNAL_FILE="${CFG_DIR}/subagent-journal.conf"
LOCK_DIR="${CFG_DIR}/subagent-lock.d"
LOCK_OWNER="${LOCK_DIR}/owner"

legacy_prefs_path() {
  local identity parent
  identity="$(basename "$CFG_DIR")"
  [ "$identity" = "oh-no-harness-oh-no-harness" ] || return 1
  parent="$(dirname "$CFG_DIR")"
  [ "$(basename "$parent")" = data ] || return 1
  [ "$(basename "$(dirname "$parent")")" = plugins ] || return 1
  printf '%s/oh-no-harness-inline/subagent-models.conf\n' "$parent"
}
LEGACY_PREF_FILE="$(legacy_prefs_path || true)"
LEGACY_PREF_HOLD="${LOCK_DIR}/legacy-prefs.hold"
LEGACY_PREF_SNAPSHOT_PATH="${LOCK_DIR}/legacy-prefs.snapshot"
LEGACY_PREF_SNAPSHOT=""
LEGACY_SNAPSHOT_STATE="absent"

is_source_checkout() {
  # True when the plugin root (or an ancestor) is a Git working tree: a
  # generator-owned checkout whose agents/*.md must never carry preferences.
  local d
  d="$(cd -P "$1" 2>/dev/null && pwd -P)" || return 1
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    [ -e "$d/.git" ] && return 0
    d="$(dirname "$d")"
  done
  [ -e "/.git" ] && return 0
  return 1
}

# --- Global per-config-dir lock (atomic mkdir; PID/host owner) ----------------
LOCK_HELD=0
HOSTID="$(hostname 2>/dev/null || uname -n 2>/dev/null || printf 'unknown')"

lock_is_stale() {
  # Stale when the owner marker is unreadable, or the same-host owner PID is dead.
  [ -f "$LOCK_OWNER" ] || return 0
  local opid ohost
  opid="$(LC_ALL=C awk -F= '/^pid=/{print $2; exit}' "$LOCK_OWNER" 2>/dev/null)"
  ohost="$(LC_ALL=C awk -F= '/^host=/{print $2; exit}' "$LOCK_OWNER" 2>/dev/null)"
  [ -n "$opid" ] || return 0
  [ "$ohost" = "$HOSTID" ] || return 1     # foreign host: cannot probe, treat live
  kill -0 "$opid" 2>/dev/null && return 1  # alive
  return 0                                  # same-host, dead -> stale
}

reclaim_stale() {
  # Serialize reclaimers with an atomic guard so two processes cannot both remove
  # the lock and then both remove a fresh lock a third process created. Re-check
  # staleness while holding the guard; only the same-host dead-owner case removes.
  local guard="${LOCK_DIR}.reclaim"
  mkdir "$guard" 2>/dev/null || return 1   # another reclaimer is active; let it win
  if lock_is_stale; then rm -rf "$LOCK_DIR" 2>/dev/null; fi
  rmdir "$guard" 2>/dev/null || rm -rf "$guard" 2>/dev/null
  return 0
}

acquire_lock() {
  # acquire_lock <wait|skip>. Returns 0 when held, 1 when it gave up.
  local mode="$1"
  local attempts="${OH_NO_CONFIGURE_LOCK_ATTEMPTS:-50}"
  local n=0 reclaims=0
  mkdir -p "$CFG_DIR" 2>/dev/null || return 1
  [ -L "$LOCK_DIR" ] && return 1
  while : ; do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      # Owner publication is mandatory: a missing owner marker makes every other
      # process read this live lock as stale. On failure, remove only the lock we
      # just created and fail before any write.
      if seam_on OH_NO_CONFIGURE_FAIL_OWNER || \
         ! printf 'pid=%s\nhost=%s\ntxn=%s\n' "$$" "$HOSTID" "${TXN_ID:-none}" >"$LOCK_OWNER" 2>/dev/null; then
        rm -rf "$LOCK_DIR" 2>/dev/null
        return 1
      fi
      LOCK_HELD=1
      return 0
    fi
    if lock_is_stale; then
      reclaims=$((reclaims + 1))
      [ "$reclaims" -gt 3 ] && return 1
      reclaim_stale        # serialized + re-checked; loop retries the mkdir
      continue
    fi
    [ "$mode" = skip ] && return 1
    n=$((n + 1))
    [ "$n" -ge "$attempts" ] && return 1
    sleep 0.1
  done
}

release_lock() {
  [ "$LOCK_HELD" = 1 ] || return 0
  rm -rf "$LOCK_DIR" 2>/dev/null
  LOCK_HELD=0
}

# --- Frontmatter parsing / validation ----------------------------------------
frontmatter_block() {
  # Print the leading YAML frontmatter body. Requires an explicit closing `---`
  # delimiter; an unterminated block is an error (non-zero, no output relied on).
  LC_ALL=C awk '
    NR==1 && $0!="---" { exit 1 }
    NR==1 { next }
    $0=="---" { closed=1; exit }
    { print }
    END { if (!closed) exit 1 }
  ' "$1"
}

agent_field() {
  frontmatter_block "$1" | LC_ALL=C awk -v k="^${2}:" '$0 ~ k { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }'
}

count_field() {
  frontmatter_block "$1" | LC_ALL=C grep -c "^${2}:"
}

validate_agent_file() {
  local role="$1" file="${2}"
  VALIDATE_ERR=""
  if [ -L "$file" ]; then VALIDATE_ERR="$role: target is a symlink"; return 1; fi
  if [ ! -f "$file" ]; then VALIDATE_ERR="$role: target agent file is missing ($file)"; return 1; fi
  if LC_ALL=C grep -q $'\r' "$file"; then VALIDATE_ERR="$role: CRLF line endings are unsupported"; return 1; fi
  if ! frontmatter_block "$file" >/dev/null 2>&1; then VALIDATE_ERR="$role: missing or unterminated YAML frontmatter"; return 1; fi
  local nc mc ec
  nc="$(count_field "$file" name)"
  mc="$(count_field "$file" model)"
  ec="$(count_field "$file" effort)"
  if [ "$nc" != "1" ]; then VALIDATE_ERR="$role: frontmatter must contain exactly one name (found $nc)"; return 1; fi
  if [ "$mc" != "1" ]; then VALIDATE_ERR="$role: frontmatter must contain exactly one model (found $mc)"; return 1; fi
  if [ "$ec" != "0" ] && [ "$ec" != "1" ]; then VALIDATE_ERR="$role: frontmatter must contain at most one effort (found $ec)"; return 1; fi
  local name
  name="$(agent_field "$file" name)"
  if [ "$name" != "$role" ]; then VALIDATE_ERR="$role: frontmatter name=$name does not match filename"; return 1; fi
  return 0
}

validate_target_layout() {
  VALIDATE_ERR=""
  if [ -L "$AGENTS_DIR" ]; then VALIDATE_ERR="agents directory is a symlink"; return 1; fi
  if [ ! -d "$AGENTS_DIR" ]; then VALIDATE_ERR="agents directory not found: $AGENTS_DIR"; return 1; fi
  local phys
  phys="$(cd -P "$AGENTS_DIR" 2>/dev/null && pwd -P)" || { VALIDATE_ERR="cannot resolve agents directory"; return 1; }
  if [ "$phys" != "${PLUGIN_ROOT}/agents" ]; then VALIDATE_ERR="agents directory is not a direct child of the plugin root"; return 1; fi
  return 0
}

validate_all_agents() {
  local role
  for role in "${ROLES[@]}"; do
    validate_agent_file "$role" "${AGENTS_DIR}/${role}.md" || return 1
  done
  return 0
}

# --- Staging transform (byte-exact; model replaced, effort after model) -------
render_agent() {
  # render_agent <file> <model> <effort>. Transforms only the model/effort lines
  # of the leading frontmatter and copies every other byte (body, final-newline
  # state, trailing bytes) verbatim.
  local file="$1" nm="$2" ne="$3" line fmbytes
  line="$(LC_ALL=C awk '
    NR==1 && $0!="---" { exit 1 }
    NR>1 && $0=="---" { print NR; found=1; exit }
    END { if (!found) exit 1 }
  ' "$file")" || return 1
  [ -n "$line" ] || return 1
  # Byte offset of the end of the frontmatter (first N lines, as they appear on
  # disk including or excluding a trailing newline). `head -n` never adds bytes.
  fmbytes="$(LC_ALL=C head -n "$line" "$file" | LC_ALL=C wc -c | tr -d ' ')"
  [ -n "$fmbytes" ] || return 1
  LC_ALL=C head -n "$line" "$file" | LC_ALL=C awk -v nm="$nm" -v ne="$ne" '
    NR==1 { print; next }
    /^model:/ { print "model: " nm; print "effort: " ne; next }
    /^effort:/ { next }
    { print }
  ' || return 1
  LC_ALL=C tail -c "+$((fmbytes + 1))" "$file" || return 1
}

# --- Preferences (schema-versioned, credential-free line format) -------------
prefs_path_ok() {
  [ -L "$PREF_FILE" ] && return 1
  [ -e "$PREF_FILE" ] && [ ! -f "$PREF_FILE" ] && return 1
  return 0
}

write_prefs_atomic() {
  # write_prefs_atomic <dest> <proxy> <secondary> <top-tier> <assignment...>
  local dest="$1"; shift
  local proxy="$1"; shift
  local secondary="$1"; shift
  local top_tier="$1"; shift
  mkdir -p "$CFG_DIR" || return 1
  local tmp
  tmp="$(mktemp "${CFG_DIR}/.subagent-models.conf.XXXXXX")" || return 1
  {
    printf '# oh-no-harness subagent model configuration\n'
    printf '# Managed by scripts/configure-subagents. No proxy credentials are stored.\n'
    printf 'schema_version=%s\n' "$PREF_SCHEMA_VERSION"
    printf 'proxy=%s\n' "$proxy"
    printf 'secondary_top_model=%s\n' "$secondary"
    printf 'top_tier_models=%s\n' "$top_tier"
    local a
    for a in "$@"; do printf 'assignment=%s\n' "$a"; done
  } >"$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

publish_prefs_copy_atomic() {
  # Preserve validated imported bytes so later coexistence is byte-identical.
  local dest="$1" source="$2" tmp
  [ ! -L "$(dirname "$source")" ] || return 1
  [ ! -L "$source" ] && [ -f "$source" ] || return 1
  mkdir -p "$CFG_DIR" || return 1
  tmp="$(mktemp "${CFG_DIR}/.subagent-models.conf.XXXXXX")" || return 1
  cp "$source" "$tmp" || { rm -f "$tmp"; return 1; }
  local PREF_FILE="$tmp"
  prefs_valid || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

prefs_present() { [ -f "$PREF_FILE" ]; }
prefs_proxy() { LC_ALL=C awk -F= '/^proxy=/{print $2; exit}' "$PREF_FILE"; }
prefs_secondary() { LC_ALL=C awk -F= '/^secondary_top_model=/{print $2; exit}' "$PREF_FILE"; }
prefs_top_tier() { LC_ALL=C awk -F= '/^top_tier_models=/{print $2; exit}' "$PREF_FILE"; }
prefs_assignments() { LC_ALL=C awk -F= '/^assignment=/{print $2}' "$PREF_FILE"; }
prefs_key_count() { LC_ALL=C grep -c "^${1}=" "$PREF_FILE"; }

prefs_valid() {
  [ -f "$PREF_FILE" ] || return 1
  # Reject every non-comment line that is not one complete known record before
  # semantic parsing. Tokens exclude '=' so suffixes cannot be silently ignored.
  LC_ALL=C awk '
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*#/ { next }
    /^schema_version=[^[:space:]=]+$/ { next }
    /^proxy=[^[:space:]=]+$/ { next }
    /^secondary_top_model=([^[:space:]=]+)?$/ { next }
    /^top_tier_models=[^[:space:]=]+([[:space:]]+[^[:space:]=]+)*$/ { next }
    /^assignment=[^[:space:],=]+,[^[:space:],=]+,[^[:space:],=]+$/ { next }
    { exit 1 }
  ' "$PREF_FILE" || return 1
  local sv proxy count secondary top_tier resolved_top_tier model native_found=0
  [ "$(prefs_key_count schema_version)" = 1 ] || return 1
  [ "$(prefs_key_count proxy)" = 1 ] || return 1
  [ "$(prefs_key_count secondary_top_model)" -le 1 ] || return 1
  [ "$(prefs_key_count top_tier_models)" -le 1 ] || return 1
  sv="$(LC_ALL=C awk -F= '/^schema_version=/{print $2; exit}' "$PREF_FILE")"
  [ "$sv" = "$PREF_SCHEMA_VERSION" ] || return 1
  proxy="$(prefs_proxy)"
  [ "$proxy" = "yes" ] || [ "$proxy" = "no" ] || return 1

  top_tier="$(prefs_top_tier)"
  if [ "$(prefs_key_count top_tier_models)" = 0 ]; then
    resolved_top_tier="$DEFAULT_TOP_TIER_MODELS"
  else
    [ -n "$top_tier" ] || return 1
    resolved_top_tier="$top_tier"
  fi
  local allowed_top_tier="$NATIVE_MODELS"
  [ "$proxy" = yes ] && allowed_top_tier="$allowed_top_tier $GPT_MODELS"
  for model in $resolved_top_tier; do
    in_list "$model" "$allowed_top_tier" || return 1
    in_list "$model" "$NATIVE_MODELS" && native_found=1
  done
  [ "$native_found" = 1 ] || return 1

  secondary="$(prefs_secondary)"
  if [ -n "$secondary" ]; then
    in_list "$secondary" "$NATIVE_MODELS" || return 1
    in_list "$secondary" "$resolved_top_tier" || return 1
  fi

  count="$(prefs_assignments | LC_ALL=C grep -c .)"
  [ "$count" = "${#ROLES[@]}" ] || return 1
  local i=0 line role effort allowed_models
  if [ "$proxy" = "yes" ]; then allowed_models="$PRIMARY_NATIVE_MODELS $GPT_MODELS"; else allowed_models="$PRIMARY_NATIVE_MODELS"; fi
  while IFS= read -r line; do
    role="${line%%,*}"
    model="${line#*,}"; model="${model%%,*}"
    effort="${line##*,}"
    [ "$role" = "${ROLES[$i]}" ] || return 1
    in_list "$model" "$allowed_models" || return 1
    in_list "$effort" "$EFFORTS" || return 1
    i=$((i + 1))
  done <<EOF
$(prefs_assignments)
EOF
  [ "$i" = "${#ROLES[@]}" ]
}

legacy_prefs_state() {
  [ -n "$LEGACY_PREF_FILE" ] || { printf 'absent\n'; return; }
  [ "$LEGACY_PREF_FILE" != "$PREF_FILE" ] || { printf 'absent\n'; return; }
  local legacy_dir
  legacy_dir="$(dirname "$LEGACY_PREF_FILE")"
  if [ -L "$legacy_dir" ] || [ -L "$LEGACY_PREF_FILE" ]; then printf 'invalid\n'; return; fi
  if [ ! -e "$LEGACY_PREF_FILE" ]; then printf 'absent\n'; return; fi
  if [ ! -f "$LEGACY_PREF_FILE" ]; then printf 'invalid\n'; return; fi
  local PREF_FILE="$LEGACY_PREF_FILE"
  if prefs_valid; then printf 'valid\n'; else printf 'invalid\n'; fi
}

cleanup_legacy_snapshot() {
  # These fixed basenames are owned only by the currently held exact lock. Never
  # scan or delete elsewhere; normal release/stale reclaim removes the lock tree.
  [ "$LOCK_HELD" = 1 ] || { LEGACY_PREF_SNAPSHOT=""; return 0; }
  rm -f "$LEGACY_PREF_HOLD" "$LEGACY_PREF_SNAPSHOT_PATH" 2>/dev/null || true
  LEGACY_PREF_SNAPSHOT=""
}

capture_legacy_prefs_snapshot() {
  # Capture the import source once while holding the canonical lock. The first
  # private hard link pins one regular-file inode across an atomic pathname
  # replacement; the second private file breaks that link so later source writes
  # cannot change validation, assignments, or canonical publication. Both fixed
  # paths are distinct from owner metadata and share the exact lock lifecycle.
  LEGACY_SNAPSHOT_STATE="absent"
  cleanup_legacy_snapshot
  [ -n "$LEGACY_PREF_FILE" ] || return 0
  [ "$LEGACY_PREF_FILE" != "$PREF_FILE" ] || return 0
  local legacy_dir
  legacy_dir="$(dirname "$LEGACY_PREF_FILE")"
  if [ -L "$legacy_dir" ] || [ -L "$LEGACY_PREF_FILE" ]; then LEGACY_SNAPSHOT_STATE="invalid"; return 0; fi
  if [ ! -e "$LEGACY_PREF_FILE" ]; then return 0; fi
  if [ ! -f "$LEGACY_PREF_FILE" ]; then LEGACY_SNAPSHOT_STATE="invalid"; return 0; fi

  if ! ln -P "$LEGACY_PREF_FILE" "$LEGACY_PREF_HOLD" 2>/dev/null; then
    cleanup_legacy_snapshot
    LEGACY_SNAPSHOT_STATE="invalid"
    return 0
  fi
  if [ -L "$legacy_dir" ] || [ -L "$LEGACY_PREF_HOLD" ] || [ ! -f "$LEGACY_PREF_HOLD" ]; then
    cleanup_legacy_snapshot
    LEGACY_SNAPSHOT_STATE="invalid"
    return 0
  fi

  if ! (umask 077; set -o noclobber; : >"$LEGACY_PREF_SNAPSHOT_PATH") 2>/dev/null || \
     [ -L "$LEGACY_PREF_SNAPSHOT_PATH" ] || [ ! -f "$LEGACY_PREF_SNAPSHOT_PATH" ]; then
    cleanup_legacy_snapshot
    LEGACY_SNAPSHOT_STATE="invalid"
    return 0
  fi
  if ! cp "$LEGACY_PREF_HOLD" "$LEGACY_PREF_SNAPSHOT_PATH" 2>/dev/null; then
    cleanup_legacy_snapshot
    LEGACY_SNAPSHOT_STATE="invalid"
    return 0
  fi
  rm -f "$LEGACY_PREF_HOLD" 2>/dev/null || {
    cleanup_legacy_snapshot
    LEGACY_SNAPSHOT_STATE="invalid"
    return 0
  }
  chmod 400 "$LEGACY_PREF_SNAPSHOT_PATH" 2>/dev/null || {
    cleanup_legacy_snapshot
    LEGACY_SNAPSHOT_STATE="invalid"
    return 0
  }
  local PREF_FILE="$LEGACY_PREF_SNAPSHOT_PATH"
  if prefs_valid; then
    LEGACY_PREF_SNAPSHOT="$LEGACY_PREF_SNAPSHOT_PATH"
    LEGACY_SNAPSHOT_STATE="valid"
  else
    cleanup_legacy_snapshot
    LEGACY_SNAPSHOT_STATE="invalid"
  fi
}

legacy_prefs_conflict() {
  [ -n "$LEGACY_PREF_FILE" ] || return 1
  [ "$LEGACY_PREF_FILE" != "$PREF_FILE" ] || return 1
  local legacy_dir
  legacy_dir="$(dirname "$LEGACY_PREF_FILE")"
  [ ! -L "$legacy_dir" ] || return 1
  [ ! -L "$LEGACY_PREF_FILE" ] && [ -f "$LEGACY_PREF_FILE" ] || return 1
  cmp -s "$PREF_FILE" "$LEGACY_PREF_FILE" && return 1
  local PREF_FILE="$LEGACY_PREF_FILE"
  prefs_valid
}

load_legacy_prefs() {
  local PREF_FILE="$1" line
  LEGACY_PROXY="$(prefs_proxy)"
  LEGACY_SECONDARY="$(prefs_secondary)"
  LEGACY_TOP_TIER="$(prefs_top_tier)"
  [ -n "$LEGACY_TOP_TIER" ] || LEGACY_TOP_TIER="$DEFAULT_TOP_TIER_MODELS"
  LEGACY_ASSIGNMENTS=()
  while IFS= read -r line; do [ -n "$line" ] && LEGACY_ASSIGNMENTS+=("$line"); done <<EOF
$(prefs_assignments)
EOF
}

# --- Journal (identity-bound; no destination paths / arbitrary filenames) -----
journal_present() { [ -f "$JOURNAL_FILE" ]; }

journal_path_ok() {
  [ -L "$JOURNAL_FILE" ] && return 1
  [ -e "$JOURNAL_FILE" ] && [ ! -f "$JOURNAL_FILE" ] && return 1
  return 0
}

jfield() { LC_ALL=C awk -F= -v k="$1" 'index($0, k "=")==1 { sub(/^[^=]*=/, ""); print; exit }' "$JOURNAL_FILE"; }

journal_schema_ok() {
  # Require exactly one each of the four known keys and no unknown, duplicate, or
  # blank lines. Values are validated by the caller.
  LC_ALL=C awk -F= -v expected="$JOURNAL_SCHEMA_VERSION" '
    { total++ }
    /^schema_version=/ { sv++; if ($2 != expected) bad=1; next }
    /^root=/           { r++;  next }
    /^txn=/            { t++;  next }
    /^prior_prefs=/    { p++;  next }
    { bad=1 }
    END {
      if (bad) exit 1
      if (sv!=1 || r!=1 || t!=1 || p!=1) exit 1
      if (total!=4) exit 1
    }
  ' "$JOURNAL_FILE"
}

safe_basename() {
  case "$1" in
    ""|.|..) return 1 ;;
    */*) return 1 ;;
  esac
  case "$1" in
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

write_journal_atomic() {
  # write_journal_atomic <txn> <present|absent>. Atomic (temp + rename); mandatory
  # before the first target rename. Records only identity + a safe basename.
  mkdir -p "$CFG_DIR" || return 1
  local tmp
  tmp="$(mktemp "${CFG_DIR}/.subagent-journal.XXXXXX")" || return 1
  {
    printf 'schema_version=%s\n' "$JOURNAL_SCHEMA_VERSION"
    printf 'root=%s\n' "$PLUGIN_ROOT"
    printf 'txn=%s\n' "$1"
    printf 'prior_prefs=%s\n' "$2"
  } >"$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$JOURNAL_FILE" || { rm -f "$tmp"; return 1; }
}

clear_journal() { rm -f "$JOURNAL_FILE"; }

contained_in() {
  # contained_in <child> <parent>: physical child path is inside physical parent.
  local c p
  p="$(cd -P "$2" 2>/dev/null && pwd -P)" || return 1
  c="$(cd -P "$(dirname "$1")" 2>/dev/null && pwd -P)/$(basename "$1")" || return 1
  case "$c" in "$p"/*) return 0 ;; *) return 1 ;; esac
}

recover_from_journal() {
  # 0 = nothing to do or recovered cleanly; 2 = invalid/failed, journal retained.
  journal_present || return 0
  [ -L "$JOURNAL_FILE" ] && { warn_recover; return 2; }
  [ -f "$JOURNAL_FILE" ] || { warn_recover; return 2; }
  journal_schema_ok || { warn_recover; return 2; }
  local sv root txn prior
  sv="$(jfield schema_version)"
  root="$(jfield root)"
  txn="$(jfield txn)"
  prior="$(jfield prior_prefs)"
  [ "$sv" = "$JOURNAL_SCHEMA_VERSION" ] || { warn_recover; return 2; }
  # A structurally valid journal whose recorded root is not the current physical
  # plugin root is moot: it was written under a previous (e.g. pre-update) cache
  # root and can never apply here. Discard ONLY our own fixed config-dir journal
  # and proceed; never inspect, restore, delete, or write any journal-derived
  # foreign path. The durable preferences file is authoritative for convergence.
  if [ "$root" != "$PLUGIN_ROOT" ]; then
    if clear_journal; then warn_superseded; return 0; fi
    warn_recover; return 2
  fi
  [ "$prior" = present ] || [ "$prior" = absent ] || { warn_recover; return 2; }
  safe_basename "$txn" || { warn_recover; return 2; }
  local backup_dir="${BACKUP_ROOT}/${txn}"
  [ -L "$backup_dir" ] && { warn_recover; return 2; }
  [ -d "$backup_dir" ] || { warn_recover; return 2; }
  contained_in "$backup_dir" "$BACKUP_ROOT" || { warn_recover; return 2; }
  # Validate every backup file (no symlink, well-formed frontmatter, canonical
  # role name) before restoring anything.
  local role
  for role in "${ROLES[@]}"; do
    [ -L "${backup_dir}/${role}.md" ] && { warn_recover; return 2; }
    validate_agent_file "$role" "${backup_dir}/${role}.md" || { warn_recover; return 2; }
  done
  validate_target_layout || { warn_recover; return 2; }
  local ok=1 tmp src dst
  for role in "${ROLES[@]}"; do
    src="${backup_dir}/${role}.md"; dst="${AGENTS_DIR}/${role}.md"
    tmp="$(mktemp "${AGENTS_DIR}/.recover.XXXXXX" 2>/dev/null)" || { ok=0; break; }
    if cp "$src" "$tmp" 2>/dev/null && mv "$tmp" "$dst" 2>/dev/null; then :; else rm -f "$tmp" 2>/dev/null; ok=0; break; fi
  done
  if [ "$ok" = 1 ]; then
    if [ "$prior" = present ]; then
      if [ -f "${backup_dir}/prefs.prior" ] && [ ! -L "${backup_dir}/prefs.prior" ]; then
        tmp="$(mktemp "${CFG_DIR}/.prefs.recover.XXXXXX" 2>/dev/null)" || ok=0
        if [ "$ok" = 1 ]; then
          if cp "${backup_dir}/prefs.prior" "$tmp" 2>/dev/null && mv "$tmp" "$PREF_FILE" 2>/dev/null; then :; else rm -f "$tmp" 2>/dev/null; ok=0; fi
        fi
      else
        ok=0
      fi
    elif [ "$prior" = absent ]; then
      rm -f "$PREF_FILE" 2>/dev/null || ok=0
    fi
  fi
  if [ "$ok" = 1 ]; then
    clear_journal || { warn_recover; return 2; }
    return 0
  fi
  warn_recover
  return 2
}

# --- Runtime state comparison ------------------------------------------------
runtime_matches_prefs() {
  local i=0 line role model effort file cm ce
  while IFS= read -r line; do
    role="${line%%,*}"
    model="${line#*,}"; model="${model%%,*}"
    effort="${line##*,}"
    file="${AGENTS_DIR}/${role}.md"
    validate_agent_file "$role" "$file" || return 2
    cm="$(agent_field "$file" model)"
    ce="$(agent_field "$file" effort)"
    [ "$cm" = "$model" ] && [ "$ce" = "$effort" ] || return 1
    i=$((i + 1))
  done <<EOF
$(prefs_assignments)
EOF
  return 0
}

# --- Transaction (lock-serialized; per-file atomic; recoverable) -------------
TXN_ID=""
TXN_BACKUP_DIR=""
TXN_PRIOR_PREFS="absent"
TXN_BACKUP_RESULT=""
PREF_IMPORT_SOURCE=""
COMMITTED_ROLES=()

restore_all() {
  # Restore all 9 agents + prior preference state. Sets RESTORE_OK=1/0.
  RESTORE_OK=1
  local role src dst tmp
  for role in "${ROLES[@]}"; do
    src="${TXN_BACKUP_DIR}/${role}.md"
    dst="${AGENTS_DIR}/${role}.md"
    if [ ! -f "$src" ]; then RESTORE_OK=0; continue; fi
    tmp="$(mktemp "${AGENTS_DIR}/.restore.XXXXXX" 2>/dev/null)" || { RESTORE_OK=0; continue; }
    if cp "$src" "$tmp" 2>/dev/null && mv "$tmp" "$dst" 2>/dev/null; then :; else rm -f "$tmp" 2>/dev/null; RESTORE_OK=0; fi
  done
  if [ "$TXN_PRIOR_PREFS" = present ]; then
    if [ -f "${TXN_BACKUP_DIR}/prefs.prior" ]; then
      tmp="$(mktemp "${CFG_DIR}/.prefs.restore.XXXXXX" 2>/dev/null)" || RESTORE_OK=0
      if [ "$RESTORE_OK" = 1 ]; then
        if cp "${TXN_BACKUP_DIR}/prefs.prior" "$tmp" 2>/dev/null && mv "$tmp" "$PREF_FILE" 2>/dev/null; then :; else rm -f "$tmp" 2>/dev/null; RESTORE_OK=0; fi
      fi
    else
      RESTORE_OK=0
    fi
  else
    rm -f "$PREF_FILE" 2>/dev/null || RESTORE_OK=0
  fi
  # Test seam: force a restore failure to exercise journal retention.
  seam_on OH_NO_CONFIGURE_FAIL_RESTORE && RESTORE_OK=0
}

fail_after_rollback() {
  # Restore, then either clear the journal (clean rollback) or retain it
  # (recovery required). Releases nothing; the EXIT trap releases the lock.
  local msg="$1"
  restore_all
  if [ "$RESTORE_OK" = 1 ]; then
    if clear_journal; then :; else die "$msg; journal could not be cleared, recovery required" 7; fi
    die "$msg" 6
  fi
  die "$msg; rollback incomplete, recovery required on next run" 7
}

on_signal() { trap - INT TERM; fail_after_rollback "interrupted by signal"; }

prune_backups() {
  [ -d "$BACKUP_ROOT" ] || return 0
  local d n=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    n=$((n + 1))
    [ "$n" -le "$BACKUP_KEEP" ] && continue
    case "$d" in "$BACKUP_ROOT"/*) ;; *) continue ;; esac
    [ -L "$d" ] && continue
    rm -rf "$d" 2>/dev/null || true
  done <<EOF
$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r)
EOF
}

apply_transaction() {
  # apply_transaction <proxy> <secondary> <top-tier> <assignment...>
  # (lock must already be held).
  local proxy="$1"; shift
  local secondary="$1"; shift
  local top_tier="$1"; shift
  local assignments=("$@")

  # 0) Path safety for the data-dir files we manage.
  prefs_path_ok || die "preferences path is a directory or symlink" 5
  journal_path_ok || die "journal path is a directory or symlink" 5

  # 1) Validate the physical layout and every target file (no writes yet).
  validate_target_layout || die "$VALIDATE_ERR" 5
  local a role
  for a in "${assignments[@]}"; do
    role="${a%%,*}"
    validate_agent_file "$role" "${AGENTS_DIR}/${role}.md" || die "$VALIDATE_ERR" 5
  done

  # 2) Confirm the target directory is writable before touching anything.
  local probe
  probe="$(mktemp "${AGENTS_DIR}/.probe.XXXXXX" 2>/dev/null)" || die "target agents directory is not writable: $AGENTS_DIR" 5
  rm -f "$probe"

  # 3) Stage all rendered results and re-validate them.
  local stage_dir model effort
  stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/oh-no-configure-stage.XXXXXX")" || die "could not create staging directory" 6
  for a in "${assignments[@]}"; do
    role="${a%%,*}"
    model="${a#*,}"; model="${model%%,*}"
    effort="${a##*,}"
    render_agent "${AGENTS_DIR}/${role}.md" "$model" "$effort" >"${stage_dir}/${role}.md" || { rm -rf "$stage_dir"; die "failed to stage $role" 6; }
    validate_agent_file "$role" "${stage_dir}/${role}.md" || { rm -rf "$stage_dir"; die "staged $role failed re-validation: $VALIDATE_ERR" 6; }
  done

  # 4) Back up originals + prior preferences into one snapshot.
  TXN_ID="$(date +%Y%m%d%H%M%S)-$$"
  local backup_dir="${BACKUP_ROOT}/${TXN_ID}"
  mkdir -p "$backup_dir" || { rm -rf "$stage_dir"; die "could not create backup directory" 6; }
  for role in "${ROLES[@]}"; do
    cp "${AGENTS_DIR}/${role}.md" "${backup_dir}/${role}.md" || { rm -rf "$stage_dir"; die "could not back up $role" 6; }
  done
  if [ -f "$PREF_FILE" ]; then
    cp "$PREF_FILE" "${backup_dir}/prefs.prior" || { rm -rf "$stage_dir"; die "could not back up prior preferences" 6; }
    TXN_PRIOR_PREFS="present"
  else
    TXN_PRIOR_PREFS="absent"
  fi
  TXN_BACKUP_DIR="$backup_dir"
  COMMITTED_ROLES=()

  # 5) Journal is mandatory and atomic BEFORE the first target rename.
  if seam_on OH_NO_CONFIGURE_FAIL_JOURNAL || ! write_journal_atomic "$TXN_ID" "$TXN_PRIOR_PREFS"; then
    rm -rf "$stage_dir"
    die "could not record the recovery journal; no changes were made" 6
  fi
  trap on_signal INT TERM

  # 6) Commit each file atomically (same-dir temp + rename).
  local committed=0 tmp fail_after crash_after
  fail_after="$(seam_val OH_NO_CONFIGURE_FAIL_AFTER || true)"
  crash_after="$(seam_val OH_NO_CONFIGURE_CRASH_AFTER || true)"
  for a in "${assignments[@]}"; do
    role="${a%%,*}"
    tmp="$(mktemp "${AGENTS_DIR}/.${role}.md.XXXXXX" 2>/dev/null)" || { rm -rf "$stage_dir"; trap - INT TERM; fail_after_rollback "could not create temp file for $role"; }
    if ! cp "${stage_dir}/${role}.md" "$tmp" 2>/dev/null || ! mv "$tmp" "${AGENTS_DIR}/${role}.md" 2>/dev/null; then
      rm -f "$tmp"; rm -rf "$stage_dir"; trap - INT TERM; fail_after_rollback "could not write $role"
    fi
    COMMITTED_ROLES+=("$role")
    committed=$((committed + 1))
    if [ -n "$fail_after" ] && [ "$committed" -ge "$fail_after" ]; then
      rm -rf "$stage_dir"; trap - INT TERM; fail_after_rollback "injected mid-commit failure after $committed file(s)"
    fi
    if [ -n "$crash_after" ] && [ "$committed" -ge "$crash_after" ]; then
      kill -9 $$   # hard crash: no trap; journal + partial writes + lock remain
    fi
  done
  trap - INT TERM
  rm -rf "$stage_dir"

  # 7) Publish preferences BEFORE clearing the journal (part of the transaction).
  if seam_on OH_NO_CONFIGURE_FAIL_PREFS; then
    fail_after_rollback "runtime agents committed but preferences could not be published"
  elif [ -n "$PREF_IMPORT_SOURCE" ]; then
    publish_prefs_copy_atomic "$PREF_FILE" "$PREF_IMPORT_SOURCE" || \
      fail_after_rollback "runtime agents committed but preferences could not be published"
  elif ! write_prefs_atomic "$PREF_FILE" "$proxy" "$secondary" "$top_tier" "${assignments[@]}"; then
    fail_after_rollback "runtime agents committed but preferences could not be published"
  fi

  # 8) Clear the journal only after both runtime + preferences are consistent.
  if ! clear_journal; then
    die "applied runtime agents and preferences but could not clear the journal, recovery required" 7
  fi

  prune_backups
  TXN_BACKUP_RESULT="$backup_dir"
}

# --- Argument parsing for apply ----------------------------------------------
parse_assignments() {
  local proxy="$1"; shift
  local tokens=("$@")
  PARSED_ASSIGNMENTS=()
  [ "$proxy" = "yes" ] || [ "$proxy" = "no" ] || die "proxy answer must be yes or no (got '$proxy')" 4
  if [ "${#tokens[@]}" -ne "${#ROLES[@]}" ]; then
    die "expected exactly ${#ROLES[@]} role assignments, got ${#tokens[@]}" 4
  fi
  local allowed_models
  if [ "$proxy" = "yes" ]; then allowed_models="$PRIMARY_NATIVE_MODELS $GPT_MODELS"; else allowed_models="$PRIMARY_NATIVE_MODELS"; fi
  local i=0 token role rest model effort
  for token in "${tokens[@]}"; do
    case "$token" in *=*) ;; *) die "assignment '$token' must be role=model,effort" 4 ;; esac
    role="${token%%=*}"
    rest="${token#*=}"
    case "$rest" in *,*) ;; *) die "assignment '$token' must be role=model,effort" 4 ;; esac
    model="${rest%%,*}"
    effort="${rest##*,}"
    if [ "$role" != "${ROLES[$i]}" ]; then
      die "assignment ${i} must be for role '${ROLES[$i]}', got '$role' (roles must be complete, unique, and in canonical order)" 4
    fi
    in_list "$model" "$allowed_models" || die "model '$model' is not allowed for role '$role' (proxy=$proxy)" 4
    in_list "$effort" "$EFFORTS" || die "effort '$effort' is not one of: $EFFORTS" 4
    PARSED_ASSIGNMENTS+=("${role},${model},${effort}")
    i=$((i + 1))
  done
}

parse_diversity_preferences() {
  local proxy="$1" secondary="$2" top_tier="$3"
  local allowed_top_tier="$NATIVE_MODELS" model normalized="" native_found=0
  [ "$proxy" = yes ] && allowed_top_tier="$allowed_top_tier $GPT_MODELS"
  [ -n "$top_tier" ] || die "top-tier model list must not be empty" 4
  for model in $top_tier; do
    in_list "$model" "$allowed_top_tier" || die "top-tier model '$model' is not allowed (proxy=$proxy)" 4
    in_list "$model" "$NATIVE_MODELS" && native_found=1
    if [ -n "$normalized" ]; then normalized="$normalized $model"; else normalized="$model"; fi
  done
  [ -n "$normalized" ] || die "top-tier model list must not be empty" 4
  [ "$native_found" = 1 ] || die "top-tier model list must include a native entry; at least one of fable/opus/sonnet/haiku required" 4
  if [ -n "$secondary" ]; then
    in_list "$secondary" "$NATIVE_MODELS" || die "secondary top model '$secondary' must be one of: $NATIVE_MODELS" 4
    in_list "$secondary" "$normalized" || die "secondary top model '$secondary' must be included in the top-tier model list" 4
  fi
  PARSED_SECONDARY_TOP_MODEL="$secondary"
  PARSED_TOP_TIER_MODELS="$normalized"
}

# --- Subcommands -------------------------------------------------------------
cmd_check() {
  printf 'target: %s\n' "$AGENTS_DIR"
  printf 'preferences: %s\n' "$PREF_FILE"
  if journal_present; then printf 'STATUS: recovery-required\n'; return 0; fi
  if is_source_checkout "$PLUGIN_ROOT"; then printf 'STATUS: source-checkout\n'; return 0; fi
  if ! validate_target_layout; then printf 'STATUS: invalid-agents\n'; return 0; fi
  if ! validate_all_agents; then printf 'STATUS: invalid-agents\n'; return 0; fi
  if ! prefs_present; then
    case "$(legacy_prefs_state)" in
      valid) printf 'STATUS: legacy-unmigrated\n' ;;
      invalid) printf 'STATUS: invalid-legacy-preferences\n' ;;
      *) printf 'STATUS: unconfigured\n' ;;
    esac
    return 0
  fi
  if ! prefs_valid; then printf 'STATUS: invalid-preferences\n'; return 0; fi
  if legacy_prefs_conflict; then printf 'STATUS: preference-conflict\n'; return 0; fi
  runtime_matches_prefs; local rc=$?
  case "$rc" in
    0) printf 'STATUS: matching\n' ;;
    1) printf 'STATUS: drifted\n' ;;
    *) printf 'STATUS: invalid-agents\n' ;;
  esac
  return 0
}

cmd_apply() {
  local proxy="" secondary="" top_tier="$DEFAULT_TOP_TIER_MODELS" tokens=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --proxy) shift; proxy="${1:-}"; [ -n "$proxy" ] || die "--proxy requires yes or no" 4 ;;
      --proxy=*) proxy="${1#--proxy=}" ;;
      --secondary-top-model) shift; secondary="${1:-}"; [ -n "$secondary" ] || die "--secondary-top-model requires a native model" 4 ;;
      --secondary-top-model=*) secondary="${1#--secondary-top-model=}" ;;
      --top-tier-models) shift; top_tier="${1:-}"; [ -n "$top_tier" ] || die "--top-tier-models requires a space-separated model list" 4 ;;
      --top-tier-models=*) top_tier="${1#--top-tier-models=}" ;;
      -*) die "unknown apply option: $1" 2 ;;
      *) tokens+=("$1") ;;
    esac
    shift || true
  done
  [ -n "$proxy" ] || die "apply requires --proxy yes|no" 4

  is_source_checkout "$PLUGIN_ROOT" && die "refusing to apply inside a Git source checkout ($PLUGIN_ROOT); the checkout's agents are generator-owned" 3

  parse_assignments "$proxy" "${tokens[@]}"
  parse_diversity_preferences "$proxy" "$secondary" "$top_tier"

  acquire_lock wait || die "another configure-subagents run holds the lock; try again shortly" 8
  trap 'release_lock' EXIT

  recover_from_journal || die "an interrupted configuration must be recovered first; re-run after resolving it" 7

  apply_transaction "$proxy" "$PARSED_SECONDARY_TOP_MODEL" "$PARSED_TOP_TIER_MODELS" "${PARSED_ASSIGNMENTS[@]}"
  release_lock
  trap - EXIT
  printf 'configured %s agent(s) under %s\n' "${#ROLES[@]}" "$AGENTS_DIR"
  printf 'backup: %s\n' "$TXN_BACKUP_RESULT"
  printf 'start a new Claude Code session or run /clear for the change to take effect.\n'
  printf 'STATUS: applied\n'
}

cmd_reapply() {
  local quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --quiet) quiet=1 ;;
      -*) die "unknown reapply option: $1" 2 ;;
      *) die "reapply takes no positional arguments" 2 ;;
    esac
    shift || true
  done

  # Skip safely (no writes) when another run holds the lock.
  acquire_lock skip || { [ "$quiet" = 1 ] && exit 0; die "another configure-subagents run holds the lock" 8; }
  trap 'cleanup_legacy_snapshot; release_lock' EXIT

  if ! recover_from_journal; then
    cleanup_legacy_snapshot; release_lock; trap - EXIT
    exit 7   # invalid journal retained; warn already emitted to stderr
  fi

  # With no canonical preferences, a valid legacy source is imported through the
  # same transaction as runtime convergence. Otherwise this remains a silent no-op.
  local import_legacy=0 legacy_state=""
  if ! prefs_present; then
    capture_legacy_prefs_snapshot
    legacy_state="$LEGACY_SNAPSHOT_STATE"
    case "$legacy_state" in
      valid) import_legacy=1 ;;
      invalid)
        cleanup_legacy_snapshot; release_lock; trap - EXIT
        printf 'configure-subagents: legacy subagent preferences are invalid or unsafe; reapply skipped.\n' >&2
        exit 4
        ;;
      *) cleanup_legacy_snapshot; release_lock; trap - EXIT; exit 0 ;;
    esac
  fi
  # Source checkout: silent skip (no stdout, no failure) so local development
  # never sees a spurious reapply warning.
  if is_source_checkout "$PLUGIN_ROOT"; then
    cleanup_legacy_snapshot; release_lock; trap - EXIT
    [ "$quiet" = 1 ] || printf 'configure-subagents: target is a Git checkout; skipping reapply.\n' >&2
    exit 0
  fi
  # Invalid stored preferences / installed layout / runtime files: these are real
  # failures. Report a fixed, value-free diagnostic on stderr only and exit
  # non-zero so the SessionStart hook takes its failure branch instead of
  # mistaking non-empty stdout for a successful repair.
  if [ "$import_legacy" = 0 ] && ! prefs_valid; then
    cleanup_legacy_snapshot; release_lock; trap - EXIT
    printf 'configure-subagents: stored subagent preferences are invalid; reapply skipped.\n' >&2
    exit 4
  fi
  if [ "$import_legacy" = 0 ] && legacy_prefs_conflict; then
    cleanup_legacy_snapshot; release_lock; trap - EXIT
    printf 'configure-subagents: canonical and legacy subagent preferences conflict; reapply skipped.\n' >&2
    exit 4
  fi
  if ! validate_target_layout; then
    cleanup_legacy_snapshot; release_lock; trap - EXIT
    printf 'configure-subagents: installed subagent layout is invalid; reapply skipped.\n' >&2
    exit 5
  fi

  if [ "$import_legacy" = 0 ]; then
    runtime_matches_prefs; local rc=$?
    if [ "$rc" = 0 ]; then cleanup_legacy_snapshot; release_lock; trap - EXIT; exit 0; fi   # matching: no-op
    if [ "$rc" != 1 ]; then
      cleanup_legacy_snapshot; release_lock; trap - EXIT
      printf 'configure-subagents: installed subagent files are invalid; reapply skipped.\n' >&2
      exit 5
    fi
  fi

  local proxy secondary top_tier assignments=() line
  if [ "$import_legacy" = 1 ]; then
    load_legacy_prefs "$LEGACY_PREF_SNAPSHOT"
    PREF_IMPORT_SOURCE="$LEGACY_PREF_SNAPSHOT"
    proxy="$LEGACY_PROXY"
    secondary="$LEGACY_SECONDARY"
    top_tier="$LEGACY_TOP_TIER"
    assignments=("${LEGACY_ASSIGNMENTS[@]}")
  else
    proxy="$(prefs_proxy)"
    secondary="$(prefs_secondary)"
    top_tier="$(prefs_top_tier)"
    [ -n "$top_tier" ] || top_tier="$DEFAULT_TOP_TIER_MODELS"
    while IFS= read -r line; do [ -n "$line" ] && assignments+=("$line"); done <<EOF
$(prefs_assignments)
EOF
  fi
  apply_transaction "$proxy" "$secondary" "$top_tier" "${assignments[@]}" >/dev/null
  cleanup_legacy_snapshot
  release_lock
  trap - EXIT
  printf 'reapplied subagent configuration after runtime drift; start a new Claude Code session or run /clear.\n'
}

usage() {
  cat <<'USAGE'
Usage:
  configure-subagents check
  configure-subagents apply --proxy <yes|no> [--secondary-top-model <native-model>]
    [--top-tier-models "<space-separated-models>"] <role=model,effort> ...(9 in order)
  configure-subagents reapply --quiet

Configures the installed Claude Code subagents' model and reasoning effort.
Targets the agents/ directory of the physical plugin root that contains this
script; refuses to apply inside a Git checkout. Preferences/backups/journal/lock
live in the Oh No Harness data dir; no proxy credentials are stored.
USAGE
}

main() {
  local sub="${1:-check}"
  shift || true
  case "$sub" in
    check)   cmd_check "$@" ;;
    apply)   cmd_apply "$@" ;;
    reapply) cmd_reapply "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; die "unknown subcommand: $sub (use check | apply | reapply)" 2 ;;
  esac
}

main "$@"
