#!/bin/sh
set -eu

MARKER="oh-no-harness-generated-codex-agent"
VERSION_MARKER="oh-no-harness-installed-plugin-version"

scope="user"
dry_run="false"
force="false"
remove="false"
ensure="false"
quiet="false"

usage() {
  cat <<'USAGE'
Usage: scripts/install-codex-agents [--scope user|project] [--dry-run] [--force] [--ensure] [--quiet] [--remove]

Installs optional Oh No Harness Codex custom-agent templates.

Options:
  --scope user|project  Install under the Codex user agent directory, or under
                        the current Git repo's .codex/agents directory.
                        User scope targets $CODEX_HOME/agents when CODEX_HOME
                        is set, otherwise $HOME/.codex/agents.
                        Default: user.
  --dry-run             Print planned changes without writing files.
  --force               Overwrite existing generated files during install.
  --ensure              Install missing generated files and refresh stale
                        generated files. Never overwrite unmarked files.
                        Also removes generated Oh No Harness agent files that
                        no longer have a bundled template.
  --quiet               Emit nothing on successful install, refresh, or no-op.
  --remove              Remove installed Oh No Harness agent files.
                        Removal only deletes files with the generated marker,
                        including generated files retired by this plugin.
  -h, --help            Show this help.
USAGE
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --scope)
      [ "$#" -ge 2 ] || die "--scope requires project or user"
      scope="$2"
      shift 2
      ;;
    --scope=*)
      scope="${1#--scope=}"
      shift
      ;;
    --dry-run)
      dry_run="true"
      shift
      ;;
    --force)
      force="true"
      shift
      ;;
    --ensure)
      ensure="true"
      shift
      ;;
    --quiet)
      quiet="true"
      shift
      ;;
    --remove)
      remove="true"
      shift
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

case "$scope" in
  project|user)
    ;;
  *)
    die "--scope must be project or user"
    ;;
esac

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
plugin_dir=$(dirname "$script_dir")
template_dir="${plugin_dir}/docs/platforms/codex-agents"
manifest_path="${plugin_dir}/.codex-plugin/plugin.json"

[ -d "$template_dir" ] || die "template directory not found: $template_dir"

plugin_version=$(
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest_path" 2>/dev/null | head -n 1
)
[ -n "$plugin_version" ] || plugin_version="unknown"

project_root() {
  git_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "project scope requires running inside a Git worktree"
  printf '%s\n' "$git_root"
}

target_dir() {
  case "$scope" in
    project)
      printf '%s/.codex/agents\n' "$(project_root)"
      ;;
    user)
      if [ -n "${CODEX_HOME:-}" ]; then
        printf '%s/agents\n' "$CODEX_HOME"
      else
        [ -n "${HOME:-}" ] || die "HOME is not set"
        printf '%s/.codex/agents\n' "$HOME"
      fi
      ;;
  esac
}

has_marker() {
  grep -F -q "$MARKER" "$1"
}

say() {
  [ "$quiet" = "true" ] || printf '%s\n' "$*"
}

render_agent() {
  src="$1"
  printf '# %s: %s\n' "$VERSION_MARKER" "$plugin_version"
  cat "$src"
}

install_one() {
  src="$1"
  dest="${target}/$(basename "$src")"

  has_marker "$src" || die "template missing marker: $src"
  rendered=$(mktemp "${TMPDIR:-/tmp}/oh-no-codex-agent.XXXXXX") || return 1
  render_agent "$src" >"$rendered"

  if [ -e "$dest" ] || [ -L "$dest" ]; then
    if [ -L "$dest" ] || [ ! -f "$dest" ]; then
      printf 'skip non-regular existing: %s (not overwritten)\n' "$dest" >&2
      rm -f "$rendered"
      return 1
    fi

    if cmp -s "$rendered" "$dest"; then
      say "unchanged: $dest"
      rm -f "$rendered"
      return 0
    fi

    if ! has_marker "$dest"; then
      printf 'skip unmarked existing: %s (not overwritten)\n' "$dest" >&2
      rm -f "$rendered"
      return 1
    fi

    if [ "$force" != "true" ] && [ "$ensure" != "true" ]; then
      printf 'skip existing generated: %s (use --force or --ensure to overwrite)\n' "$dest" >&2
      rm -f "$rendered"
      return 1
    fi
  fi

  if [ "$dry_run" = "true" ]; then
    if [ -f "$dest" ]; then
      say "would overwrite: $dest"
    else
      say "would install: $dest"
    fi
    rm -f "$rendered"
    return 0
  fi

  mkdir -p "$target"
  mv "$rendered" "$dest"
  if [ -f "$dest" ]; then
    say "installed: $dest (plugin version $plugin_version)"
  else
    rm -f "$rendered"
    return 1
  fi
}

remove_one() {
  src="$1"
  dest="${target}/$(basename "$src")"

  if [ ! -f "$dest" ]; then
    say "absent: $dest"
    return 0
  fi

  if ! has_marker "$dest"; then
    printf 'skip unmarked: %s\n' "$dest" >&2
    return 1
  fi

  if [ "$dry_run" = "true" ]; then
    say "would remove: $dest"
    return 0
  fi

  rm "$dest"
  say "removed: $dest"
}

is_current_template() {
  candidate="$1"
  for src in "$template_dir"/*.toml; do
    [ -f "$src" ] || continue
    [ "$(basename "$src")" = "$candidate" ] && return 0
  done
  return 1
}

remove_retired_generated() {
  [ -d "$target" ] || return 0

  for dest in "$target"/oh-no-*.toml; do
    [ -e "$dest" ] || continue
    [ -L "$dest" ] && continue
    [ -f "$dest" ] || continue
    base=$(basename "$dest")
    is_current_template "$base" && continue
    has_marker "$dest" || continue

    if [ "$dry_run" = "true" ]; then
      say "would remove retired: $dest"
      continue
    fi

    rm "$dest"
    say "removed retired: $dest"
  done
}

target=$(target_dir)
status=0

if [ "$remove" = "true" ]; then
  say "removing Oh No Harness Codex agents from $target"
else
  say "installing Oh No Harness Codex agents to $target"
fi

found="false"
for src in "$template_dir"/*.toml; do
  [ -f "$src" ] || continue
  found="true"
  if [ "$remove" = "true" ]; then
    remove_one "$src" || status=1
  else
    install_one "$src" || status=1
  fi
done

[ "$found" = "true" ] || die "no TOML templates found in $template_dir"

remove_retired_generated || status=1

exit "$status"
