#!/usr/bin/env bash
# UserPromptSubmit hook that injects Ralph subagent guidance for the active platform.
# Adapter markers loaded by this hook: CLAUDE_CODE_ONLY_RALPH_ADAPTER,
# CODEX_ONLY_RALPH_ADAPTER.

set -euo pipefail

ENV_PLUGIN_ROOT="${PLUGIN_ROOT:-}"
ENV_CLAUDE_PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OH_NO_PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

stdin_payload="$(cat || true)"
prompt_text=""
if command -v python3 >/dev/null 2>&1; then
  prompt_text="$(printf '%s' "$stdin_payload" | python3 -c 'import json, sys
raw = sys.stdin.read()
try:
    print(json.loads(raw).get("prompt", ""))
except Exception:
    pass
' 2>/dev/null || true)"
fi
if [ -z "$prompt_text" ]; then
  prompt_text="$(printf '%s' "$stdin_payload" | sed -n 's/.*"prompt"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
fi
if [ -z "$prompt_text" ]; then
  prompt_text="$stdin_payload"
fi
lowered_prompt="$(printf '%s' "$prompt_text" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
lowered_prompt="${lowered_prompt#"${lowered_prompt%%[![:space:]]*}"}"

is_ralph_prompt=0
case "$lowered_prompt" in
  "oh-no-harness:ralph"*|"use oh-no-harness:ralph"*|"run oh-no-harness:ralph"*|"execute oh-no-harness:ralph"*|"invoke oh-no-harness:ralph"*|"start oh-no-harness:ralph"*|"use ralph to"*|"use ralph on"*|"use ralph with"*|"run ralph"*|"please run ralph"*|"please use ralph"*|"could you run ralph"*|"can you run ralph"*|"could you use ralph"*|"can you use ralph"*|*"then run ralph"*|*"then use ralph"*|*"and run ralph"*|*"and use ralph"*|*"execute ralph"*|*"invoke ralph"*|*"start ralph"*|"ralph with parallel subagents"*|"/ralph"*|'$ralph'*|"ralph로 구현"|"ralph로 구현해"*|"ralph로 구현 해"*|"ralph로 진행"|"ralph로 진행해"*|"ralph로 진행 해"*|"ralph로 실행"|"ralph로 실행해"*|"ralph로 실행 해"*|"ralph 로 구현"|"ralph 로 구현해"*|"ralph 로 구현 해"*|"ralph 로 진행"|"ralph 로 진행해"*|"ralph 로 진행 해"*|"ralph 로 실행"|"ralph 로 실행해"*|"ralph 로 실행 해"*|"ralph 해줘"*|"랄프로 구현"|"랄프로 구현해"*|"랄프로 구현 해"*|"랄프로 진행"|"랄프로 진행해"*|"랄프로 진행 해"*|"랄프로 실행"|"랄프로 실행해"*|"랄프로 실행 해"*|"랄프 로 구현"|"랄프 로 구현해"*|"랄프 로 구현 해"*|"랄프 로 진행"|"랄프 로 진행해"*|"랄프 로 진행 해"*|"랄프 로 실행"|"랄프 로 실행해"*|"랄프 로 실행 해"*|"랄프 해줘"*)
    is_ralph_prompt=1
    ;;
  "what "*|"what's "*|"how "*|"explain "*|"compare "*|"review "*|"tell me about "*|"describe "*|"why "*)
    is_ralph_prompt=0
    ;;
esac

if [ "$is_ralph_prompt" -ne 1 ]; then
  exit 0
fi

platform="unknown"
platform_name="Unknown"
adapter_path=""

if [ -n "$ENV_PLUGIN_ROOT" ]; then
  platform="codex"
  platform_name="Codex"
  adapter_path="${OH_NO_PLUGIN_ROOT}/docs/platforms/codex-ralph.md"
elif [ -n "$ENV_CLAUDE_PLUGIN_ROOT" ] && [ -z "${COPILOT_CLI:-}" ]; then
  platform="claude"
  platform_name="Claude Code"
  adapter_path="${OH_NO_PLUGIN_ROOT}/docs/platforms/claude-code-ralph.md"
fi

if [ "$platform" = "unknown" ]; then
  exit 0
fi

codex_agent_preflight=""
if [ "$platform" = "codex" ]; then
  installer_path="${OH_NO_PLUGIN_ROOT}/scripts/install-codex-agents"
  if [ -x "$installer_path" ]; then
    if "$installer_path" --scope user --ensure --quiet >/dev/null 2>&1; then
      codex_agent_preflight="Codex custom-agent preflight: ready via quiet ensure of user-scope oh-no-* agents before Ralph dispatch."
    else
      codex_agent_preflight="Codex custom-agent preflight: failed; oh-no-* custom-agent dispatch remains required when the host recognizes agent_type. Use generic prompt-embedded dispatch only after confirmed custom-agent unavailability, and record this fallback reason. Run scripts/install-codex-agents --scope user --ensure for details."
    fi
  else
    codex_agent_preflight="Codex custom-agent preflight: installer unavailable at ${installer_path}; oh-no-* custom-agent dispatch remains required when the host recognizes agent_type. Use generic prompt-embedded dispatch only after confirmed custom-agent unavailability, and record this fallback reason."
  fi
fi

if [ "$platform" = "codex" ]; then
  platform_guidance="CODEX_ONLY_RALPH_ADAPTER

Use Codex spawn_agent for eligible isolated Ralph roles. Prefer agent_type \"oh-no-<role>\"; use generic prompt-embedded fallback only after confirmed custom-agent unavailability and record the fallback reason. Do not use fork_context with custom agent_type.

Every registered custom-agent dispatch packet should name Role, Story/task, Scope, Do not touch, Expected output, Verification responsibility, Lifecycle, and Coordination. Generic fallback must also include:
Agent prompt source: docs/agent-core/<role>.md
Agent prompt content:
<matching docs/agent-core/<role>.md prompt content>

Batch independent agents before wait_agent. A timeout or empty wait is not a final result. Capture final output before close_agent; never close a running or pending subagent merely because it is slow.

Parallel trigger: approved-plan-handoff is authorization for eligible isolated roles from an approved ralplan handoff; it is not a command to dispatch roles whose output would not change a decision."
else
  platform_guidance="CLAUDE_CODE_ONLY_RALPH_ADAPTER

Use Claude Code Task, Agent, Workflow agent(), or subagent mechanisms with plugin-scoped agents from agents/. Prefer Role: oh-no-harness:<agent>; when a manual mention is needed, use @agent-oh-no-harness:<agent>.

Every dispatch packet should name Role, Story/task, Scope, Do not touch, Expected output, Verification responsibility, Background, Lifecycle, and Coordination.

Batch independent background agents before waiting. Capture final output and changed-file set, then close or cleanup the completed subagent when the host exposes that mechanism.

Parallel trigger: approved-plan-handoff is authorization for eligible isolated roles from an approved ralplan handoff; it is not a command to dispatch roles whose output would not change a decision."
fi

context="<OH_NO_RALPH_PLATFORM_ADAPTER>
Platform: ${platform_name}

Ralph is being invoked. Read and apply the shared Ralph subagent policy and the
active platform adapter source files below. This hook is a compact reminder; the
files remain the source of truth. Do not apply another platform's invocation
syntax.

${codex_agent_preflight}

Shared policy source: docs/shared/ralph-subagent-policy.md
Shared policy reminders:
- Dispatch only when the selected mode/policy allows it, the role is isolated,
  and the result can change implementation, review, verification, or ship/block
  decisions.
- Create the full eligible independent batch before waiting.
- Keep role boundaries inline with a recorded fallback reason when dispatch is
  unavailable, unsafe to isolate, or not decision-changing.
- Implementation agents must not revert or overwrite work outside their scope.

Active platform adapter source: ${adapter_path#${OH_NO_PLUGIN_ROOT}/}

${platform_guidance}
</OH_NO_RALPH_PLATFORM_ADAPTER>"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context_escaped="$(escape_for_json "$context")"

printf '{\n'
printf '  "hookSpecificOutput": {\n'
printf '    "hookEventName": "UserPromptSubmit",\n'
printf '    "additionalContext": "%s"\n' "$context_escaped"
printf '  }\n'
printf '}\n'
