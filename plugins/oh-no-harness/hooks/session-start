#!/usr/bin/env bash
# SessionStart hook for oh-no-harness.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_CODEX_PLUGIN_ROOT="${PLUGIN_ROOT:-}"
OH_NO_PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DEFAULT_TOP_TIER_MODELS="fable opus"
DIVERSITY_PREF_SCHEMA_VERSION=2
DIVERSITY_PRIMARY_NATIVE_MODELS="fable opus sonnet"
DIVERSITY_NATIVE_MODELS="fable opus sonnet haiku"
DIVERSITY_GPT_MODELS="gpt-5.6-sol gpt-5.6-terra"
DIVERSITY_EFFORTS="max xhigh high medium"
DIVERSITY_ROLES=(
  explore analyst planner plan-reviewer executor debugger verifier
  code-reviewer fusion-rescue-analyst
)

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

model_in_list() {
  local needle="$1" item
  for item in $2; do [ "$item" = "$needle" ] && return 0; done
  return 1
}

prefs_key_count() {
  LC_ALL=C awk -F= -v key="$2" '$1 == key { count++ } END { print count + 0 }' "$1"
}

prefs_value() {
  LC_ALL=C awk -F= -v key="$2" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$1"
}

load_model_diversity_prefs() {
  local file="$1" schema proxy top_tier secondary allowed_top_tier allowed_primary
  local model normalized="" native_found=0 count i=0 line role rest effort
  local plan_reviewer="host-default" code_reviewer="host-default"
  local debugger="host-default" fusion_rescue_analyst="host-default"

  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  LC_ALL=C awk '
    /^#/ { next }
    /^(schema_version|proxy|secondary_top_model|top_tier_models|assignment)=/ { next }
    { exit 1 }
  ' "$file" || return 1
  [ "$(prefs_key_count "$file" schema_version)" = 1 ] || return 1
  [ "$(prefs_key_count "$file" proxy)" = 1 ] || return 1
  [ "$(prefs_key_count "$file" secondary_top_model)" -le 1 ] || return 1
  [ "$(prefs_key_count "$file" top_tier_models)" -le 1 ] || return 1
  schema="$(prefs_value "$file" schema_version)"
  [ "$schema" = "$DIVERSITY_PREF_SCHEMA_VERSION" ] || return 1
  proxy="$(prefs_value "$file" proxy)"
  [ "$proxy" = yes ] || [ "$proxy" = no ] || return 1

  if [ "$(prefs_key_count "$file" top_tier_models)" = 1 ]; then
    top_tier="$(prefs_value "$file" top_tier_models)"
    [ -n "$top_tier" ] || return 1
  else
    top_tier="$DEFAULT_TOP_TIER_MODELS"
  fi
  allowed_top_tier="$DIVERSITY_NATIVE_MODELS"
  [ "$proxy" = yes ] && allowed_top_tier="$allowed_top_tier $DIVERSITY_GPT_MODELS"
  for model in $top_tier; do
    model_in_list "$model" "$allowed_top_tier" || return 1
    model_in_list "$model" "$DIVERSITY_NATIVE_MODELS" && native_found=1
    if [ -n "$normalized" ]; then normalized="$normalized $model"; else normalized="$model"; fi
  done
  [ -n "$normalized" ] || return 1
  [ "$native_found" = 1 ] || return 1

  count="$(prefs_key_count "$file" assignment)"
  [ "$count" = 9 ] || return 1
  allowed_primary="$DIVERSITY_PRIMARY_NATIVE_MODELS"
  [ "$proxy" = yes ] && allowed_primary="$allowed_primary $DIVERSITY_GPT_MODELS"
  while IFS= read -r line; do
    role="${line%%,*}"
    rest="${line#*,}"
    model="${rest%%,*}"
    effort="${rest#*,}"
    [ "$rest" != "$line" ] || return 1
    [ "$effort" = "${rest##*,}" ] || return 1
    [ "$i" -lt "${#DIVERSITY_ROLES[@]}" ] || return 1
    [ "$role" = "${DIVERSITY_ROLES[$i]}" ] || return 1
    model_in_list "$model" "$allowed_primary" || return 1
    model_in_list "$effort" "$DIVERSITY_EFFORTS" || return 1
    case "$role" in
      plan-reviewer) plan_reviewer="$model" ;;
      code-reviewer) code_reviewer="$model" ;;
      debugger) debugger="$model" ;;
      fusion-rescue-analyst) fusion_rescue_analyst="$model" ;;
    esac
    i=$((i + 1))
  done <<EOF
$(LC_ALL=C awk -F= '$1 == "assignment" { sub(/^[^=]*=/, ""); print }' "$file")
EOF
  [ "$i" = 9 ] || return 1

  secondary="$(prefs_value "$file" secondary_top_model)"
  if [ -n "$secondary" ] && { ! model_in_list "$secondary" "$DIVERSITY_NATIVE_MODELS" || ! model_in_list "$secondary" "$normalized"; }; then
    secondary=""
  fi

  DIVERSITY_TOP_TIER_MODELS="$normalized"
  DIVERSITY_SECONDARY_TOP_MODEL="$secondary"
  DIVERSITY_PLAN_REVIEWER_PRIMARY="$plan_reviewer"
  DIVERSITY_CODE_REVIEWER_PRIMARY="$code_reviewer"
  DIVERSITY_DEBUGGER_PRIMARY="$debugger"
  DIVERSITY_FUSION_RESCUE_ANALYST_PRIMARY="$fusion_rescue_analyst"
  return 0
}

model_diversity_policy() {
  local config_path prefs_file
  DIVERSITY_TOP_TIER_MODELS="$DEFAULT_TOP_TIER_MODELS"
  DIVERSITY_SECONDARY_TOP_MODEL=""
  DIVERSITY_PLAN_REVIEWER_PRIMARY="host-default"
  DIVERSITY_CODE_REVIEWER_PRIMARY="host-default"
  DIVERSITY_DEBUGGER_PRIMARY="host-default"
  DIVERSITY_FUSION_RESCUE_ANALYST_PRIMARY="host-default"

  if [ -x "${OH_NO_PLUGIN_ROOT}/scripts/oh-no-config" ] && \
     config_path="$("${OH_NO_PLUGIN_ROOT}/scripts/oh-no-config" path 2>/dev/null)" && \
     [ -n "$config_path" ]; then
    prefs_file="$(dirname "$config_path")/subagent-models.conf"
    if load_model_diversity_prefs "$prefs_file"; then :; fi
  fi

  if [ -n "$DIVERSITY_SECONDARY_TOP_MODEL" ]; then
    printf '<OH_NO_MODEL_DIVERSITY>\n'
    printf 'top_tier_models=%s\n' "$DIVERSITY_TOP_TIER_MODELS"
    printf 'secondary_top_model=%s\n' "$DIVERSITY_SECONDARY_TOP_MODEL"
  else
    printf '<OH_NO_MODEL_DIVERSITY>\n'
    printf 'top_tier_models=%s\n' "$DIVERSITY_TOP_TIER_MODELS"
  fi
  printf 'effective_primaries=plan-reviewer:%s code-reviewer:%s debugger:%s fusion-rescue-analyst:%s\n' \
    "$DIVERSITY_PLAN_REVIEWER_PRIMARY" "$DIVERSITY_CODE_REVIEWER_PRIMARY" \
    "$DIVERSITY_DEBUGGER_PRIMARY" "$DIVERSITY_FUSION_RESCUE_ANALYST_PRIMARY"
  printf 'Pair rule: unoverridden dispatch uses the stored primary; the diversity leg uses an explicit NATIVE override with secondary_top_model; strict mode pauses when no valid secondary.\n'
  printf '</OH_NO_MODEL_DIVERSITY>'
}

# CLAUDE_PLUGIN_ROOT only launches the hook from hooks.json; PLUGIN_ROOT (captured
# as ENV_CODEX_PLUGIN_ROOT) selects the Codex branch. OH_NO_PLUGIN_ROOT is always
# self-derived from SCRIPT_DIR, so installer and config paths cannot go stale.
is_claude_code=false
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "$ENV_CODEX_PLUGIN_ROOT" ]; then
  is_claude_code=true
fi

bootstrap_policy='<OH_NO_BOOTSTRAP>
You have Oh No Harness installed. Use native skill loading to read the relevant Oh No Harness skill when it applies.

A workflow name used only as the subject of analysis, explanation, comparison, or critique is not an invocation trigger. Route from the requested deliverable: an analysis report versus a plan or execution artifact.

No-route lane: a request that does not create or change repository work products (code, tests, docs, configs) and does not claim their completion — research, conceptual or codebase questions, status reports, version-control or environment housekeeping over already-written changes — is answered directly without invoking a workflow skill.

Direct-edit lane: a trivial mutation may use a direct edit plus diff check only when ALL hold: one obvious file; the change is private, inert, non-consumed, non-operational prose/comment/formatting; the file is non-generated, and editing a generation source includes regeneration and validation in the same action; and the change is non-public-contract with no security or permission surface. Excluded surfaces are executable source, test, build, CI, hook, generated output, security, permission, public-contract, dependency or lockfile metadata, ignore or attribute files, schema or migration, and operational-command docs. If any condition is false or becomes false, route to ralph.

Orchestration default: main agents own .oh-no state/gates; STANDARD/THOROUGH repository mutations use executors, except recorded LIGHT-tiny or dispatch-unavailable inline fallback.

Child packet floor: caller sends a proportional self-contained English packet with purpose/outcome; target role; for repo mutation/review/verify, exact target/revision + result/revision binding; scope/permissions/non-goals; contract/acceptance; evidence/output; stop/escalation. Initial independent review/verify/debug withholds maker conclusions, expected verdicts, sibling output, preferred causes; disclose only later for audit/clarification.

Selected skill file is source of truth. Skill chaining remains explicit: if a skill presents Next Skill Handoff, ask before invoking the next workflow skill.
</OH_NO_BOOTSTRAP>'

auto_routing_policy=""
if [ "$is_claude_code" = true ] && "${OH_NO_PLUGIN_ROOT}/scripts/oh-no-config" is-enabled >/dev/null 2>&1; then
  auto_routing_policy='
<OH_NO_FORCED_ROUTING>
Forced routing is enabled for Oh No Harness. Select and invoke an applicable local skill with the Skill tool BEFORE responding, exploring, reading, editing, asking a clarifying question, or claiming completion. Use installed skill descriptions to choose the destination.

Instruction priority (highest first): (1) explicit instructions in CLAUDE.md, AGENTS.md, or the current user message; (2) Oh No Harness skills; (3) default behavior. If a user instruction conflicts with this block, follow the user.

The always-injected OH_NO_BOOTSTRAP no-route, direct-edit, and object boundaries are closed routing outcomes; do not re-derive them here.

Essential precedence: explicit end-to-end delegation beats inferred stage selection; active failure or root-cause investigation beats implementation; explicit test-first intent beats ordinary implementation; otherwise the most upstream incomplete prerequisite wins.

After invoking a skill, announce in one line before continuing: Using oh-no-harness:<skill> to <one-line purpose>.

If the selected skill proves inapplicable, say so briefly in one line and continue with the next best path. User instructions and repository constraints still take priority.
</OH_NO_FORCED_ROUTING>'
fi

rg_search_policy=""
if command -v rg >/dev/null 2>&1; then
  rg_search_policy='
<OH_NO_RG_SEARCH_TOOLING>
Ripgrep is available. Prefer `rg` and `rg --files` for repository search; use a fallback only if `rg` cannot answer.
</OH_NO_RG_SEARCH_TOOLING>'
fi

base_session_context="<EXTREMELY_IMPORTANT>
You have oh-no-harness.${auto_routing_policy}${rg_search_policy}

${bootstrap_policy}
</EXTREMELY_IMPORTANT>"

claude_code_question_policy='<CLAUDE_CODE_ONLY>
Claude Code only: use AskUserQuestion when available for clarification, preference, scope, or approval. Ask one focused question; use 2-4 mutually exclusive choices when suitable, otherwise plain text.
</CLAUDE_CODE_ONLY>'

claude_code_subagent_role_label_policy='<OH_NO_SUBAGENT_ROLE_LABEL>
This platform is Claude Code. An Oh No Harness role and its configured model come ONLY from the selector field: the Task and Agent tools set `subagent_type: oh-no-harness:<role>` first, before description and prompt; a Workflow `agent()` call sets `agentType: "oh-no-harness:<role>"`; other subagent mechanisms use their own selector. Begin the task description with the [oh-no-harness:<role>] marker (a display label), then a brief summary; the marker is NOT the selector, and a dispatch carrying it without the selector silently runs a generic agent on the parent model.

Add the marker only at the very start of the description, and only for Oh No Harness role dispatches; leave other descriptions unmarked.

This instruction is Claude Code-only. Do not apply it on Codex or other platforms.
</OH_NO_SUBAGENT_ROLE_LABEL>'

claude_code_orchestration_policy='<OH_NO_MAIN_AGENT_ORCHESTRATION>
This platform is Claude Code. Standing preference, active every turn, not only inside a workflow skill: the main agent is an orchestrator. It owns conversation flow, `.oh-no` state, gate decisions, and synthesis; it never performs exploration, investigation, analysis, or repository work-product mutation inline when a role subagent can do it.

Delegation map: read-only code/config/docs lookup, tracing, and research sweeps dispatch oh-no-harness:explore; requirements and risk analysis oh-no-harness:analyst; every repository work-product mutation (code, tests, docs, configs) oh-no-harness:executor; root-cause investigation oh-no-harness:debugger; changed-code review oh-no-harness:code-reviewer; evidence audits oh-no-harness:verifier. Planner, plan-reviewer, fusion roles stay workflow-internal. Workflow skills keep stricter dispatch/review rules. Role names are selector values (see OH_NO_SUBAGENT_ROLE_LABEL). For Oh No Harness work never select general-purpose, claude, Explore, or Plan while the matching role exists; default unmatched read-only work to explore and mutation to executor. Generic types need confirmed plugin-role unavailability under the active skill.

Executor-always preference: never use the LIGHT-tiny inline mutation fallback. Dispatch oh-no-harness:executor for every repository work-product mutation regardless of size or mode; inline mutation is acceptable only after a failed dispatch recorded as Mutation fallback: dispatch-unavailable. Trivial conversation-local writes that are not repository work products are exempt. Every executor dispatch, including LIGHT, uses the configured executor agent model; never override it per call.

Host-plan boundary: never auto-wrap Ralph-eligible Oh No Harness execution in EnterPlanMode or a host planning pass; host plan mode needs explicit user request. Usable approved/concrete execution contract goes straight to Ralph; vague or plan-only work routes upstream to Oh No Harness planning; no-route housekeeping stays direct.

Concurrency: up to 5 Oh No Harness subagents run in parallel. Batch independent dispatches in one request; wait for and use every started result. Never redo delegated work inline.
</OH_NO_MAIN_AGENT_ORCHESTRATION>'

codex_subagent_policy='<CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>
Standing preference: use sub-agents, delegation, and parallel agent work proactively. This is the explicit user request for eligible Oh No Harness workflow subagents when host tools allow isolated work.

Hard rules: active/explicit subagent work uses recognized custom agent_type "oh-no-<role>"; generic fallback requires confirmed unavailability and is never allowed for no-skill read-only lookup. With custom agent_type, set fork_turns="none", omit fork_context, and send one prompt/message. Timeout/empty/no-completion waits are not final. MUST NOT call close_agent for a running or pending subagent merely for a slow/timed-out wait; explicit cancel, invalidation, duplicate/mis-scope, or safety stop follows the adapter; every in-scope subagent result is a workflow dependency: wait to final status, capture it, and use it before advancing. MUST NOT redo delegated work inline or duplicate a slow subagent; continue non-overlapping work or record pending/blocked. Never use missing output as completion evidence.
</CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>'

codex_subagent_troubleshooting_policy="On subagent errors, read \`${OH_NO_PLUGIN_ROOT}/docs/platforms/codex.md\` section \`Custom-Agent Spawn Troubleshooting\` before fallback."

codex_readonly_exploration_policy='<CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>
For simple read-only repository fact lookup prompts outside an active workflow or explicit user-requested subagent task, you may dispatch the registered read-only oh-no-explore custom agent, as many as the lookup needs and not capped at one. Spawn it with fork_turns="none". If unavailable, answer inline; generic or prompt-embedded fallback is never allowed for no-skill read-only lookup. Each result is a dependency: wait_agent to completed, capture it, and use it before the next action. Timeout/empty/no-completion is not final; MUST NOT call close_agent for a running or pending subagent; close only after capture. Eligible: locate, trace, or summarize existing code/config/tests/docs. This lane is not for planning, debugging, implementation, review, QA, security, verification, ambiguity, or edits. Do not read/reproduce secrets unless asked; redact credential values. For other role work, first select the relevant Oh No Harness skill or get an explicit subagent request, then follow its policy.
</CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>'

codex_agent_ensure_warning() {
  local installer_path="${OH_NO_PLUGIN_ROOT}/scripts/install-codex-agents"
  local ensure_output
  local warning_suffix
  warning_suffix='oh-no-* custom-agent dispatch remains the default when the host recognizes agent_type, prompt-embedded fallback requires confirmed unavailability, custom agent_type spawns must not use fork_context, and no-skill read-only exploration may dispatch oh-no-explore and must wait for each result before the next action. MUST NOT call close_agent for a running or pending subagent merely for timeout/slowness; explicit cancel, invalidation, duplicate/mis-scope, or safety stop follows the active adapter; spawned in-scope subagent results are workflow dependencies that must be waited for, captured, and used before advancing; never use missing output as completion evidence.'

  if [ ! -x "$installer_path" ]; then
    printf 'Codex custom-agent ensure warning: installer unavailable; %s' "$warning_suffix"
    return 0
  fi

  if ensure_output="$("$installer_path" --scope user --ensure --quiet 2>&1)"; then
    return 0
  fi

  printf 'Codex custom-agent ensure warning: user-scope oh-no-* agents could not be ensured; %s' "$warning_suffix"
  if [ -n "$ensure_output" ]; then
    printf ' Run %s --scope user --ensure for details.' "$installer_path"
  fi
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context_escaped"
elif [ -n "$ENV_CODEX_PLUGIN_ROOT" ]; then
  codex_agent_warning="$(codex_agent_ensure_warning)"
  codex_agent_warning_block=""
  if [ -n "$codex_agent_warning" ]; then
    codex_agent_warning_block="
${codex_agent_warning}"
  fi
  session_context="${base_session_context}

${codex_subagent_policy}

${codex_subagent_troubleshooting_policy}

${codex_readonly_exploration_policy}${codex_agent_warning_block}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Best-effort restore of user-chosen subagent model/effort after a plugin
  # cache update reset the runtime agents. Fully no-op when nothing is stored or
  # already matching; only a sanitized notice (never credentials) is surfaced on
  # repair/error, so the SessionStart JSON stays valid.
  subagent_config_notice=""
  if [ -x "${OH_NO_PLUGIN_ROOT}/scripts/configure-subagents" ]; then
    # Capture the reapply exit status explicitly (an if/else consumes it, so
    # `set -e` does not abort and no `|| true` swallows it) and drop stderr. On a
    # successful repair surface a FIXED sanitized restart notice; on failure a
    # FIXED credential-free warning. Never inject the subprocess's raw
    # stdout/stderr, paths, or tokens into the session context.
    if subagent_reapply_out="$("${OH_NO_PLUGIN_ROOT}/scripts/configure-subagents" reapply --quiet 2>/dev/null)"; then
      if [ -n "$subagent_reapply_out" ]; then
        subagent_config_notice="

<OH_NO_SUBAGENT_CONFIG_NOTICE>
Oh No Harness reapplied your saved subagent model configuration after a plugin update. Start a new Claude Code session or run /clear for it to take effect.
</OH_NO_SUBAGENT_CONFIG_NOTICE>"
      fi
    else
      subagent_reapply_rc=$?
      subagent_config_notice="

<OH_NO_SUBAGENT_CONFIG_NOTICE>
Oh No Harness could not reapply your saved subagent model configuration (status ${subagent_reapply_rc}). Run /oh-no-harness:configure-subagents to reconfigure.
</OH_NO_SUBAGENT_CONFIG_NOTICE>"
    fi
  fi
  model_diversity_block="$(model_diversity_policy)"
  session_context="${base_session_context}

${claude_code_question_policy}

${claude_code_orchestration_policy}

${claude_code_subagent_role_label_policy}

${model_diversity_block}${subagent_config_notice}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
else
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context_escaped"
fi

exit 0
