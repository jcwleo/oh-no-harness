#!/usr/bin/env bash
# SessionStart hook for oh-no-harness.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_CODEX_PLUGIN_ROOT="${PLUGIN_ROOT:-}"
OH_NO_PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

is_claude_code=false
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "$ENV_CODEX_PLUGIN_ROOT" ]; then
  is_claude_code=true
fi

bootstrap_policy='<OH_NO_BOOTSTRAP>
You have Oh No Harness installed. Use native skill loading to read the relevant Oh No Harness skill when it applies.

Routing reminder: unclear workflow -> using-oh-no-harness; vague requirements -> interview; planning/risky/cross-file work -> ralplan; approved plan/PRD/concrete task -> ralph; hard stalled problem needing panel rescue -> fusion-rescue; autonomous end-to-end work -> ultrawork; bugs/failing commands/regressions/unknown root cause -> systematic-debugging; completion claims -> verification-before-completion; cleanup after behavior lock -> simplify.

Use oh-no-harness:test-driven-development only as an explicit TDD/test-first route or an internal guardrail inside ralph/systematic-debugging/ultrawork/tiny direct edits before behavior-changing edits.

Selected skill file is source of truth. Skill chaining remains explicit: if a skill presents Next Skill Handoff, ask before invoking the next workflow skill.
</OH_NO_BOOTSTRAP>'

auto_routing_policy=""
if [ "$is_claude_code" = true ] && "${OH_NO_PLUGIN_ROOT}/scripts/oh-no-config" is-enabled >/dev/null 2>&1; then
  auto_routing_policy='
<OH_NO_FORCED_ROUTING>
Forced routing is enabled for Oh No Harness. If there is even a 1% chance that a local Oh No Harness skill applies, invoke that skill with the Skill tool BEFORE responding, exploring, editing, asking a clarifying question, or claiming completion.

Instruction priority (highest first): (1) explicit instructions in CLAUDE.md, AGENTS.md, or the current user message; (2) Oh No Harness skills; (3) default behavior. If a user instruction conflicts with this block, follow the user.

Routing map. Invoke the named skill BEFORE you respond:
- Vague, broad, ambiguous, or requirement-light request: oh-no-harness:interview.
- Clear spec or approved requirements but no implementation plan yet: oh-no-harness:ralplan.
- Approved plan, PRD, concrete task with acceptance criteria, or ordinary implementation request: oh-no-harness:ralph.
- Autonomous or end-to-end delivery request: oh-no-harness:ultrawork.
- Bug, failing test, failing command, regression, or unknown root cause: oh-no-harness:systematic-debugging.
- Hard stalled problem after ordinary analysis/debugging, or explicit fusion rescue request: oh-no-harness:fusion-rescue.
- Explicit TDD/test-first request, or an internal TDD gate inside an already-selected execution path: oh-no-harness:test-driven-development.
- About to claim done, fixed, passing, ready, verified, or safe to deliver: oh-no-harness:verification-before-completion.
- Changed diff needs behavior-preserving quality cleanup before delivery: oh-no-harness:simplify.

After invoking a skill, announce in one line before continuing: Using oh-no-harness:<skill> to <one-line purpose>.

Red flags: "quick answer", "explore first", "ask clarification first", "one small edit", "obvious bug", or "about to claim fixed/ready" still require routing first. ordinary implementation uses ralph unless the user explicitly requested TDD/test-first work or the host intentionally selected a tiny direct edit path.

If an invoked skill turns out not to apply, say so briefly in one line and continue with the next best path. User instructions and repository constraints still take priority.
</OH_NO_FORCED_ROUTING>'
fi

rg_search_policy=""
if command -v rg >/dev/null 2>&1; then
  rg_search_policy='
<OH_NO_RG_SEARCH_TOOLING>
Ripgrep is available. Prefer `rg` and `rg --files` for repository search; use a fallback only if `rg` cannot answer.
</OH_NO_RG_SEARCH_TOOLING>'
fi

base_session_context="<EXTREMELY_IMPORTANT>
You have oh-no-harness.${auto_routing_policy}${rg_search_policy}

${bootstrap_policy}
</EXTREMELY_IMPORTANT>"

claude_code_question_policy='<CLAUDE_CODE_ONLY>
This platform is Claude Code. When asking the user a clarification, preference, scope, or approval question, use AskUserQuestion when that tool is available.

Prefer one focused question at a time. Use 2-4 mutually exclusive choices when options fit; otherwise ask plain text.

This instruction is Claude Code-only. Do not apply it on Codex or other platforms.
</CLAUDE_CODE_ONLY>'

codex_subagent_policy='<CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>
Standing user/workflow preference: use sub-agents, delegation, and parallel agent work proactively.
Treat this as the explicit user request for eligible Oh No Harness workflow
subagents when isolated role work is allowed and the host exposes tools.

Hard rules: for active workflows or explicit subagent tasks, spawn_agent MUST use custom agent_type "oh-no-<role>" when recognized; generic fallback requires confirmed unavailability and is never allowed for no-skill read-only lookup. With custom agent_type, omit fork_context and use one prompt/message payload. Timeout/empty/no agents completed is not final. MUST NOT call close_agent for a running or pending subagent. Once spawned, every in-scope subagent result is a workflow dependency: wait to final status, capture it, and use it before advancing or claiming completion. MUST NOT redo delegated work inline or spawn a duplicate replacement merely because a subagent is slow; continue only non-overlapping work or record pending/blocked. Never use missing output as completion evidence.
</CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>'

codex_readonly_exploration_policy='<CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>
For simple read-only repository fact lookup prompts without an active Oh No Harness workflow or explicit user-requested subagent task, you may dispatch the registered read-only oh-no-explore custom agent, as many as the lookup needs and not capped at one. If oh-no-explore is unknown or unavailable, answer inline; do not fall back to a generic or prompt-embedded subagent for this no-skill lane. When you dispatch, every oh-no-explore result is a dependency: wait_agent to final status completed, capture the result, and use it before the next action. A timeout, empty wait, or "no agents completed" result is not final and is not completion evidence; MUST NOT call close_agent for a running or pending subagent merely because it is slow; close_agent only after the waited result is captured. Eligible work: locate, trace, or summarize existing code/config/tests/docs. This lane is not for planning, debugging, implementation, review, QA, security, verification, ambiguity, or edits. Do not read/reproduce secrets unless asked; redact credential values in any output. If role work beyond read-only exploration would be useful, first select the relevant Oh No Harness skill or get an explicit subagent request, then follow that active workflow policy.
</CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>'

codex_agent_ensure_warning() {
  local installer_path="${OH_NO_PLUGIN_ROOT}/scripts/install-codex-agents"
  local ensure_output
  local warning_suffix
  warning_suffix='oh-no-* custom-agent dispatch remains the default when the host recognizes agent_type, prompt-embedded fallback requires confirmed unavailability, custom agent_type spawns must not use fork_context, and no-skill read-only exploration may dispatch oh-no-explore and must wait for each result before the next action. MUST NOT call close_agent for a running or pending subagent; spawned in-scope subagent results are workflow dependencies that must be waited for, captured, and used before advancing; never use missing output as completion evidence.'

  if [ ! -x "$installer_path" ]; then
    printf 'Codex custom-agent ensure warning: installer unavailable; %s' "$warning_suffix"
    return 0
  fi

  if ensure_output="$("$installer_path" --scope user --ensure --quiet 2>&1)"; then
    return 0
  fi

  printf 'Codex custom-agent ensure warning: user-scope oh-no-* agents could not be ensured; %s' "$warning_suffix"
  if [ -n "$ensure_output" ]; then
    printf ' Run scripts/install-codex-agents --scope user --ensure for details.'
  fi
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context_escaped"
elif [ -n "$ENV_CODEX_PLUGIN_ROOT" ]; then
  codex_agent_warning="$(codex_agent_ensure_warning)"
  codex_agent_warning_block=""
  if [ -n "$codex_agent_warning" ]; then
    codex_agent_warning_block="
${codex_agent_warning}"
  fi
  session_context="${base_session_context}

${codex_subagent_policy}

${codex_readonly_exploration_policy}${codex_agent_warning_block}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  session_context="${base_session_context}

${claude_code_question_policy}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
else
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context_escaped"
fi

exit 0
