#!/usr/bin/env bash
# SessionStart hook for oh-no-harness.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_CODEX_PLUGIN_ROOT="${PLUGIN_ROOT:-}"
OH_NO_PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

is_claude_code=false
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "$ENV_CODEX_PLUGIN_ROOT" ]; then
  is_claude_code=true
fi

bootstrap_policy='<OH_NO_BOOTSTRAP>
You have Oh No Harness installed. Use native skill loading to read the relevant Oh No Harness skill when it applies.

Routing reminder: unclear workflow -> using-oh-no-harness; vague requirements -> interview; planning/risky/cross-file work -> ralplan; approved plan/PRD/concrete task -> ralph; hard stalled problem needing panel rescue -> fusion-rescue; autonomous end-to-end work -> ultrawork; failing commands/regressions/flaky behavior/unknown root cause -> systematic-debugging (a known-cause localized bug fix -> ralph); completion claims -> verification-before-completion; cleanup after behavior lock -> simplify.

Use oh-no-harness:test-driven-development only as an explicit TDD/test-first route or an internal guardrail inside ralph/systematic-debugging/ultrawork before behavior-changing edits.

Orchestration default: workflow main agents own .oh-no state and gate decisions; STANDARD/THOROUGH repository work-product mutations use executor roles, with inline mutation only for a recorded LIGHT-tiny or dispatch-unavailable fallback.

Selected skill file is source of truth. Skill chaining remains explicit: if a skill presents Next Skill Handoff, ask before invoking the next workflow skill.
</OH_NO_BOOTSTRAP>'

auto_routing_policy=""
if [ "$is_claude_code" = true ] && "${OH_NO_PLUGIN_ROOT}/scripts/oh-no-config" is-enabled >/dev/null 2>&1; then
  auto_routing_policy='
<OH_NO_FORCED_ROUTING>
Forced routing is enabled for Oh No Harness. Route from the requested deliverable and invoke an applicable local skill with the Skill tool BEFORE responding, exploring, editing, asking a clarifying question, or claiming completion. A workflow name used only as the subject of analysis, explanation, comparison, or critique is not an invocation trigger. Route from the requested deliverable: an analysis report versus a plan or execution artifact. Explicit planning, implementation, execution, or workflow-invocation requests still route normally.

Instruction priority (highest first): (1) explicit instructions in CLAUDE.md, AGENTS.md, or the current user message; (2) Oh No Harness skills; (3) default behavior. If a user instruction conflicts with this block, follow the user.

No-route lane: when the requested deliverable does not create or change repository work products (code, tests, docs, configs) and does not claim their completion, answer directly WITHOUT invoking a workflow skill. This lane covers research and information gathering, conceptual or codebase questions, status or progress reports, and version-control or environment housekeeping over already-written changes (commit, push, branch, tag, stash, conflict-free rebase or merge, dependency install, tool or editor config). Committing or pushing existing work is housekeeping, not implementation, and does not route to ralph. If housekeeping unexpectedly turns into content changes (for example a conflicted rebase that needs code edits), re-route from the new deliverable at that point.

Routing map. Invoke the named skill BEFORE you respond:
- Vague, broad, ambiguous, or requirement-light request: oh-no-harness:interview.
- Clear spec or approved requirements but no implementation plan yet: oh-no-harness:ralplan.
- Approved plan, PRD, concrete task with acceptance criteria, or ordinary implementation request: oh-no-harness:ralph.
- Autonomous or end-to-end delivery request: oh-no-harness:ultrawork.
- Failing test, failing command, regression, flaky behavior, or unknown root cause: oh-no-harness:systematic-debugging. A bug with a known cause and a localized fix: oh-no-harness:ralph.
- Hard stalled problem after ordinary analysis/debugging, or explicit fusion rescue request: oh-no-harness:fusion-rescue.
- Explicit TDD/test-first request, or an internal TDD gate inside an already-selected execution path: oh-no-harness:test-driven-development.
- About to claim done, fixed, passing, ready, verified, or safe to deliver: oh-no-harness:verification-before-completion.
- Changed diff needs behavior-preserving quality cleanup before delivery: oh-no-harness:simplify.

After invoking a skill, announce in one line before continuing: Using oh-no-harness:<skill> to <one-line purpose>.

Red flags: "quick answer", "explore first", "ask clarification first", "one small edit", "obvious bug", or "about to claim fixed/ready" still require routing first; routing may legitimately resolve to the no-route lane when its conditions above hold, but do not use these phrases to skip the decision. ordinary implementation uses ralph unless the user explicitly requested TDD/test-first work; small concrete edits stay in ralph and may qualify for its STANDARD small-task carve-out.

If an invoked skill turns out not to apply, say so briefly in one line and continue with the next best path. User instructions and repository constraints still take priority.
</OH_NO_FORCED_ROUTING>'
fi

codex_executor_policy=""
if [ "$is_claude_code" = true ] && "${OH_NO_PLUGIN_ROOT}/scripts/oh-no-config" codex-executor is-enabled >/dev/null 2>&1; then
  codex_executor_policy='
<OH_NO_CODEX_EXECUTOR_DELEGATION>
Codex-executor delegation is ON (session-scoped, Claude-Code-only). This is a highest-priority scoped override of ONLY the executor role, session-global across ralph, ultrawork, and systematic-debugging.

Executor role re-bind: when Ralph (or any Oh No Harness workflow) dispatches the `executor` role, dispatch `oh-no-harness:executor-codex` INSTEAD of `oh-no-harness:executor`. That agent is a thin transport: it compiles one scoped packet, makes one foreground write-capable Codex companion call, and returns raw Codex stdout without wrapper synthesis.

Executor-only fence: ONLY the executor role is delegated. Verify, review, and merge MUST NOT be routed to the write-capable executor-codex channel; they stay with Claude / native review and verifier roles, so maker-verifier independence cannot silently collapse.

Eligibility-preserving rebind: existing Ralph eligibility remains the sole gate. An executor batch already admitted as disjoint under the Ralph Batch Rule and Isolation Contract may overlap at the outer executor-codex agent layer. Ineligible, unknown, or unsafe work stays serial. Each inner companion call remains foreground; the caller waits for every started member, then runs existing scope checks, native verification, and review. Fallback and integration remain sequential.

Caller-mediated degrade: if the codex companion is unavailable, unresolvable, or the delegated call fails, executor-codex SIGNALS companion-unavailable and returns; the main ralph agent (the caller) inspects any partial worktree delta before sequential native `oh-no-harness:executor` fallback and records a warning. executor-codex CANNOT self-dispatch.

Best-effort framing (honest): worktree/sandbox confinement of delegated writes is BEST-EFFORT, NOT a guarantee. The caller owns the escape-DETECTION guard: capture protected-target state immediately before the admitted outer batch and after every started member finishes, EXCLUDING the delegated task worktrees from protected-target traversal, derive each worktree diff, and HALT before merge on any unexpected protected-target change. Its filesystem sentinel is a path + mtime + size manifest, not a content hash. Same-path/mtime/size rewrites, tracked files already dirty with unchanged status, arbitrary temp dirs, and non-.oh-no/ ignored paths remain undetected.
</OH_NO_CODEX_EXECUTOR_DELEGATION>'
fi

rg_search_policy=""
if command -v rg >/dev/null 2>&1; then
  rg_search_policy='
<OH_NO_RG_SEARCH_TOOLING>
Ripgrep is available. Prefer `rg` and `rg --files` for repository search; use a fallback only if `rg` cannot answer.
</OH_NO_RG_SEARCH_TOOLING>'
fi

base_session_context="<EXTREMELY_IMPORTANT>
You have oh-no-harness.${auto_routing_policy}${codex_executor_policy}${rg_search_policy}

${bootstrap_policy}
</EXTREMELY_IMPORTANT>"

claude_code_question_policy='<CLAUDE_CODE_ONLY>
This platform is Claude Code. When asking the user a clarification, preference, scope, or approval question, use AskUserQuestion when that tool is available.

Prefer one focused question at a time. Use 2-4 mutually exclusive choices when options fit; otherwise ask plain text.

This instruction is Claude Code-only. Do not apply it on Codex or other platforms.
</CLAUDE_CODE_ONLY>'

claude_code_subagent_role_label_policy='<OH_NO_SUBAGENT_ROLE_LABEL>
This platform is Claude Code. When you dispatch an Oh No Harness role through any Claude subagent mechanism that carries a task description (the Task tool, the Agent tool, a Workflow `agent()` call, or any equivalent dispatch), begin the task description with the canonical role marker [oh-no-harness:<role>] followed by a brief task summary, for example [oh-no-harness:explore] locate the retry helper. The subagent statusline reads this leading marker to label the row with the canonical role (such as oh-no-harness:explore) instead of a generic host type such as local_agent, and strips the marker from the shown description.

Use the exact bracketed prefix only at the very start of the description, and only for Oh No Harness role dispatches; leave descriptions for other tasks unmarked so their existing name and description render unchanged.

This instruction is Claude Code-only. Do not apply it on Codex or other platforms.
</OH_NO_SUBAGENT_ROLE_LABEL>'

codex_subagent_policy='<CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>
Standing preference: use sub-agents, delegation, and parallel agent work proactively. This is the explicit user request for eligible Oh No Harness workflow subagents when host tools allow isolated work.

Hard rules: active/explicit subagent work uses recognized custom agent_type "oh-no-<role>"; generic fallback requires confirmed unavailability and is never allowed for no-skill read-only lookup. With custom agent_type, set fork_turns="none", omit fork_context, and send one prompt/message. Timeout/empty/no-completion waits are not final. MUST NOT call close_agent for a running or pending subagent merely for a slow/timed-out wait; explicit cancel, invalidation, duplicate/mis-scope, or safety stop follows the adapter; every in-scope subagent result is a workflow dependency: wait to final status, capture it, and use it before advancing. MUST NOT redo delegated work inline or duplicate a slow subagent; continue non-overlapping work or record pending/blocked. Never use missing output as completion evidence.
</CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>'

codex_subagent_troubleshooting_policy="On subagent errors, read \`${OH_NO_PLUGIN_ROOT}/docs/platforms/codex.md\` section \`Custom-Agent Spawn Troubleshooting\` before fallback."

codex_readonly_exploration_policy='<CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>
For simple read-only repository fact lookup prompts outside an active workflow or explicit user-requested subagent task, you may dispatch the registered read-only oh-no-explore custom agent, as many as the lookup needs and not capped at one. Spawn it with fork_turns="none". If unavailable, answer inline; generic or prompt-embedded fallback is never allowed for no-skill read-only lookup. Each result is a dependency: wait_agent to completed, capture it, and use it before the next action. Timeout/empty/no-completion is not final; MUST NOT call close_agent for a running or pending subagent; close only after capture. Eligible: locate, trace, or summarize existing code/config/tests/docs. This lane is not for planning, debugging, implementation, review, QA, security, verification, ambiguity, or edits. Do not read/reproduce secrets unless asked; redact credential values. For other role work, first select the relevant Oh No Harness skill or get an explicit subagent request, then follow its policy.
</CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>'

codex_agent_ensure_warning() {
  local installer_path="${OH_NO_PLUGIN_ROOT}/scripts/install-codex-agents"
  local ensure_output
  local warning_suffix
  warning_suffix='oh-no-* custom-agent dispatch remains the default when the host recognizes agent_type, prompt-embedded fallback requires confirmed unavailability, custom agent_type spawns must not use fork_context, and no-skill read-only exploration may dispatch oh-no-explore and must wait for each result before the next action. MUST NOT call close_agent for a running or pending subagent merely for timeout/slowness; explicit cancel, invalidation, duplicate/mis-scope, or safety stop follows the active adapter; spawned in-scope subagent results are workflow dependencies that must be waited for, captured, and used before advancing; never use missing output as completion evidence.'

  if [ ! -x "$installer_path" ]; then
    printf 'Codex custom-agent ensure warning: installer unavailable; %s' "$warning_suffix"
    return 0
  fi

  if ensure_output="$("$installer_path" --scope user --ensure --quiet 2>&1)"; then
    return 0
  fi

  printf 'Codex custom-agent ensure warning: user-scope oh-no-* agents could not be ensured; %s' "$warning_suffix"
  if [ -n "$ensure_output" ]; then
    printf ' Run scripts/install-codex-agents --scope user --ensure for details.'
  fi
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context_escaped"
elif [ -n "$ENV_CODEX_PLUGIN_ROOT" ]; then
  codex_agent_warning="$(codex_agent_ensure_warning)"
  codex_agent_warning_block=""
  if [ -n "$codex_agent_warning" ]; then
    codex_agent_warning_block="
${codex_agent_warning}"
  fi
  session_context="${base_session_context}

${codex_subagent_policy}

${codex_subagent_troubleshooting_policy}

${codex_readonly_exploration_policy}${codex_agent_warning_block}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Best-effort restore of user-chosen subagent model/effort after a plugin
  # cache update reset the runtime agents. Fully no-op when nothing is stored or
  # already matching; only a sanitized notice (never credentials) is surfaced on
  # repair/error, so the SessionStart JSON stays valid.
  subagent_config_notice=""
  if [ -x "${OH_NO_PLUGIN_ROOT}/scripts/configure-subagents" ]; then
    # Capture the reapply exit status explicitly (an if/else consumes it, so
    # `set -e` does not abort and no `|| true` swallows it) and drop stderr. On a
    # successful repair surface a FIXED sanitized restart notice; on failure a
    # FIXED credential-free warning. Never inject the subprocess's raw
    # stdout/stderr, paths, or tokens into the session context.
    if subagent_reapply_out="$("${OH_NO_PLUGIN_ROOT}/scripts/configure-subagents" reapply --quiet 2>/dev/null)"; then
      if [ -n "$subagent_reapply_out" ]; then
        subagent_config_notice="

<OH_NO_SUBAGENT_CONFIG_NOTICE>
Oh No Harness reapplied your saved subagent model configuration after a plugin update. Start a new Claude Code session or run /clear for it to take effect.
</OH_NO_SUBAGENT_CONFIG_NOTICE>"
      fi
    else
      subagent_reapply_rc=$?
      subagent_config_notice="

<OH_NO_SUBAGENT_CONFIG_NOTICE>
Oh No Harness could not reapply your saved subagent model configuration (status ${subagent_reapply_rc}). Run /oh-no-harness:configure-subagents to reconfigure.
</OH_NO_SUBAGENT_CONFIG_NOTICE>"
    fi
  fi
  session_context="${base_session_context}

${claude_code_question_policy}

${claude_code_subagent_role_label_policy}${subagent_config_notice}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
else
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context_escaped"
fi

exit 0
