#!/usr/bin/env bash
# SessionStart hook for oh-no-harness.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_CODEX_PLUGIN_ROOT="${PLUGIN_ROOT:-}"
OH_NO_PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

is_claude_code=false
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "$ENV_CODEX_PLUGIN_ROOT" ]; then
  is_claude_code=true
fi

bootstrap_policy='<OH_NO_BOOTSTRAP>
You have Oh No Harness installed. Use native skill loading to read the relevant Oh No Harness skill when it applies.

Default routing summary:
- Use oh-no-harness:using-oh-no-harness when workflow selection is unclear.
- Use oh-no-harness:interview for vague, broad, or requirement-light work.
- Use oh-no-harness:ralplan for planning, risky, cross-file, multi-step, or unclear implementation work.
- Use oh-no-harness:ralph for an approved plan, PRD, concrete task, or acceptance criteria.
- Use oh-no-harness:autopilot for autonomous end-to-end delivery.
- Use oh-no-harness:systematic-debugging for bugs, failing commands, regressions, flaky behavior, or unknown root cause.
- Use oh-no-harness:test-driven-development only as an explicit TDD/test-first route or an internal guardrail inside ralph/systematic-debugging/autopilot/tiny direct edits before behavior-changing edits.
- Use oh-no-harness:verification-before-completion before claiming done, fixed, passing, ready, or verified.
- Use oh-no-harness:simplify only after behavior is locked and changed code needs reuse, simplification, efficiency, or altitude cleanup.

This bootstrap is only a compact routing reminder. Selected skill file is source of truth. Skill chaining remains explicit: if a skill presents Next Skill Handoff, ask before invoking the next workflow skill.
</OH_NO_BOOTSTRAP>'

auto_routing_policy=""
if [ "$is_claude_code" = true ] && "${OH_NO_PLUGIN_ROOT}/scripts/oh-no-config" is-enabled >/dev/null 2>&1; then
  auto_routing_policy='
<OH_NO_FORCED_ROUTING>
Forced routing is enabled for Oh No Harness. If there is even a 1% chance that a local Oh No Harness skill applies to what you are about to do, you MUST invoke that skill with the Skill tool BEFORE responding, exploring, editing, asking a clarifying question, or claiming completion. This is not optional and you cannot rationalize past it.

Instruction priority (highest first): (1) explicit instructions in CLAUDE.md, AGENTS.md, or the current user message; (2) Oh No Harness skills; (3) default behavior. If a user instruction conflicts with this block, follow the user.

Routing map. Invoke the named skill BEFORE you respond:
- Vague, broad, ambiguous, or requirement-light request: oh-no-harness:interview.
- Clear spec or approved requirements but no implementation plan yet: oh-no-harness:ralplan.
- Approved plan, PRD, concrete task with acceptance criteria, or ordinary implementation request: oh-no-harness:ralph.
- Autonomous or end-to-end delivery request: oh-no-harness:autopilot.
- Bug, failing test, failing command, regression, or unknown root cause: oh-no-harness:systematic-debugging.
- Explicit TDD/test-first request, or an internal TDD gate inside an already-selected execution path: oh-no-harness:test-driven-development.
- About to claim done, fixed, passing, ready, verified, or safe to deliver: oh-no-harness:verification-before-completion.
- Changed diff needs behavior-preserving quality cleanup before delivery: oh-no-harness:simplify.

After invoking a skill, announce in one line before continuing: Using oh-no-harness:<skill> to <one-line purpose>.

Red flags. These thoughts mean STOP and route through a skill:
- This is a simple question. Reality: questions are tasks. Re-check the routing map.
- Let me explore the codebase first. Reality: interview or systematic-debugging tells you HOW to explore. Route first.
- I need more context, let me ask a clarifying question. Reality: interview is where clarifying questions belong.
- I will just make this one small edit. Reality: ordinary implementation uses ralph unless the user explicitly requested TDD/test-first work or the host intentionally selected a tiny direct edit path.
- I already know which skill applies. Reality: recognition is not invocation. Invoke it.
- The user just wants a quick answer. Reality: decide routing first, then answer.
- It is only docs or config. Reality: if unsure, invoke. If the skill does not apply, say so in one line and continue.
- This bug looks obvious. Reality: systematic-debugging exists for this exact moment.
- I am about to say it is fixed, passing, or ready. Reality: verification-before-completion runs first.

If an invoked skill turns out not to apply, say so briefly in one line and continue with the next best path. User instructions and repository constraints still take priority.
</OH_NO_FORCED_ROUTING>'
fi

rg_search_policy=""
if command -v rg >/dev/null 2>&1; then
  rg_search_policy='
<OH_NO_RG_SEARCH_TOOLING>
Ripgrep is available. Prefer `rg` and `rg --files` for repository search; use a fallback only if `rg` cannot answer.
</OH_NO_RG_SEARCH_TOOLING>'
fi

base_session_context="<EXTREMELY_IMPORTANT>
You have oh-no-harness.${auto_routing_policy}${rg_search_policy}

${bootstrap_policy}
</EXTREMELY_IMPORTANT>"

claude_code_question_policy='<CLAUDE_CODE_ONLY>
This platform is Claude Code. When asking the user a clarification, preference, scope, or approval question, use AskUserQuestion when that tool is available.

Prefer one focused question at a time. For option questions, provide 2-4 mutually exclusive choices and put the recommended option first when there is a clear recommendation. Use plain text only when AskUserQuestion is unavailable or the answer needs free-form detail that does not fit structured options.

This instruction is Claude Code-only. Do not apply it on Codex or other platforms.
</CLAUDE_CODE_ONLY>'

codex_subagent_policy='<CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>
Standing user/workflow preference: use sub-agents, delegation, and parallel agent work proactively.
Treat this as the explicit user request for eligible Oh No Harness workflow
subagents when isolated role work is allowed and the host exposes tools. Respect
tool policy, ownership, isolation, and lifecycle; stay inline only if
unavailable, unsafe, or skill-blocked.

For any Oh No Harness role inside an active workflow or explicit user-requested
subagent task, every spawn_agent call MUST include custom agent_type when
recognized: standard roles "oh-no-<role>"; simplify cleanup
Reuse/Simplification/Efficiency/Altitude map to "oh-no-cleanup-reuse",
"oh-no-cleanup-simplification", "oh-no-cleanup-efficiency",
"oh-no-cleanup-altitude". Omitting agent_type or writing it only in the message
is generic/default dispatch and violates this contract. Do not infer
unavailability from rendered schema/display; attempt agent_type first. Generic
fallback is allowed only after confirmed custom-agent unavailability; never allowed for no-skill read-only lookup.
Timeout/empty/no agents completed is not final. MUST NOT call close_agent for a
running or pending subagent. Close without final only on user cancel/stop,
invalidated scope, duplicate/mis-scoped spawn, or safety/security/file risk.
Never use missing output as completion evidence.
</CODEX_ONLY_OH_NO_SUBAGENT_STANDING_AUTHORIZATION>'

codex_readonly_exploration_policy='<CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>
For simple read-only repository fact lookup prompts, Codex may use one
exploration sub-agent without active workflow. Eligible: locate,
trace, or summarize existing code/config/tests/docs. Do not use this lane for planning, debugging, implementation, review, QA, security, verification,
ambiguity, or edits. Do not read/reproduce secrets unless asked;
redact credential values in sub-agent output. Do not call spawn_agent for this
lane unless the host accepts agent_type `oh-no-explore`; otherwise perform the lookup inline. Capture the result, then
close the sub-agent when close_agent exists. Timeout/empty/no agents completed
is not captured. MUST NOT close a running read-only sub-agent; leave open, wait
longer, or report pending unless user cancels, scope invalidates, spawn was
duplicate/mis-scoped, or safety/security risk appears.
</CODEX_ONLY_OH_NO_READONLY_EXPLORATION_DELEGATION>'

codex_agent_ensure_warning() {
  local installer_path="${OH_NO_PLUGIN_ROOT}/scripts/install-codex-agents"
  local ensure_output
  local warning_suffix
  warning_suffix='oh-no-* custom-agent dispatch remains the default when the host recognizes agent_type, prompt-embedded fallback requires confirmed unavailability, and no-skill exploration stays inline until read-only oh-no-explore is available. MUST NOT call close_agent for a running or pending subagent; never use missing output as completion evidence.'

  if [ ! -x "$installer_path" ]; then
    printf 'Codex custom-agent ensure warning: installer unavailable; %s' "$warning_suffix"
    return 0
  fi

  if ensure_output="$("$installer_path" --scope user --ensure --quiet 2>&1)"; then
    return 0
  fi

  printf 'Codex custom-agent ensure warning: user-scope oh-no-* agents could not be ensured; %s' "$warning_suffix"
  if [ -n "$ensure_output" ]; then
    printf ' Run scripts/install-codex-agents --scope user --ensure for details.'
  fi
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context_escaped"
elif [ -n "$ENV_CODEX_PLUGIN_ROOT" ]; then
  codex_agent_warning="$(codex_agent_ensure_warning)"
  codex_agent_warning_block=""
  if [ -n "$codex_agent_warning" ]; then
    codex_agent_warning_block="
${codex_agent_warning}"
  fi
  session_context="${base_session_context}

${codex_subagent_policy}

${codex_readonly_exploration_policy}${codex_agent_warning_block}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  session_context="${base_session_context}

${claude_code_question_policy}"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
else
  session_context="$base_session_context"
  session_context_escaped=$(escape_for_json "$session_context")
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context_escaped"
fi

exit 0
